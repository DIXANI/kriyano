---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "KRIYANO CHECK — Check AI Output Before You Use It";
const description =
  "Paste AI-generated output and identify claims, numbers, assumptions, sources and other information that may need verification before you use it.";
---

<BaseLayout
  title={title}
  description={description}
>
  <main class="check-page">

    <section class="check-hero">
      <div class="check-wrap">

        <div class="check-badge">KRIYANO CHECK</div>

        <h1>
          Check AI output before
          <span>you use it.</span>
        </h1>

        <p class="check-intro">
          Paste an AI-generated answer, report, summary or recommendation.
          KRIYANO helps identify what may need verification before you rely on it.
        </p>

        <div class="check-card">

          <div class="check-card-header">
            <div>
              <h2>AI Output Check</h2>
              <p>Paste the output you want to review.</p>
            </div>

            <div class="status">
              V1
            </div>
          </div>

          <label for="ai-output" class="input-label">
            AI-generated output
          </label>

          <textarea
            id="ai-output"
            maxlength="8000"
            placeholder="Paste the AI output here..."
          ></textarea>

          <div class="input-footer">

            <span id="character-count">
              0 / 8,000 characters
            </span>

            <button id="check-button" type="button">
              Check AI Output
              <span aria-hidden="true">→</span>
            </button>

          </div>

        </div>

        <div class="trust-row">

          <span>✓ No account required</span>

          <span>✓ Works with any AI</span>

          <span>✓ Designed for real work</span>

        </div>

      </div>
   </section>

<section id="check-results" class="check-results" hidden>
  <div class="check-wrap">

    <div class="results-card">

      <!-- Main KRIYANO AI Review -->
      <div id="semantic-results" class="semantic-results" hidden>

        <div class="semantic-heading">
          <span id="review-badge" class="review-badge">
            REVIEW
          </span>

          <h2 id="review-title">
            AI Output Review
          </h2>
        </div>
        <div id="semantic-error" class="semantic-error" hidden>
  <strong>AI review couldn't be completed.</strong>
  <p>
    The browser-based signals below are still available.
    Please try the AI review again.
  </p>
</div>
        <p id="review-summary" class="review-summary"></p>

        <div class="priority-heading">
          <span>CHECK FIRST</span>
          <h3>What needs your attention</h3>
        </div>

        <div id="priority-list" class="priority-list"></div>

      </div>


      <!-- Browser Detected Signals -->
      <div class="results-heading">

        <div>
          <p class="eyebrow">LOCAL CHECK</p>
          <h2>Detected signals</h2>
        </div>

        <span class="local-badge">
          Processed in browser
        </span>

      </div>

      <p class="results-intro">
        Structured items detected in the text that may help with verification.
        These signals do not determine whether the content is true or false.
      </p>


      <!-- Signal Statistics -->
      <div class="result-stats">

        <div class="result-stat">
          <strong id="stat-numbers">0</strong>
          <span>Numbers</span>
        </div>

        <div class="result-stat">
          <strong id="stat-percentages">0</strong>
          <span>Percentages</span>
        </div>

        <div class="result-stat">
          <strong id="stat-currencies">0</strong>
          <span>Currencies</span>
        </div>

        <div class="result-stat">
          <strong id="stat-dates">0</strong>
          <span>Dates</span>
        </div>

        <div class="result-stat">
          <strong id="stat-links">0</strong>
          <span>Links</span>
        </div>

        <div class="result-stat">
          <strong id="stat-citations">0</strong>
          <span>Citation signals</span>
        </div>

      </div>


      <!-- Detailed Detected Items -->
      <div id="detected-items" class="detected-items"></div>

    </div>

  </div>
</section>
    <section class="what-checks">
      <div class="check-wrap">

        <div class="section-heading">

          <p class="eyebrow">WHAT KRIYANO CHECK LOOKS FOR</p>

          <h2>
            Know what deserves a second look.
          </h2>

          <p>
            AI can produce useful answers that still contain information
            worth checking. KRIYANO helps you identify those areas before
            the output becomes real work.
          </p>

        </div>


        <div class="check-grid">

          <article class="feature-card">
            <span class="feature-number">01</span>
            <h3>Factual claims</h3>
            <p>
              Statements, statistics and specific facts that may require
              independent verification.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">02</span>
            <h3>Numbers</h3>
            <p>
              Percentages, currencies, dates, quantities and calculations
              worth double-checking.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">03</span>
            <h3>Assumptions</h3>
            <p>
              Conclusions or explanations that may go beyond the information
              actually provided.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">04</span>
            <h3>Recommendations</h3>
            <p>
              Advice that may depend on missing context, circumstances or
              professional judgment.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">05</span>
            <h3>Sources</h3>
            <p>
              Citations, links, reports and authorities that should be checked
              before relying on them.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">06</span>
            <h3>Current information</h3>
            <p>
              Prices, laws, rankings, roles and other information that may
              change over time.
            </p>
          </article>

        </div>

      </div>
    </section>


    <section class="review-explainer">
      <div class="check-wrap">

        <div class="explainer-card">

          <div>
            <p class="eyebrow">NOT AN AI DETECTOR</p>

            <h2>
              KRIYANO doesn't guess whether an answer is
              “AI-generated” or assign a fake accuracy score.
            </h2>
          </div>

          <p>
            The goal is practical: identify what deserves verification,
            explain why it matters and help you decide what to check before
            using the output.
          </p>

        </div>

      </div>
    </section>

  </main>


  <script>
  const textarea = document.querySelector("#ai-output");
  const counter = document.querySelector("#character-count");
  const button = document.querySelector("#check-button");
  const results = document.querySelector("#check-results");
  const detectedItems = document.querySelector("#detected-items");

  const uniqueMatches = (text, regex) => {
    const matches = text.match(regex) ?? [];

    return [...new Set(matches.map((item) => item.trim()))];
  };

  const escapeHTML = (value) => {
    return value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  };

  const setStat = (id, value) => {
    const element = document.querySelector(id);

    if (element instanceof HTMLElement) {
      element.textContent = String(value);
    }
  };

  const createGroup = (title, items, message) => {
    if (items.length === 0) {
      return "";
    }

    const tags = items
      .slice(0, 20)
      .map(
        (item) =>
          `<span class="detected-tag">${escapeHTML(item)}</span>`
      )
      .join("");

    return `
      <div class="detected-group">
        <div class="detected-group-heading">
          <h3>${title}</h3>
          <span>${items.length}</span>
        </div>

        <p>${message}</p>

        <div class="detected-tags">
          ${tags}
        </div>
      </div>
    `;
  };

  const runLocalCheck = (text) => {
    /*
     * Percentages
     * Examples:
     * 25%
     * 17.4 %
     */
    const percentages = uniqueMatches(
      text,
      /\b\d+(?:\.\d+)?\s?%/g
    );

    /*
     * Currency values
     * Examples:
     * $500
     * USD 1,250
     * QAR 80,000
     * €99.50
     */
    const currencies = uniqueMatches(
      text,
      /(?:[$€£]\s?\d[\d,]*(?:\.\d+)?|\b(?:USD|EUR|GBP|QAR|AED|SAR|LKR|INR)\s?\d[\d,]*(?:\.\d+)?)/gi
    );

    /*
     * Common written and numeric dates.
     */
    const dates = uniqueMatches(
  text,
  /\b(?:\d{1,2}[\/.-]\d{1,2}[\/.-]\d{2,4}|\d{4}[\/.-]\d{1,2}[\/.-]\d{1,2}|(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\s+\d{1,2}(?:st|nd|rd|th)?(?:,\s*|\s+)\d{4}|\b(?:19|20)\d{2}\b)\b/gi
);

    /*
     * URLs
     */
    const links = uniqueMatches(
      text,
      /https?:\/\/[^\s<>"')\]]+/gi
    );

    /*
     * Citation/source language.
     * These are signals only — not verified citations.
     */
    const citationSignals = uniqueMatches(
      text,
      /\b(?:according to|study|studies|research|report|source|citation|doi|journal|published by|data from)\b/gi
    );

    /*
     * General numeric values.
     *
     * We remove values already identified as percentages,
     * currencies and dates before extracting remaining numbers.
     */
    let numberText = text;

    [...percentages, ...currencies, ...dates].forEach((item) => {
      numberText = numberText.split(item).join(" ");
    });

    const numbers = uniqueMatches(
      numberText,
      /\b\d[\d,]*(?:\.\d+)?\b/g
    );

    setStat("#stat-numbers", numbers.length);
    setStat("#stat-percentages", percentages.length);
    setStat("#stat-currencies", currencies.length);
    setStat("#stat-dates", dates.length);
    setStat("#stat-links", links.length);
    setStat("#stat-citations", citationSignals.length);

    const groups = [
      createGroup(
        "Percentages",
        percentages,
        "Check what each percentage measures, how it was calculated and whether its source is reliable."
      ),

      createGroup(
        "Currency values",
        currencies,
        "Financial figures may require source, currency, period and calculation verification."
      ),

      createGroup(
        "Dates",
        dates,
        "Dates can affect whether information is current and should be checked when timing matters."
      ),

      createGroup(
        "Links",
        links,
        "A link appearing in AI output does not guarantee that the page exists or supports the associated claim."
      ),

      createGroup(
        "Citation signals",
        citationSignals,
        "The output contains language suggesting external evidence or sources. Verify the original evidence before relying on it."
      ),

      createGroup(
        "Other numeric signals",
        numbers,
        "Check important quantities against the original data or calculation before using them."
      )
    ].join("");

    if (detectedItems instanceof HTMLElement) {
      detectedItems.innerHTML =
        groups ||
        `
          <div class="nothing-detected">
            <strong>No structured review items detected.</strong>
            <p>
              This does not mean the output is accurate. Semantic AI review
              will handle claims, assumptions and recommendations in the
              next stage.
            </p>
          </div>
        `;
    }

    if (results instanceof HTMLElement) {
      results.hidden = false;

      results.scrollIntoView({
        behavior: "smooth",
        block: "start"
      });
    }
  };

  if (
    textarea instanceof HTMLTextAreaElement &&
    counter instanceof HTMLElement
  ) {
    const updateCount = () => {
      const count = textarea.value.length;

      counter.textContent =
        `${count.toLocaleString()} / 8,000 characters`;
    };
  
    textarea.addEventListener("input", updateCount);
    updateCount();
  }
function renderSemanticResults(analysis) {
  const semanticResults =
    document.querySelector("#semantic-results");
const semanticError = document.getElementById("semantic-error");
const priorityHeading = document.querySelector(".priority-heading");

if (semanticError instanceof HTMLElement) {
  semanticError.hidden = true;
}

if (priorityHeading instanceof HTMLElement) {
  priorityHeading.hidden = false;
}
  const reviewBadge =
    document.querySelector("#review-badge");

  const reviewTitle =
    document.querySelector("#review-title");

  const reviewSummary =
    document.querySelector("#review-summary");

  const priorityList =
    document.querySelector("#priority-list");

  if (
    !(semanticResults instanceof HTMLElement) ||
    !(reviewBadge instanceof HTMLElement) ||
    !(reviewTitle instanceof HTMLElement) ||
    !(reviewSummary instanceof HTMLElement) ||
    !(priorityList instanceof HTMLElement)
  ) {
    return;
  }

  const levels = {
    light_review: {
      label: "🟢 LIGHT REVIEW",
      title: "Light review recommended",
      className: "light"
    },

    review_advised: {
      label: "🟡 REVIEW ADVISED",
      title: "Review advised before use",
      className: "advised"
    },

    verification_needed: {
      label: "🟠 VERIFICATION NEEDED",
      title: "Verify key points before use",
      className: "verify"
    },

    high_impact_review: {
      label: "🔴 HIGH-IMPACT REVIEW",
      title: "Human review strongly recommended",
      className: "high"
    }
  };

  const level =
    levels[analysis.reviewLevel] ||
    levels.review_advised;

  reviewBadge.className =
    `review-badge ${level.className}`;

  reviewBadge.textContent = level.label;
  reviewTitle.textContent = level.title;

  reviewSummary.textContent =
    analysis.summary || "Review completed.";

  priorityList.innerHTML = "";

  const priorities = Array.isArray(analysis.priorities)
    ? analysis.priorities
    : [];

  priorities.forEach((item) => {
    const card = document.createElement("article");
    card.className = "priority-card";

    const type = document.createElement("span");
    type.className = "priority-type";
    type.textContent =
      String(item.type || "review")
        .replaceAll("_", " ");

    const title = document.createElement("h4");
    title.textContent =
      item.text || "Item requiring review";

    const why = document.createElement("p");

    const whyLabel = document.createElement("strong");
    whyLabel.textContent = "Why: ";

    why.append(
      whyLabel,
      document.createTextNode(item.why || "")
    );

    const verify = document.createElement("p");

    const verifyLabel =
      document.createElement("strong");

    verifyLabel.textContent = "How to verify: ";

    verify.append(
      verifyLabel,
      document.createTextNode(
        item.howToVerify || ""
      )
    );

    card.append(type, title, why, verify);
    priorityList.appendChild(card);
  });

  semanticResults.hidden = false;
}
  if (button instanceof HTMLButtonElement) {
  button.addEventListener("click", async () => {
    if (
      !(textarea instanceof HTMLTextAreaElement) ||
      textarea.value.trim().length === 0
    ) {
      textarea?.focus();
      return;
    }

    const text = textarea.value.trim();

    // Run browser checks first.
    runLocalCheck(text);

    // Prevent duplicate submissions while AI review is running.
    button.disabled = true;
button.textContent = "Checking AI Output...";

// Reset any previous AI failure state.
const previousSemanticError =
  document.getElementById("semantic-error");

const previousPriorityHeading =
  document.querySelector(".priority-heading");

if (previousSemanticError instanceof HTMLElement) {
  previousSemanticError.hidden = true;
}

if (previousPriorityHeading instanceof HTMLElement) {
  previousPriorityHeading.hidden = false;
}

try {
      const response = await fetch("/api/check", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          text
        })
      });

      const data = await response.json();

      if (!response.ok || !data.ok) {
        throw new Error(
          data.error || "Unable to complete AI review"
        );
      }

      console.log(
        "KRIYANO semantic analysis:",
        data.analysis
      );

      renderSemanticResults(data.analysis);
    } catch (error) {
      console.error(
        "KRIYANO CHECK request failed:",
        error
      );

      const semanticResults =
        document.getElementById("semantic-results");

      const semanticError =
        document.getElementById("semantic-error");

      const reviewSummary =
        document.getElementById("review-summary");

      const priorityList =
        document.getElementById("priority-list");

      const priorityHeading =
        document.querySelector(".priority-heading");

      if (semanticResults instanceof HTMLElement) {
        semanticResults.hidden = false;
      }

      if (semanticError instanceof HTMLElement) {
        semanticError.hidden = false;
      }

      if (reviewSummary instanceof HTMLElement) {
        reviewSummary.textContent = "";
      }

      if (priorityList instanceof HTMLElement) {
        priorityList.innerHTML = "";
      }

      if (priorityHeading instanceof HTMLElement) {
        priorityHeading.hidden = true;
      }
    } finally {
      button.disabled = false;
      button.textContent = "Check AI Output";
    }
  });
}
</script>

</BaseLayout>


<style>
  .check-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(77, 226, 197, 0.08),
        transparent 34rem
      ),
      var(--bg);
  }

  .check-wrap {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  .check-hero {
    padding: 110px 0 80px;
  }

  .check-hero .check-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .check-badge {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 6px 12px;
    margin-bottom: 24px;

    border: 1px solid rgba(183, 255, 74, 0.24);
    border-radius: 999px;

    background: rgba(183, 255, 74, 0.06);

    color: var(--lime);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .check-hero h1 {
    max-width: 850px;
    margin: 0;

    color: var(--text);
    font-size: clamp(3rem, 7vw, 5.8rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .check-hero h1 span {
    display: block;
    color: var(--lime);
  }
.semantic-results {
  margin-bottom: 28px;
  padding: 24px;
  border: 1px solid rgba(183, 255, 74, 0.16);
  border-radius: 20px;
  background:
    linear-gradient(
      145deg,
      rgba(183, 255, 74, 0.055),
      rgba(77, 226, 197, 0.025)
    );
}

.semantic-error {
  margin: 16px 0 20px;
  padding: 16px 18px;
  border: 1px solid rgba(255, 180, 80, 0.22);
  border-radius: 14px;
  background: rgba(255, 180, 80, 0.06);
}

.semantic-error strong {
  display: block;
  margin-bottom: 6px;
  color: var(--text);
}

.semantic-error p {
  margin: 0;
  color: var(--muted);
  line-height: 1.6;
}
.semantic-heading {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.semantic-heading h2 {
  margin: 0;
  font-size: clamp(1.35rem, 3vw, 1.8rem);
}

.review-badge {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 6px 11px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  border: 1px solid currentColor;
}

.review-badge.light {
  color: #b7ff4a;
  background: rgba(183, 255, 74, 0.08);
}

.review-badge.advised {
  color: #f2d675;
  background: rgba(242, 214, 117, 0.08);
}

.review-badge.verify {
  color: #ffb45e;
  background: rgba(255, 180, 94, 0.08);
}

.review-badge.high {
  color: #ff7676;
  background: rgba(255, 118, 118, 0.08);
}

.review-summary {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.priority-heading {
  margin-top: 26px;
  margin-bottom: 14px;
}

.priority-heading span {
  display: block;
  margin-bottom: 5px;
  color: var(--lime);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.priority-heading h3 {
  margin: 0;
  font-size: 1.05rem;
}

.priority-list {
  display: grid;
  gap: 12px;
}

.priority-card {
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.025);
}

.priority-type {
  display: inline-block;
  margin-bottom: 8px;
  color: var(--mint);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.priority-card h4 {
  margin: 0 0 12px;
  font-size: 1rem;
  line-height: 1.45;
}

.priority-card p {
  margin: 7px 0 0;
  color: var(--muted);
  font-size: 0.9rem;
  line-height: 1.6;
}

.priority-card strong {
  color: var(--text);
}
  .check-intro {
    max-width: 690px;
    margin: 28px auto 0;

    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.18rem);
    line-height: 1.75;
  }

  .check-card {
    width: min(850px, 100%);
    margin-top: 48px;
    padding: 26px;

    text-align: left;

    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 24px;

    background:
      linear-gradient(
        145deg,
        rgba(17, 36, 27, 0.98),
        rgba(10, 23, 17, 0.98)
      );

    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.28),
      0 0 80px rgba(183, 255, 74, 0.035);
  }

  .check-card-header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .check-card-header h2 {
    margin: 0 0 5px;

    color: var(--text);
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .check-card-header p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .status {
    height: fit-content;
    padding: 5px 9px;

    border: 1px solid rgba(77, 226, 197, 0.2);
    border-radius: 8px;

    color: var(--mint);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .input-label {
    display: block;
    margin-bottom: 9px;

    color: var(--text);
    font-size: 0.82rem;
    font-weight: 700;
  }

  #ai-output {
    display: block;
    width: 100%;
    min-height: 260px;
    resize: vertical;

    padding: 18px;

    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 14px;
    outline: none;

    background: rgba(3, 10, 7, 0.7);

    color: var(--text);
    font: inherit;
    font-size: 0.96rem;
    line-height: 1.65;

    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  #ai-output::placeholder {
    color: #68756e;
  }

  #ai-output:focus {
    border-color: rgba(183, 255, 74, 0.55);

    box-shadow:
      0 0 0 3px rgba(183, 255, 74, 0.07);
  }

  .input-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    margin-top: 16px;
  }

  #character-count {
    color: var(--muted);
    font-size: 0.78rem;
