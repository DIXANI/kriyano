---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Check AI Output Before You Use It | KRIYANO";
const description =
  "Free AI output checker: paste AI-written text and instantly flag the claims, numbers, sources and assumptions that need verifying before you publish or send it. Runs in your browser.";
const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "KRIYANO CHECK",
  description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@id": "https://kriyano.com/#organization" },
};
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
>
  <div class="check-page">

    <section class="check-hero">
      <div class="check-wrap">

        <div class="check-badge">KRIYANO CHECK</div>

        <h1>
          Check AI output before
          <span>you use it.</span>
        </h1>

        <p class="check-intro">
          Paste an AI-generated answer, report, summary or recommendation.
          KRIYANO helps identify what may need verification before you rely on it.
        </p>

        <div class="check-card">

          <div class="check-card-header">
            <div>
              <h2>AI Output Check</h2>
              <p>Paste the output you want to review.</p>
            </div>

            <button id="check-example" type="button" class="check-example">Try an example</button>
          </div>

          <label for="ai-output" class="input-label">
            AI-generated output
          </label>

          <textarea
            id="ai-output"
            maxlength="8000"
            placeholder="Paste the AI output here..."
          ></textarea>

          <div class="check-privacy">
            <label><input type="checkbox" id="check-online"/> Include online AI review</label>
            <p>Local checks stay in your browser. Enabling AI review sends this text to Cloudflare Workers AI. Avoid confidential or personal information. <a href="/privacy/">Privacy details</a></p>
          </div>
          <p id="check-input-status" role="status" class="check-input-status"></p>
          <div class="input-footer">

            <span id="character-count">
              0 / 8,000 characters
            </span>

            <button id="check-button" type="button">
              Check AI Output
              <span aria-hidden="true">→</span>
            </button>

          </div>

        </div>

        <div class="trust-row">

          <span>✓ No account required</span>

          <span>✓ Works with any AI</span>

          <span>✓ Designed for real work</span>

        </div>

      </div>
   </section>

<section id="check-results" class="check-results" hidden aria-label="Check results">
  <div class="check-wrap">

    <div class="results-card">

      <section id="arithmetic-results" class="arithmetic-results" hidden><h2>Possible calculation errors</h2><p>These checks cover simple written equations and a limited stock-quantity pattern. They do not verify the underlying facts.</p><ul id="arithmetic-list"></ul></section>
      <p class="local-review-note">Local signals are not a fact-check. Online AI review is optional and may miss errors.</p>
      <!-- Browser Detected Signals -->
      <div class="results-heading">

        <div>
          <p class="eyebrow">LOCAL CHECK</p>
          <h2>Detected signals</h2>
        </div>

        <span class="local-badge">
          Processed in browser
        </span>

      </div>

      <p class="results-intro">
        Structured items detected in the text that may help with verification.
        These signals do not determine whether the content is true or false.
      </p>


      <!-- Signal Statistics -->
      <div class="result-stats">

        <div class="result-stat">
          <strong id="stat-numbers">0</strong>
          <span>Numbers</span>
        </div>

        <div class="result-stat">
          <strong id="stat-percentages">0</strong>
          <span>Percentages</span>
        </div>

        <div class="result-stat">
          <strong id="stat-currencies">0</strong>
          <span>Currencies</span>
        </div>

        <div class="result-stat">
          <strong id="stat-dates">0</strong>
          <span>Dates</span>
        </div>

        <div class="result-stat">
          <strong id="stat-links">0</strong>
          <span>Links</span>
        </div>

        <div class="result-stat">
          <strong id="stat-citations">0</strong>
          <span>Citation signals</span>
        </div>

      </div>


      <!-- Detailed Detected Items -->
      <div id="detected-items" class="detected-items"></div>

      <!-- Main KRIYANO AI Review -->
      <div id="semantic-results" class="semantic-results" hidden>

        <div class="semantic-heading">
          <span id="review-badge" class="review-badge">
            REVIEW
          </span>

          <h2 id="review-title">
            AI Output Review
          </h2>
        </div>
        <div id="semantic-error" class="semantic-error" hidden>
  <strong>AI review couldn't be completed.</strong>
  <p>
    The browser-based signals above are still available.
    Please try the AI review again.
  </p>
</div>
        <p id="review-summary" class="review-summary"></p>

        <div class="priority-heading">
          <span>CHECK FIRST</span>
          <h3>What needs your attention</h3>
        </div>

        <div id="priority-list" class="priority-list"></div>

      </div>




    </div>

  </div>
</section>
    <section class="what-checks">
      <div class="check-wrap">

        <div class="section-heading">

          <p class="eyebrow">WHAT KRIYANO CHECK LOOKS FOR</p>

          <h2>
            Know what deserves a second look.
          </h2>

          <p>
            AI can produce useful answers that still contain information
            worth checking. KRIYANO helps you identify those areas before
            the output becomes real work.
          </p>

        </div>


        <div class="check-grid">

          <article class="feature-card">
            <span class="feature-number">01</span>
            <h3>Factual claims</h3>
            <p>
              Statements, statistics and specific facts that may require
              independent verification.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">02</span>
            <h3>Numbers</h3>
            <p>
              Percentages, currencies, dates, quantities and calculations
              worth double-checking.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">03</span>
            <h3>Assumptions</h3>
            <p>
              Conclusions or explanations that may go beyond the information
              actually provided.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">04</span>
            <h3>Recommendations</h3>
            <p>
              Advice that may depend on missing context, circumstances or
              professional judgment.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">05</span>
            <h3>Sources</h3>
            <p>
              Citations, links, reports and authorities that should be checked
              before relying on them.
            </p>
          </article>

          <article class="feature-card">
            <span class="feature-number">06</span>
            <h3>Current information</h3>
            <p>
              Prices, laws, rankings, roles and other information that may
              change over time.
            </p>
          </article>

        </div>

      </div>
    </section>


    <section class="review-explainer">
      <div class="check-wrap">

        <div class="explainer-card">

          <div>
            <p class="eyebrow">NOT AN AI DETECTOR</p>

            <h2>
              KRIYANO doesn't guess whether an answer is
              “AI-generated” or assign a fake accuracy score.
            </h2>
          </div>

          <p>
            The goal is practical: identify what deserves verification,
            explain why it matters and help you decide what to check before
            using the output.
          </p>

        </div>

      </div>
    </section>

  </div>


  <script>
  import { citationSignals as findCitations, arithmeticChecks, deduplicateFindings } from '../../utils/check-tools.mjs';
  const textarea = document.querySelector("#ai-output");
  const counter = document.querySelector("#character-count");
  const button = document.querySelector("#check-button");
  const results = document.querySelector("#check-results");
  const detectedItems = document.querySelector("#detected-items");

  const uniqueMatches = (text, regex) => {
    const matches = text.match(regex) ?? [];

    return [...new Set(matches.map((item) => item.trim()))];
  };

  const escapeHTML = (value) => {
    return value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  };

  const setStat = (id, value) => {
    const element = document.querySelector(id);

    if (element instanceof HTMLElement) {
      element.textContent = String(value);
    }
  };

  const createGroup = (title, items, message) => {
    if (items.length === 0) {
      return "";
    }

    const tags = items
      .slice(0, 20)
      .map(
        (item) =>
          `<span class="detected-tag">${escapeHTML(item)}</span>`
      )
      .join("");

    return `
      <div class="detected-group">
        <div class="detected-group-heading">
          <h3>${title}</h3>
          <span>${items.length}</span>
        </div>

        <p>${message}</p>

        <div class="detected-tags">
          ${tags}
        </div>
      </div>
    `;
  };

  const runLocalCheck = (text) => {
    /*
     * Percentages
     * Examples:
     * 25%
     * 17.4 %
     */
    const percentages = uniqueMatches(
      text,
      /\b\d+(?:\.\d+)?\s?%/g
    );

    /*
     * Currency values
     * Examples:
     * $500
     * USD 1,250
     * QAR 80,000
     * €99.50
     */
    const currencies = uniqueMatches(
      text,
      /(?:[$€£]\s?\d[\d,]*(?:\.\d+)?|\b(?:USD|EUR|GBP|QAR|AED|SAR|LKR|INR)\s?\d[\d,]*(?:\.\d+)?)/gi
    );

    /*
     * Common written and numeric dates.
     */
    const dates = uniqueMatches(
  text,
  /\b(?:\d{1,2}[\/.-]\d{1,2}[\/.-]\d{2,4}|\d{4}[\/.-]\d{1,2}[\/.-]\d{1,2}|(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\s+\d{1,2}(?:st|nd|rd|th)?(?:,\s*|\s+)\d{4}|\b(?:19|20)\d{2}\b)\b/gi
);

    /*
     * URLs
     */
    const links = uniqueMatches(
      text,
      /https?:\/\/[^\s<>"')\]]+/gi
    );

    /*
     * Citation/source language.
     * These are signals only — not verified citations.
     */
    const citationSignals = findCitations(text);
    const arithmetic = arithmeticChecks(text);
    const arithmeticSection = document.getElementById('arithmetic-results');
    const arithmeticList = document.getElementById('arithmetic-list');
    if (arithmeticSection && arithmeticList) { arithmeticSection.hidden = arithmetic.length === 0; arithmeticList.replaceChildren(); arithmetic.forEach(message => { const li = document.createElement('li'); li.textContent = message; arithmeticList.append(li); }); }

    /*
     * General numeric values.
     *
     * We remove values already identified as percentages,
     * currencies and dates before extracting remaining numbers.
     */
    let numberText = text;

    [...percentages, ...currencies, ...dates].forEach((item) => {
      numberText = numberText.split(item).join(" ");
    });

    const numbers = uniqueMatches(
      numberText,
      /\b\d[\d,]*(?:\.\d+)?\b/g
    );

    setStat("#stat-numbers", numbers.length);
    setStat("#stat-percentages", percentages.length);
    setStat("#stat-currencies", currencies.length);
    setStat("#stat-dates", dates.length);
    setStat("#stat-links", links.length);
    setStat("#stat-citations", citationSignals.length);

    const groups = [
      createGroup(
        "Percentages",
        percentages,
        "Check what each percentage measures, how it was calculated and whether its source is reliable."
      ),

      createGroup(
        "Currency values",
        currencies,
        "Financial figures may require source, currency, period and calculation verification."
      ),

      createGroup(
        "Dates",
        dates,
        "Dates can affect whether information is current and should be checked when timing matters."
      ),

      createGroup(
        "Links",
        links,
        "A link appearing in AI output does not guarantee that the page exists or supports the associated claim."
      ),

      createGroup(
        "Citation signals",
        citationSignals,
        "The output contains language suggesting external evidence or sources. Verify the original evidence before relying on it."
      ),

      createGroup(
        "Other numeric signals",
        numbers,
        "Check important quantities against the original data or calculation before using them."
      )
    ].join("");

    if (detectedItems instanceof HTMLElement) {
      detectedItems.innerHTML =
        groups ||
        `
          <div class="nothing-detected">
            <strong>No structured review items detected.</strong>
            <p>
              This does not mean the output is accurate. You can enable online AI review to look for claims, assumptions and recommendations.
            </p>
          </div>
        `;
    }

    if (results instanceof HTMLElement) {
      results.hidden = false;

      results.scrollIntoView({
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
        block: "start"
      });
    }
  };

  if (
    textarea instanceof HTMLTextAreaElement &&
    counter instanceof HTMLElement
  ) {
    const updateCount = () => {
      const count = textarea.value.length;

      counter.textContent =
        `${count.toLocaleString()} / 8,000 characters`;
    };
  
    textarea.addEventListener("input", updateCount);
    updateCount();
  }
function renderSemanticResults(analysis) {
  const semanticResults =
    document.querySelector("#semantic-results");
const semanticError = document.getElementById("semantic-error");
const priorityHeading = document.querySelector(".priority-heading");

if (semanticError instanceof HTMLElement) {
  semanticError.hidden = true;
}

if (priorityHeading instanceof HTMLElement) {
  priorityHeading.hidden = false;
}
  const reviewBadge =
    document.querySelector("#review-badge");

  const reviewTitle =
    document.querySelector("#review-title");

  const reviewSummary =
    document.querySelector("#review-summary");

  const priorityList =
    document.querySelector("#priority-list");

  if (
    !(semanticResults instanceof HTMLElement) ||
    !(reviewBadge instanceof HTMLElement) ||
    !(reviewTitle instanceof HTMLElement) ||
    !(reviewSummary instanceof HTMLElement) ||
    !(priorityList instanceof HTMLElement)
  ) {
    return;
  }

  const levels = {
    light_review: {
      label: "🟢 LIGHT REVIEW",
      title: "Light review recommended",
      className: "light"
    },

    review_advised: {
      label: "🟡 REVIEW ADVISED",
      title: "Review advised before use",
      className: "advised"
    },

    verification_needed: {
      label: "🟠 VERIFICATION NEEDED",
      title: "Verify key points before use",
      className: "verify"
    },

    high_impact_review: {
      label: "🔴 HIGH-IMPACT REVIEW",
      title: "Human review strongly recommended",
      className: "high"
    }
  };

  const level =
    levels[analysis.reviewLevel] ||
    levels.review_advised;

  reviewBadge.className =
    `review-badge ${level.className}`;

  reviewBadge.textContent = level.label;
  reviewTitle.textContent = level.title;

  reviewSummary.textContent =
    analysis.summary || "Review completed.";

  priorityList.innerHTML = "";

  const priorities = deduplicateFindings(Array.isArray(analysis.priorities)
    ? analysis.priorities
    : []);

  priorities.forEach((item) => {
    const card = document.createElement("article");
    card.className = "priority-card";

    const type = document.createElement("span");
    type.className = "priority-type";
    type.textContent =
      String(item.type || "review")
        .replaceAll("_", " ");

    const title = document.createElement("h4");
    title.textContent =
      item.text || "Item requiring review";

    const why = document.createElement("p");

    const whyLabel = document.createElement("strong");
    whyLabel.textContent = "Why: ";

    why.append(
      whyLabel,
      document.createTextNode(item.why || "")
    );

    const verify = document.createElement("p");

    const verifyLabel =
      document.createElement("strong");

    verifyLabel.textContent = "How to verify: ";

    verify.append(
      verifyLabel,
      document.createTextNode(
        item.howToVerify || ""
      )
    );

    card.append(type, title, why, verify);
    priorityList.appendChild(card);
  });

  semanticResults.hidden = false;
}
if (button instanceof HTMLButtonElement) {
  let running = false;

  button.addEventListener("click", async () => {
    if (running) return;

    const status = document.getElementById("check-input-status");
    const online = document.querySelector<HTMLInputElement>("#check-online");
    const example = document.querySelector<HTMLButtonElement>("#check-example");
    const semantic = document.getElementById("semantic-results");
    const semanticError = document.getElementById("semantic-error");
    const badge = document.getElementById("review-badge");
    const title = document.getElementById("review-title");
    const summary = document.getElementById("review-summary");
    const priorities = document.getElementById("priority-list");
    const heading =
      document.querySelector<HTMLElement>(".priority-heading");

    if (!(textarea instanceof HTMLTextAreaElement) || !status) return;

    const text = textarea.value.trim();

    if (!text) {
      status.textContent = "Paste some text or try the example first.";
      textarea.focus();
      return;
    }

    if (textarea.value.length > 8000) {
      status.textContent = "Please limit the input to 8,000 characters.";
      textarea.focus();
      return;
    }

    const includeOnline = online?.checked === true;
    const originalButton = button.innerHTML;
    let localComplete = false;

    running = true;
    button.disabled = true;
    textarea.disabled = true;
    if (online) online.disabled = true;
    if (example) example.disabled = true;

    button.textContent = "Checking…";
    status.textContent = "Checking text in your browser…";

    // Clear the previous review, including its title and badge.
    if (semantic) semantic.hidden = true;
    if (semanticError) semanticError.hidden = true;
    if (badge) {
      badge.className = "review-badge";
      badge.textContent = "REVIEW";
    }
    if (title) title.textContent = "AI Output Review";
    if (summary) summary.textContent = "";
    priorities?.replaceChildren();
    if (heading) heading.hidden = true;

    try {
      // Give the browser an opportunity to paint the loading state.
      await new Promise<void>((resolve) => {
        requestAnimationFrame(() => {
          setTimeout(resolve, 0);
        });
      });

      runLocalCheck(text);
      localComplete = true;

      if (!includeOnline) {
        status.textContent =
          "Local check complete. No text was sent for AI review.";
        return;
      }

      button.textContent = "Reviewing online…";
      status.textContent =
        "Local results are ready. Online AI review is running.";

      const response = await fetch("/api/check", {
        method: "POST",
        signal: AbortSignal.timeout(30000),
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ text }),
      });

      if (!response.ok) {
        throw new Error("Online review unavailable");
      }

      const data = await response.json();

      if (
        !data?.ok ||
        !data.analysis ||
        typeof data.analysis !== "object" ||
        Array.isArray(data.analysis)
      ) {
        throw new Error("Invalid review response");
      }

      renderSemanticResults(data.analysis);
      status.textContent =
        "Online review complete. Find it below the local results.";
    } catch {
      if (localComplete && includeOnline) {
        if (badge) {
          badge.className = "review-badge";
          badge.textContent = "UNAVAILABLE";
        }
        if (title) title.textContent = "Online review unavailable";
        if (summary) summary.textContent = "";
        priorities?.replaceChildren();
        if (heading) heading.hidden = true;
        if (semanticError) semanticError.hidden = false;
        if (semantic) semantic.hidden = false;

        status.textContent =
          "Online review couldn't be completed. Local results remain available.";
      } else {
        if (results instanceof HTMLElement) results.hidden = true;
        status.textContent =
          "The local check couldn't be completed. Please try again.";
      }
    } finally {
      running = false;
      button.disabled = false;
      textarea.disabled = false;
      if (online) online.disabled = false;
      if (example) example.disabled = false;
      button.innerHTML = originalButton;
    }
  });
}
document.querySelector('#check-example')?.addEventListener('click', () => {
  if (textarea instanceof HTMLTextAreaElement) { textarea.value = 'Example inventory report: System stock is 100 units and physical stock is 90 units. The shortage is 20 units. This proves the supplier delivered fewer items.'; textarea.dispatchEvent(new Event('input')); textarea.focus(); }
});
textarea?.addEventListener('input', () => { if (results instanceof HTMLElement) results.hidden = true; document.getElementById('check-input-status').textContent = ''; });
document.querySelector('#check-online')?.addEventListener('change', () => { if (results instanceof HTMLElement) results.hidden = true; document.getElementById('check-input-status').textContent = ''; });
</script>

</BaseLayout>






