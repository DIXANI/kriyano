---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PromptCategoryPage from "../../../components/PromptCategoryPage.astro";

const prompts = [
  {
    title: "SOP Creation Prompt",
    description:
      "Turn a warehouse, logistics or operational process into a clear and structured Standard Operating Procedure.",
    category: "Procedures",
    href: "/prompts/sop-creation/",
  },
  {
    title: "Inventory Discrepancy Investigation",
    description:
      "Investigate physical-versus-system stock differences using a structured warehouse and inventory-control workflow.",
    category: "Inventory",
    href: "/prompts/inventory-discrepancy-investigation/",
  },
  {
    title: "Root Cause Analysis Prompt",
    description:
      "Investigate an operational problem systematically and identify likely causes, evidence, corrective actions and prevention measures.",
    category: "Problem Solving",
    href: "/prompts/root-cause-analysis/",
  },
  {
    title: "Warehouse Process Improvement",
    description:
      "Review a warehouse workflow for delays, unnecessary movement, errors, control gaps and practical improvement opportunities.",
    category: "Improvement",
    href: "/prompts/warehouse-process-improvement/",
  },
  {
    title: "Inventory Report Analysis",
    description:
      "Analyze inventory data, trends, variances and exceptions and turn them into practical findings and recommended actions.",
    category: "Reporting",
    href: "/prompts/inventory-report-analysis/",
  },
  {
    title: "Receiving Discrepancy Investigation",
    description:
      "Investigate quantity, SKU, damage, documentation and system-posting issues found during inbound receiving.",
    category: "Receiving",
    href: "/prompts/receiving-discrepancy-investigation/",
  },
  {
    title: "Stock Count Planning Prompt",
    description:
      "Create a structured plan for cycle counts or physical inventory covering scope, responsibilities, controls and reconciliation.",
    category: "Stock Control",
    href: "/prompts/stock-count-planning/",
  },
  {
    title: "Warehouse KPI Analysis Prompt",
    description:
      "Review warehouse KPIs, identify performance gaps and convert operational data into practical improvement priorities.",
    category: "Performance",
    href: "/prompts/warehouse-kpi-analysis/",
  },
  {
    title: "Warehouse Safety Review Prompt",
    description:
      "Review warehouse activities for operational hazards, control gaps, unsafe practices and areas requiring further assessment.",
    category: "Safety",
    href: "/prompts/warehouse-safety-review/",
  },
  {
    title: "Corrective Action Plan Prompt",
    description:
      "Turn an operational finding, audit issue or repeated problem into clear corrective actions, responsibilities and follow-up checks.",
    category: "Corrective Action",
   href: "/prompts/corrective-action-plan/",
  },
];
---

<BaseLayout
  title="AI Prompts for Operations & Logistics | KRIYANO"
  description="Explore 10 AI prompts for warehouse operations and logistics: write SOPs, investigate stock discrepancies, review inventory reports and plan corrective actions."
>
  <PromptCategoryPage
    kicker="OPERATIONS & LOGISTICS"
    title="AI prompts for"
    accentTitle="operations & logistics."
    description="Choose from 10 practical prompts for warehouse supervisors, inventory controllers and operations teams. Draft SOPs, investigate stock differences, review reports and plan corrective actions. Add your process details, then verify the AI response against your records."
    prompts={prompts}
  >
    <section class="operations-guide" aria-labelledby="operations-guide-title">
      <div class="container">
        <p class="section-kicker">PUT THE PROMPTS TO WORK</p>
        <h2 id="operations-guide-title">Start with the task in front of you.</h2>

        <div class="task-grid">
          <article>
            <h3>Stock does not match</h3>
            <p>
              Use Inventory Discrepancy Investigation for differences between
              physical stock and system balances. Use Receiving Discrepancy
              Investigation when the issue starts with an inbound delivery.
            </p>
          </article>

          <article>
            <h3>A process needs documenting</h3>
            <p>
              Start with SOP Creation. Supply the actual steps, responsible
              roles, required records and approval points. Ask the AI to flag
              missing information rather than invent company procedures.
            </p>
          </article>

          <article>
            <h3>A problem keeps returning</h3>
            <p>
              Start with Root Cause Analysis to organize evidence and possible
              causes. Then use Corrective Action Plan to assign actions,
              owners, deadlines and checks that confirm the action worked.
            </p>
          </article>
        </div>

        <article class="worked-example" aria-labelledby="stock-example-title">
          <p class="section-kicker">WORKED EXAMPLE · FICTIONAL DATA</p>
          <h2 id="stock-example-title">Investigate a 10-unit stock difference.</h2>

          <p>
            A count finds 90 units where the system shows 100. A picking
            document lists 10 units, but nobody has confirmed whether that
            movement explains the difference.
          </p>

          <h3>Example prompt to adapt</h3>

          <div class="example-prompt">
            <p>
              Act as an inventory-control assistant. Help me plan an
              investigation before any stock adjustment.
            </p>
            <p>
              SKU: DEMO-001. Location: A-01. Unit of measure: each.
              At the count cutoff, the system shows 100 units and the first
              physical count shows 90. A picking document for 10 units exists,
              but its physical movement and system-posting status are unverified.
            </p>
            <p>
              Calculate the variance as physical minus system. Separate
              confirmed facts from possible explanations. Give me a checklist
              covering recounts, other locations, receiving, picking, transfers,
              damaged stock and transactions around the cutoff.
            </p>
            <p>
              For each check, state the evidence needed and a suggested
              responsible role. Do not assume the picking document explains
              the difference. Do not recommend posting an adjustment without
              investigation and approval under our company procedure.
            </p>
          </div>

          <h3>What a useful response should include</h3>
          <ul>
            <li>
              <strong>Correct arithmetic:</strong>
              90 − 100 = −10 units, a shortage of 10 units.
            </li>
            <li>
              <strong>A recount:</strong>
              verify the SKU, location, unit of measure and count cutoff.
            </li>
            <li>
              <strong>Evidence checks:</strong>
              establish whether the picking document represents a real movement
              and whether it was posted before or after the cutoff.
            </li>
            <li>
              <strong>Other explanations:</strong>
              check misplaced stock, transfers, receipts, damage and recording
              errors before accepting a cause.
            </li>
            <li>
              <strong>An unresolved conclusion when appropriate:</strong>
              matching quantities alone do not prove what happened.
            </li>
          </ul>

          <p class="review-note">
            This is an illustrative review checklist, not a recorded AI test
            result. Verify any generated answer against your documents and
            approved procedures. Use anonymized examples when working with
            an external AI service.
          </p>

          <a
            class="guide-link"
            href="/prompts/inventory-discrepancy-investigation/"
          >
            Open the full inventory investigation prompt →
          </a>
        </article>

        <div class="supporting-tools">
          <h2>Prepare your data. Check the answer.</h2>

          <p>
            Comparing SKU lists? The List Cleaner can identify shared or
            missing entries between two lists. It compares entries; it does
            not reconcile stock quantities.
          </p>

          <div class="guide-links">
            <a class="guide-link" href="/tools/list-cleaner/">
              Open Spreadsheet List Cleaner →
            </a>
            <a class="guide-link" href="/check/">
              Review an AI answer with KRIYANO CHECK →
            </a>
          </div>

          <p class="review-note">
            KRIYANO CHECK can flag items for review. It cannot confirm your
            warehouse records or replace an operational investigation.
          </p>
        </div>
      </div>
    </section>
  </PromptCategoryPage>
</BaseLayout>