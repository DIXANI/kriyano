---
import ToolLayout from '../../../layouts/ToolLayout.astro';
---
<ToolLayout title="Base64 Encoder & Decoder" description="Encode UTF-8 text to Base64 or decode Base64 and Base64URL values back to readable text locally in your browser." category="Developer">
<section class="kit-panel base64-controls"><div class="kit-fields"><div class="kit-field"><label for="base64-mode">Mode</label><select id="base64-mode"><option value="encode">Encode text → Base64</option><option value="decode">Decode Base64 → text</option></select></div><div class="kit-field"><label for="base64-variant">Variant</label><select id="base64-variant"><option value="standard">Standard Base64</option><option value="url">Base64URL</option></select></div></div></section>
<section class="kit-workspace" style="margin-top:22px">
 <div class="kit-panel"><h2 id="base64-input-title">Text to encode</h2><div class="kit-field"><label for="base64-input">Input</label><textarea id="base64-input" rows="15" spellcheck="false" placeholder="KRIYANO developer tools ✓"></textarea></div><div class="kit-actions"><button class="kit-btn primary" id="base64-run" type="button">Encode Base64</button><button class="kit-btn" id="base64-example" type="button">Load example</button><button class="kit-btn" id="base64-clear" type="button">Clear</button></div><p class="kit-status" id="base64-status" role="status"></p></div>
 <div class="kit-panel kit-result"><h2 id="base64-output-title">Base64 output</h2><div class="kit-field"><label for="base64-output">Result</label><textarea id="base64-output" rows="15" readonly spellcheck="false"></textarea></div><div class="kit-actions"><button class="kit-btn" id="base64-copy" type="button" disabled>Copy result</button><button class="kit-btn" id="base64-swap" type="button" disabled>Use result as input</button></div></div>
</section>
<section class="kit-guide kit-reading"><h2>What is Base64?</h2><p>Base64 represents binary or text data with a restricted ASCII character set. It is commonly used in API payloads, data URLs, tokens and configuration values. Encoding is not encryption and does not make sensitive data secret.</p><h2>Base64URL</h2><p>Base64URL replaces characters that are awkward in URLs and commonly removes trailing padding. It is widely used in JWTs and web protocols.</p><h2>Unicode-safe and local</h2><p>This tool converts text through UTF-8 so non-English characters and emoji are handled correctly. Processing stays in your browser.</p></section>
</ToolLayout>
<script>
const mode=document.querySelector<HTMLSelectElement>('#base64-mode')!, variant=document.querySelector<HTMLSelectElement>('#base64-variant')!, input=document.querySelector<HTMLTextAreaElement>('#base64-input')!, output=document.querySelector<HTMLTextAreaElement>('#base64-output')!, status=document.querySelector<HTMLElement>('#base64-status')!, copy=document.querySelector<HTMLButtonElement>('#base64-copy')!, swap=document.querySelector<HTMLButtonElement>('#base64-swap')!;
function bytesToBase64(bytes:Uint8Array){let binary='';const chunk=0x8000;for(let i=0;i<bytes.length;i+=chunk)binary+=String.fromCharCode(...bytes.subarray(i,i+chunk));return btoa(binary);}
function base64ToBytes(value:string){const binary=atob(value);const bytes=new Uint8Array(binary.length);for(let i=0;i<binary.length;i++)bytes[i]=binary.charCodeAt(i);return bytes;}
function asUrl(value:string){return value.replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');}
function asStandard(value:string){let normalized=value.trim().replace(/\s+/g,'').replace(/-/g,'+').replace(/_/g,'/');if(!/^[A-Za-z0-9+/]*={0,2}$/.test(normalized))throw new Error('Input contains characters that are not valid Base64.');if(normalized.length%4===1)throw new Error('Base64 length is invalid.');while(normalized.length%4)normalized+='=';return normalized;}
function clearResult(){output.value='';copy.disabled=true;swap.disabled=true;status.textContent='';status.classList.remove('kit-error');}
function labels(){const encoding=mode.value==='encode';document.querySelector('#base64-input-title')!.textContent=encoding?'Text to encode':'Base64 to decode';document.querySelector('#base64-output-title')!.textContent=encoding?(variant.value==='url'?'Base64URL output':'Base64 output'):'Decoded text';document.querySelector('#base64-run')!.textContent=encoding?'Encode Base64':'Decode Base64';input.placeholder=encoding?'KRIYANO developer tools ✓':'S1JJWU...';clearResult();}
function run(){if(!input.value){clearResult();status.textContent='Enter a value first.';status.classList.add('kit-error');return;}try{if(mode.value==='encode'){let encoded=bytesToBase64(new TextEncoder().encode(input.value));if(variant.value==='url')encoded=asUrl(encoded);output.value=encoded;}else{const bytes=base64ToBytes(asStandard(input.value));output.value=new TextDecoder('utf-8',{fatal:true}).decode(bytes);}copy.disabled=false;swap.disabled=false;status.classList.remove('kit-error');status.textContent='Processed locally in your browser.';}catch(error){clearResult();status.textContent=error instanceof Error?error.message:'Could not process the value.';status.classList.add('kit-error');}}
mode.addEventListener('change',labels);variant.addEventListener('change',()=>{labels();});input.addEventListener('input',clearResult);document.querySelector('#base64-run')!.addEventListener('click',run);document.querySelector('#base64-example')!.addEventListener('click',()=>{input.value=mode.value==='encode'?'KRIYANO developer tools ✓':'S1JJWU5PIGRldmVsb3BlciB0b29scyDinJM=';run();});document.querySelector('#base64-clear')!.addEventListener('click',()=>{input.value='';clearResult();input.focus();});copy.addEventListener('click',async()=>{if(!output.value)return;try{await navigator.clipboard.writeText(output.value);status.textContent='Result copied.';}catch{output.select();document.execCommand('copy');status.textContent='Result copied.';}});swap.addEventListener('click',()=>{if(!output.value)return;input.value=output.value;mode.value=mode.value==='encode'?'decode':'encode';labels();run();});labels();
</script>
<style>.base64-controls{max-width:760px}.base64-controls .kit-fields{margin-bottom:0}</style>
