---
import ToolLayout from '../../../layouts/ToolLayout.astro';
---
<ToolLayout title="JWT Decoder" description="Decode JWT headers and payloads locally in your browser and inspect common token time claims." category="Developer">
<section class="kit-workspace">
 <div class="kit-panel"><h2>Paste a JWT</h2><div class="kit-field"><label for="jwt-input">JSON Web Token</label><textarea id="jwt-input" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."></textarea><p class="kit-help">Decoding does not verify the token signature. Avoid pasting secrets into tools you do not trust; this decoder processes the token locally.</p></div><div class="kit-actions"><button class="kit-btn primary" id="jwt-decode" type="button">Decode JWT</button><button class="kit-btn" id="jwt-clear" type="button">Clear</button></div><p class="kit-status" id="jwt-status" role="status"></p></div>
 <div class="kit-panel kit-result"><h2>Token details</h2><label for="jwt-header">Header</label><textarea id="jwt-header" rows="6" readonly></textarea><label for="jwt-payload" style="margin-top:16px">Payload</label><textarea id="jwt-payload" rows="10" readonly></textarea><dl><div><dt>Expires</dt><dd id="jwt-exp">—</dd></div><div><dt>Issued at</dt><dd id="jwt-iat">—</dd></div></dl><div class="kit-actions"><button class="kit-btn" id="jwt-copy-headers" type="button">Copy Results</button></div></div>
</section>
<section class="kit-guide kit-reading"><h2>What this JWT decoder does</h2><p>A JWT normally contains three dot-separated parts: a header, a payload and a signature. This tool Base64URL-decodes the first two sections so you can inspect their JSON contents.</p><h2>What it does not do</h2><p>Decoding a JWT is not the same as verifying it. This page does not confirm that the signature is valid or that the token should be trusted.</p><h2>Privacy</h2><p>The token is decoded in your browser and is not sent to KRIYANO.</p></section>
</ToolLayout>
<script>
import { copyText } from '../../../utils/tool-browser.ts';
const input = document.querySelector<HTMLTextAreaElement>('#jwt-input')!;
const status = document.querySelector<HTMLElement>('#jwt-status')!;
const headerOut = document.querySelector<HTMLTextAreaElement>('#jwt-header')!;
const payloadOut = document.querySelector<HTMLTextAreaElement>('#jwt-payload')!;
const base64urlRegex = /^[A-Za-z0-9_-]+(?:=+)?$/;
function decodePart(part) {
  const base = part.replace(/-/g, '+').replace(/_/g, '/');
  const padded = base + '='.repeat((4 - base.length % 4) % 4);
  const binary = atob(padded);
  const bytes = Uint8Array.from(binary, c => c.charCodeAt(0));
  return new TextDecoder().decode(bytes);
}
function formatClaim(v) {
  if (typeof v !== 'number' || !Number.isFinite(v)) return '—';
  const d = new Date(v * 1000);
  return Number.isNaN(d.getTime()) ? '—' : `${d.toLocaleString()} (${d.toISOString()})`;
}
function decode() {
  status.classList.remove('kit-error');
  const token = input.value.trim();
  const parts = token.split('.');
  if (parts.length !== 3) {
    status.textContent = 'A JWT should contain three dot-separated sections.';
    status.classList.add('kit-error');
    return;
  }
  for (let i = 0; i < 2; i++) {
    if (!base64urlRegex.test(parts[i])) {
      status.textContent = `Segment ${i + 1} contains invalid Base64URL characters.`;
      status.classList.add('kit-error');
      return;
    }
  }
  try {
    const headerRaw = decodePart(parts[0]);
    const payloadRaw = decodePart(parts[1]);
    const header = JSON.parse(headerRaw);
    const payload = JSON.parse(payloadRaw);
    if (typeof header !== 'object' || header === null || Array.isArray(header)) {
      status.textContent = 'Header is not a valid JSON object.';
      status.classList.add('kit-error');
      return;
    }
    if (typeof payload !== 'object' || payload === null || Array.isArray(payload)) {
      status.textContent = 'Payload is not a valid JSON object.';
      status.classList.add('kit-error');
      return;
    }
    headerOut.value = JSON.stringify(header, null, 2);
    payloadOut.value = JSON.stringify(payload, null, 2);
    document.querySelector('#jwt-exp')!.textContent = formatClaim(payload.exp);
    document.querySelector('#jwt-iat')!.textContent = formatClaim(payload.iat);
    status.textContent = 'Decoded locally. Signature not verified.';
  } catch (err) {
    if (err instanceof SyntaxError) {
      status.textContent = 'Decoded segment is not valid JSON.';
    } else if (err instanceof DOMException) {
      status.textContent = 'Invalid Base64URL encoding in token segment.';
    } else {
      status.textContent = err instanceof Error ? err.message : 'Could not decode this token. Check that it is a valid JWT.';
    }
    status.classList.add('kit-error');
  }
}
document.querySelector('#jwt-decode')!.addEventListener('click', decode);
document.querySelector('#jwt-clear')!.addEventListener('click', () => {
  input.value = '';
  headerOut.value = '';
  payloadOut.value = '';
  document.querySelector('#jwt-exp')!.textContent = '—';
  document.querySelector('#jwt-iat')!.textContent = '—';
  status.textContent = '';
});
document.querySelector('#jwt-copy-headers')!.addEventListener('click', async () => {
  const text = [headerOut.value, payloadOut.value].filter(Boolean).join('\n\n');
  if (!text) { status.textContent = 'Decode a JWT first.'; return; }
  await copyText(text, status);
});
</script>
