---
import ToolLayout from '../../../layouts/ToolLayout.astro';
---
<ToolLayout title="SHA-256 Generator" description="Generate a SHA-256 hash from text using the browser Web Crypto API without sending the input anywhere." category="Developer">
<section class="kit-workspace">
  <div class="kit-panel"><h2>Text to hash</h2><div class="kit-field"><label for="sha-input">Input text</label><textarea id="sha-input" rows="13" spellcheck="false" placeholder="KRIYANO developer tools"></textarea></div><div class="kit-actions"><button class="kit-btn primary" id="sha-run" type="button">Generate SHA-256</button><button class="kit-btn" id="sha-example" type="button">Load example</button><button class="kit-btn" id="sha-clear" type="button">Clear</button></div><p class="kit-status" id="sha-status" role="status"></p></div>
  <div class="kit-panel kit-result"><h2>SHA-256 hash</h2><div class="kit-field"><label for="sha-output">64-character hexadecimal digest</label><textarea id="sha-output" rows="7" readonly spellcheck="false"></textarea></div><div class="kit-stats"><div><strong id="sha-bytes">0</strong><span>UTF-8 bytes</span></div><div><strong>256</strong><span>hash bits</span></div><div><strong>64</strong><span>hex characters</span></div></div><div class="kit-actions"><button class="kit-btn" id="sha-copy" type="button" disabled>Copy hash</button></div></div>
</section>
<section class="kit-guide kit-reading"><h2>What SHA-256 does</h2><p>SHA-256 is a cryptographic hash function that converts input data into a fixed 256-bit digest. The same input produces the same hash, while small input changes produce a different digest.</p><h2>Hashing is not encryption</h2><p>A SHA-256 hash is one-way and cannot be decrypted back into the original text. Do not treat a plain hash as a secure password-storage system; dedicated password-hashing algorithms are designed for that purpose.</p><h2>Runs locally</h2><p>The hash is generated with your browser's Web Crypto API. The input is not sent to KRIYANO.</p></section>
</ToolLayout>
<script>
const input=document.querySelector('#sha-input'),output=document.querySelector('#sha-output'),status=document.querySelector('#sha-status'),copy=document.querySelector('#sha-copy'),bytes=document.querySelector('#sha-bytes');
function reset(){output.value='';copy.disabled=true;bytes.textContent='0';status.textContent='';status.classList.remove('kit-error');}
async function run(){reset();if(!input.value){status.textContent='Enter text to hash.';status.classList.add('kit-error');return;}if(!globalThis.crypto?.subtle){status.textContent='Web Crypto is unavailable in this browser.';status.classList.add('kit-error');return;}const data=new TextEncoder().encode(input.value);const digest=await globalThis.crypto.subtle.digest('SHA-256',data);output.value=[...new Uint8Array(digest)].map(value=>value.toString(16).padStart(2,'0')).join('');bytes.textContent=String(data.length);copy.disabled=false;status.textContent='SHA-256 generated locally in your browser.';}
document.querySelector('#sha-run').addEventListener('click',()=>{run().catch(()=>{status.textContent='Could not generate the hash.';status.classList.add('kit-error');});});document.querySelector('#sha-example').addEventListener('click',()=>{input.value='KRIYANO developer tools';document.querySelector('#sha-run').click();});document.querySelector('#sha-clear').addEventListener('click',()=>{input.value='';reset();input.focus();});input.addEventListener('input',reset);copy.addEventListener('click',async()=>{if(!output.value)return;try{await navigator.clipboard.writeText(output.value);status.textContent='Hash copied.';}catch{output.select();document.execCommand('copy');status.textContent='Hash copied.';}});
</script>
