---
import ToolLayout from '../../../layouts/ToolLayout.astro';
---
<ToolLayout title="URL Encoder & Decoder" description="Encode or decode URL text and query values instantly with browser-native percent encoding." category="Web">
<section class="kit-workspace">
 <div class="kit-panel"><h2>Input</h2><div class="kit-field"><label for="url-input">Text or URL value</label><textarea id="url-input" placeholder="https://example.com/search?q=hello world"></textarea></div><div class="kit-field"><label for="url-mode">Encoding mode</label><select id="url-mode"><option value="component">URL component / query value</option><option value="uri">Full URI</option></select><p class="kit-help">Use component mode for query parameter values. Full URI mode preserves URL separators such as : / ? &amp; =.</p></div><div class="kit-actions"><button class="kit-btn primary" id="url-encode" type="button">Encode</button><button class="kit-btn" id="url-decode" type="button">Decode</button><button class="kit-btn" id="url-clear" type="button">Clear</button></div><p class="kit-status" id="url-status" role="status"></p></div>
 <div class="kit-panel kit-result"><h2>Result</h2><textarea id="url-output" rows="12" readonly aria-label="Encoded or decoded result"></textarea><div class="kit-actions"><button class="kit-btn" id="url-copy" type="button">Copy result</button></div></div>
</section>
<section class="kit-guide kit-reading"><h2>URL encoding</h2><p>Percent encoding converts characters that may have special meaning in a URL into a safe representation. Spaces in a component, for example, become <code>%20</code>.</p><h2>Component vs full URL</h2><p><code>encodeURIComponent</code> is usually appropriate for individual query values. <code>encodeURI</code> is intended for a full URI and leaves structural separators intact.</p><h2>Runs locally</h2><p>Encoding and decoding happen entirely in your browser.</p></section>
</ToolLayout>
<script>
const input=document.querySelector<HTMLTextAreaElement>('#url-input')!, output=document.querySelector<HTMLTextAreaElement>('#url-output')!, mode=document.querySelector<HTMLSelectElement>('#url-mode')!, status=document.querySelector<HTMLElement>('#url-status')!;
function run(kind:'encode'|'decode'){status.classList.remove('kit-error');try{const value=input.value;output.value=kind==='encode'?(mode.value==='component'?encodeURIComponent(value):encodeURI(value)):(mode.value==='component'?decodeURIComponent(value):decodeURI(value));status.textContent=`${kind==='encode'?'Encoded':'Decoded'} locally.`;}catch{status.textContent='This value contains malformed percent encoding and could not be decoded.';status.classList.add('kit-error');}}
document.querySelector('#url-encode')!.addEventListener('click',()=>run('encode'));document.querySelector('#url-decode')!.addEventListener('click',()=>run('decode'));document.querySelector('#url-clear')!.addEventListener('click',()=>{input.value='';output.value='';status.textContent='';});document.querySelector('#url-copy')!.addEventListener('click',async()=>{if(!output.value){status.textContent='Create a result first.';return;}try{await navigator.clipboard.writeText(output.value);status.textContent='Copied to clipboard.';}catch{output.select();document.execCommand('copy');status.textContent='Copied to clipboard.';}});
</script>
