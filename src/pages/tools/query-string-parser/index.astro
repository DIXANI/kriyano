---
import ToolLayout from '../../../layouts/ToolLayout.astro';
---
<ToolLayout title="Query String Parser" description="Parse URL query parameters into readable key-value pairs, including repeated parameters and encoded values." category="Web">
<section class="kit-workspace">
  <div class="kit-panel"><h2>Query input</h2><div class="kit-field"><label for="query-input">Paste a query string or full URL</label><textarea id="query-input" rows="11" spellcheck="false" placeholder="?utm_source=google&utm_medium=cpc&tag=dev&tag=web"></textarea></div><div class="kit-actions"><button class="kit-btn primary" id="query-run" type="button">Parse query</button><button class="kit-btn" id="query-example" type="button">Load example</button><button class="kit-btn" id="query-clear" type="button">Clear</button></div><p class="kit-status" id="query-status" role="status"></p></div>
  <div class="kit-panel kit-result"><h2>Parameters</h2><div class="query-table-wrap"><table class="query-table"><thead><tr><th>Key</th><th>Value</th></tr></thead><tbody id="query-body"><tr><td colspan="2">No parameters yet.</td></tr></tbody></table></div><div class="kit-actions"><button class="kit-btn" id="query-copy" type="button" disabled>Copy JSON</button></div></div>
</section>
<section class="kit-guide kit-reading"><h2>Inspect query parameters</h2><p>Paste either a full URL or only the part after the question mark. Repeated parameters are preserved as separate rows so nothing is silently lost.</p><h2>Related tools</h2><p>Use the <a href="/tools/url-parser/">URL Parser</a> for the rest of the URL components or the <a href="/tools/url-encoder/">URL Encoder & Decoder</a> for percent-encoded values.</p><h2>Browser-local</h2><p>Parsing happens in your browser and no query values are uploaded.</p></section>
</ToolLayout>
<script>
import { parseQueryString } from '../../../utils/technical-tools.mjs';
const input=document.querySelector('#query-input'),body=document.querySelector('#query-body'),status=document.querySelector('#query-status'),copy=document.querySelector('#query-copy');let current = [];
function reset(){current=[];body.innerHTML='<tr><td colspan="2">No parameters yet.</td></tr>';copy.disabled=true;status.textContent='';status.classList.remove('kit-error');}
function run(){reset();try{current=parseQueryString(input.value);if(!current.length){status.textContent='No query parameters found.';return;}body.innerHTML='';for(const row of current){const tr=document.createElement('tr'),key=document.createElement('td'),value=document.createElement('td');key.textContent=row.key;value.textContent=row.value;tr.append(key,value);body.appendChild(tr);}copy.disabled=false;status.textContent=`Parsed ${current.length} parameter${current.length===1?'':'s'}.`;}catch(error){status.textContent=error instanceof Error?error.message:'Could not parse query string.';status.classList.add('kit-error');}}
document.querySelector('#query-run').addEventListener('click',run);document.querySelector('#query-example').addEventListener('click',()=>{input.value='https://kriyano.com/tools/?utm_source=google&utm_medium=cpc&tag=dev&tag=web';run();});document.querySelector('#query-clear').addEventListener('click',()=>{input.value='';reset();input.focus();});input.addEventListener('input',reset);copy.addEventListener('click',async()=>{if(!current.length)return;try{await navigator.clipboard.writeText(JSON.stringify(current,null,2));status.textContent='Parameters copied as JSON.';}catch{status.textContent='Copy is unavailable in this browser.';}});
</script>
<style>.query-table-wrap{overflow-x:auto}.query-table{width:100%;border-collapse:collapse}.query-table th,.query-table td{padding:12px 10px;border-bottom:1px solid #d3ddcc;text-align:left;vertical-align:top;overflow-wrap:anywhere}.query-table th{font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;color:#526153}.query-table td{font-size:.9rem}</style>
