---
import ToolLayout from '../../../layouts/ToolLayout.astro';
---
<ToolLayout title="JSON ↔ YAML Converter" description="Convert JSON to readable YAML or turn common YAML data structures into formatted JSON, entirely in your browser." category="Text & Data">
<section class="kit-panel converter-controls">
 <div class="kit-fields"><div class="kit-field"><label for="convert-direction">Conversion</label><select id="convert-direction"><option value="json-yaml">JSON → YAML</option><option value="yaml-json">YAML → JSON</option></select></div><div class="kit-field"><label for="convert-indent">Indentation</label><select id="convert-indent"><option value="2">2 spaces</option><option value="4">4 spaces</option></select></div></div>
</section>
<section class="kit-workspace" style="margin-top:22px">
 <div class="kit-panel"><h2 id="source-title">JSON input</h2><div class="kit-field"><label for="convert-input" id="source-label">Paste JSON</label><textarea id="convert-input" rows="17" spellcheck="false" placeholder='{"name":"kriyano","tools":["uuid","jwt"]}'></textarea></div><div class="kit-actions"><button class="kit-btn primary" id="convert-run" type="button">Convert to YAML</button><button class="kit-btn" id="convert-example" type="button">Load example</button><button class="kit-btn" id="convert-clear" type="button">Clear</button></div><p class="kit-status" id="convert-status" role="status"></p></div>
 <div class="kit-panel kit-result"><h2 id="result-title">YAML output</h2><div class="kit-field"><label for="convert-output" id="result-label">Converted YAML</label><textarea id="convert-output" rows="17" readonly spellcheck="false"></textarea></div><div class="kit-actions"><button class="kit-btn" id="convert-copy" type="button" disabled>Copy result</button><button class="kit-btn" id="convert-swap" type="button" disabled>Use result as input</button></div></div>
</section>
<section class="kit-guide kit-reading"><h2>JSON and YAML conversion</h2><p>JSON is strict and machine-friendly, while YAML is often preferred for human-edited configuration files. This tool lets you move between the two formats without uploading the data.</p><h2>Supported YAML</h2><p>The YAML side supports common configuration structures: nested mappings and sequences, strings, numbers, booleans, null values, inline collections and basic block text. Advanced YAML tags and anchors are not expanded by this lightweight browser tool.</p><h2>Runs locally</h2><p>Conversion is performed in your browser. Your JSON or YAML is not sent to KRIYANO.</p></section>
</ToolLayout>
<script>
import { parseYaml, stringifyYaml } from '../../../utils/yaml-lite.mjs';
const direction=document.querySelector<HTMLSelectElement>('#convert-direction')!, indent=document.querySelector<HTMLSelectElement>('#convert-indent')!, input=document.querySelector<HTMLTextAreaElement>('#convert-input')!, output=document.querySelector<HTMLTextAreaElement>('#convert-output')!, status=document.querySelector<HTMLElement>('#convert-status')!, copy=document.querySelector<HTMLButtonElement>('#convert-copy')!, swap=document.querySelector<HTMLButtonElement>('#convert-swap')!;
const jsonExample={name:'kriyano',active:true,port:8080,tags:['developer','web'],limits:{requests:100,window:60}};
function labels(){const toYaml=direction.value==='json-yaml';document.querySelector('#source-title')!.textContent=toYaml?'JSON input':'YAML input';document.querySelector('#source-label')!.textContent=toYaml?'Paste JSON':'Paste YAML';document.querySelector('#result-title')!.textContent=toYaml?'YAML output':'JSON output';document.querySelector('#result-label')!.textContent=toYaml?'Converted YAML':'Converted JSON';document.querySelector('#convert-run')!.textContent=toYaml?'Convert to YAML':'Convert to JSON';input.placeholder=toYaml?'{"name":"kriyano","tools":["uuid","jwt"]}':'name: kriyano\ntools:\n  - uuid\n  - jwt';clearResult();}
function clearResult(){output.value='';copy.disabled=true;swap.disabled=true;status.textContent='';status.classList.remove('kit-error');}
function convert(){if(!input.value.trim()){clearResult();status.textContent='Paste something to convert.';status.classList.add('kit-error');return;}try{if(direction.value==='json-yaml'){const data=JSON.parse(input.value);output.value=stringifyYaml(data,Number(indent.value));}else{const data=parseYaml(input.value);output.value=JSON.stringify(data,null,Number(indent.value));}copy.disabled=false;swap.disabled=false;status.classList.remove('kit-error');status.textContent='Converted locally in your browser.';}catch(error){clearResult();status.textContent=error instanceof Error?error.message:'Could not convert the input.';status.classList.add('kit-error');}}
direction.addEventListener('change',labels);indent.addEventListener('change',()=>{if(output.value)convert();});input.addEventListener('input',clearResult);document.querySelector('#convert-run')!.addEventListener('click',convert);document.querySelector('#convert-example')!.addEventListener('click',()=>{input.value=direction.value==='json-yaml'?JSON.stringify(jsonExample,null,2):stringifyYaml(jsonExample,2);convert();});document.querySelector('#convert-clear')!.addEventListener('click',()=>{input.value='';clearResult();input.focus();});copy.addEventListener('click',async()=>{if(!output.value)return;try{await navigator.clipboard.writeText(output.value);status.textContent='Result copied.';}catch{output.select();document.execCommand('copy');status.textContent='Result copied.';}});swap.addEventListener('click',()=>{if(!output.value)return;input.value=output.value;direction.value=direction.value==='json-yaml'?'yaml-json':'json-yaml';labels();convert();});labels();
</script>
<style>.converter-controls{max-width:760px}.converter-controls .kit-fields{margin-bottom:0}</style>
