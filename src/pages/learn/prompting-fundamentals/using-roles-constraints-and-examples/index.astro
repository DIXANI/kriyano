---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { createLearnSchema } from "../../../../utils/learnSchema";

const articleTitle = "Using Roles, Constraints & Examples | KRIYANO";

const articleDescription =
  "Learn how to improve AI prompts by using roles, constraints and examples to guide perspective, control the response and produce more consistent results.";

const schema = createLearnSchema({
  title: "Using Roles, Constraints & Examples",
  description: articleDescription,
  pathName: "Prompting Fundamentals",
  pathSlug: "prompting-fundamentals",
  articleSlug: "using-roles-constraints-and-examples",
});
const roleExamples = [
  {
    title: "Operations perspective",
    prompt: "Act as an operations manager reviewing this process.",
    use: "Useful when you want the response framed around efficiency, risk, coordination and execution.",
  },
  {
    title: "Customer-service perspective",
    prompt: "Act as a customer service supervisor.",
    use: "Useful when tone, clarity and customer impact matter.",
  },
  {
    title: "Trainer perspective",
    prompt: "Explain this as a workplace trainer.",
    use: "Useful when you want a structured explanation for beginners.",
  },
];

const constraintExamples = [
  {
    number: "01",
    title: "Length",
    example: "Keep the answer under 200 words.",
  },
  {
    number: "02",
    title: "Format",
    example: "Return the answer as a five-step checklist.",
  },
  {
    number: "03",
    title: "Scope",
    example: "Focus only on warehouse receiving operations.",
  },
  {
    number: "04",
    title: "Evidence",
    example: "Do not invent facts that are not provided.",
  },
  {
    number: "05",
    title: "Language",
    example: "Use simple English suitable for frontline staff.",
  },
  {
    number: "06",
    title: "Decision limits",
    example: "Do not approve or reject the request. Only summarize the risks.",
  },
];

const exampleTypes = [
  {
    title: "Format example",
    text:
      "Show AI what the final answer should look like when structure matters.",
  },
  {
    title: "Style example",
    text:
      "Provide a short sample when you want a specific communication style.",
  },
  {
    title: "Classification example",
    text:
      "Show one or two labelled examples when AI needs to sort information into categories.",
  },
  {
    title: "Before-and-after example",
    text:
      "Useful when asking AI to rewrite or improve content while preserving the original meaning.",
  },
];

const checklist = [
  "Would a role genuinely improve the perspective?",
  "Which constraints are essential to the task?",
  "Could an example remove ambiguity?",
  "Am I giving instructions that conflict with each other?",
  "Have I kept the prompt practical rather than overloaded?",
  "Will I still review the final result myself?",
];
---

<BaseLayout
  title={articleTitle}
  description={articleDescription}
  schema={schema}
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>PROMPTING FUNDAMENTALS</span>
            <span>07</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            Using Roles,
            <span>Constraints & Examples.</span>
          </h1>

          <p class="article-intro">
            Roles, constraints and examples can give you more control over AI
            output. The key is knowing when they actually improve the task and
            when they only make the prompt longer.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 07</span>
            <span>PROMPTING FUNDAMENTALS</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">THREE CONTROL TOOLS</span>

            <strong>
              Role = perspective. Constraint = boundary. Example = reference.
            </strong>

            <p>
              Use each one for a specific reason. Strong prompts are controlled,
              not crowded.
            </p>
          </div>

          <div class="panel-footer">
            <span>PERSPECTIVE → BOUNDARIES → REFERENCE</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#roles">Using roles</a>
            <a href="#constraints">Using constraints</a>
            <a href="#examples">Using examples</a>
            <a href="#combined">Combining all three</a>
            <a href="#mistakes">What to avoid</a>
            <a href="#checklist">Prompt checklist</a>
            <a href="#takeaway">The practical takeaway</a>
          </div>
        </aside>

        <article class="article-content">
          <section id="roles">
            <div class="section-marker">01 / ROLES</div>

            <h2>Use a role when perspective changes the answer.</h2>

            <p>
              A role tells AI what kind of viewpoint or working perspective
              should guide the response. This can be useful when the same task
              could be approached differently by different functions.
            </p>

            <p>
              But a role is not magic. Writing “act as an expert” does not
              automatically make an answer accurate. The task, context and
              evidence still matter.
            </p>

            <div class="role-grid">
              {
                roleExamples.map((item) => (
                  <article class="role-card">
                    <h3>{item.title}</h3>

                    <div class="mini-prompt">
                      <span>PROMPT</span>
                      <p>{item.prompt}</p>
                    </div>

                    <p>{item.use}</p>
                  </article>
                ))
              }
            </div>

            <div class="concept-box">
              <span>USE A ROLE WHEN</span>

              <p>
                The perspective affects priorities, terminology, tone or the
                way the task should be evaluated.
              </p>
            </div>
          </section>

          <section id="constraints">
            <div class="section-marker">02 / CONSTRAINTS</div>

            <h2>Constraints define what the answer must and must not do.</h2>

            <p>
              Constraints are one of the most practical ways to improve prompt
              control. They help reduce unwanted assumptions, excessive detail,
              wrong formats and recommendations outside your actual scope.
            </p>

            <div class="constraint-grid">
              {
                constraintExamples.map((item) => (
                  <article class="constraint-card">
                    <span>{item.number}</span>
                    <h3>{item.title}</h3>
                    <p>{item.example}</p>
                  </article>
                ))
              }
            </div>

            <div class="warning-box">
              <span>WATCH FOR CONFLICTS</span>

              <p>
                Do not give AI incompatible constraints such as “be extremely
                detailed” and “keep the answer under 50 words.” If two
                instructions compete, the result becomes less predictable.
              </p>
            </div>
          </section>

          <section id="examples">
            <div class="section-marker">03 / EXAMPLES</div>

            <h2>Examples show AI what you mean instead of only describing it.</h2>

            <p>
              Examples are especially useful when the desired format, style or
              classification is difficult to explain precisely in one sentence.
            </p>

            <div class="example-grid">
              {
                exampleTypes.map((item, index) => (
                  <div class="example-card">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </div>
                ))
              }
            </div>

            <div class="before-after">
              <div>
                <span>WITHOUT EXAMPLE</span>

                <p>
                  Rewrite these warehouse instructions in a clear professional
                  style.
                </p>
              </div>

              <div>
                <span>WITH STYLE EXAMPLE</span>

                <p>
                  Rewrite these warehouse instructions in a clear professional
                  style. Use short direct sentences similar to this:
                  “Verify the item code before confirming receipt. Report any
                  mismatch before posting the transaction.”
                </p>
              </div>
            </div>
          </section>

          <section id="combined">
            <div class="section-marker">04 / PUTTING THEM TOGETHER</div>

            <h2>Use only the controls that improve the real task.</h2>

            <p>
              Imagine you need help preparing a management summary after a stock
              discrepancy investigation.
            </p>

            <div class="work-flow">
              <div class="flow-row">
                <span>ROLE</span>
                <div>
                  <strong>Set the useful perspective</strong>
                  <p>
                    Act as an inventory control supervisor.
                  </p>
                </div>
              </div>

              <div class="flow-row">
                <span>TASK</span>
                <div>
                  <strong>Define the job</strong>
                  <p>
                    Prepare a concise investigation summary for management.
                  </p>
                </div>
              </div>

              <div class="flow-row">
                <span>CONTEXT</span>
                <div>
                  <strong>Provide the facts</strong>
                  <p>
                    System quantity is 840 units and verified physical quantity
                    is 818 units. Receiving, dispatch and recent adjustment
                    transactions have been checked.
                  </p>
                </div>
              </div>

              <div class="flow-row">
                <span>CONSTRAINT</span>
                <div>
                  <strong>Control the answer</strong>
                  <p>
                    Do not state a root cause unless it is supported by the
                    information provided.
                  </p>
                </div>
              </div>

              <div class="flow-row">
                <span>EXAMPLE</span>
                <div>
                  <strong>Show the required structure</strong>
                  <p>
                    Use the headings: Variance, Checks Completed, Findings,
                    Outstanding Questions, Recommended Next Action.
                  </p>
                </div>
              </div>
            </div>

            <div class="assembled-prompt">
              <span>ASSEMBLED PROMPT</span>

              <p>
                Act as an inventory control supervisor. Prepare a concise
                investigation summary for management. System quantity is 840
                units and verified physical quantity is 818 units. Receiving,
                dispatch and recent adjustment transactions have already been
                checked. Use the headings: Variance, Checks Completed, Findings,
                Outstanding Questions and Recommended Next Action. Do not state
                a root cause unless it is supported by the information
                provided.
              </p>
            </div>
          </section>

          <section id="mistakes">
            <div class="section-marker">05 / WHAT TO AVOID</div>

            <h2>More instructions do not automatically create a better prompt.</h2>

            <div class="mistake-list">
              <div>
                <span>01</span>
                <strong>Fake expertise</strong>
                <p>
                  Do not rely on “act as a world-class expert” instead of
                  providing proper context and evidence.
                </p>
              </div>

              <div>
                <span>02</span>
                <strong>Too many constraints</strong>
                <p>
                  Avoid adding rules that do not materially improve the output.
                </p>
              </div>

              <div>
                <span>03</span>
                <strong>Conflicting instructions</strong>
                <p>
                  Check that tone, length, format and detail requirements can
                  all be satisfied together.
                </p>
              </div>

              <div>
                <span>04</span>
                <strong>Bad examples</strong>
                <p>
                  AI may imitate the weaknesses of the example you provide, so
                  use examples that actually represent the quality you want.
                </p>
              </div>

              <div>
                <span>05</span>
                <strong>Over-controlling creative tasks</strong>
                <p>
                  Leave room for useful variation when you are brainstorming or
                  exploring ideas.
                </p>
              </div>
            </div>
          </section>

          <section id="checklist">
            <div class="section-marker">06 / QUICK CHECK</div>

            <h2>Before adding another instruction, ask whether it earns its place.</h2>

            <div class="checklist">
              {
                checklist.map((item, index) => (
                  <div class="check-row">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <p>{item}</p>
                    <strong>✓</strong>
                  </div>
                ))
              }
            </div>

            <div class="decision-box">
              <span>SIMPLE RULE</span>

              <p>
                Add a role for perspective, a constraint for control, and an
                example for clarity. If one of them does not improve the task,
                leave it out.
              </p>
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">07 / PRACTICAL TAKEAWAY</div>

            <h2>Use prompt controls deliberately.</h2>

            <p>
              Start with the task and context. Then add roles, constraints or
              examples only where they make the expected result clearer.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Role</strong>
                <p>Choose the useful perspective.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Constraint</strong>
                <p>Set meaningful boundaries.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>Example</strong>
                <p>Show what good looks like.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Review</strong>
                <p>Remove anything unnecessary.</p>
              </div>
            </div>

            <div class="tool-callout">
              <div>
                <span class="tool-kicker">BUILD IT WITH KRIYANO</span>

                <h3>Put these controls into a structured prompt.</h3>

                <p>
                  Use the KRIYANO Prompt Builder to combine role, context,
                  output requirements, tone and constraints without losing sight
                  of the main task.
                </p>
              </div>

              <a href="/tools/prompt-builder/" class="button button-primary">
                Open Prompt Builder
              </a>
            </div>
          </section>

          <section class="next-lesson">
            <div>
              <span class="next-label">NEXT LESSON</span>

              <h2>Improving a Weak Prompt</h2>

              <p>
                Learn a practical step-by-step method for diagnosing a weak
                prompt and improving it without rewriting everything from
                scratch.
              </p>
            </div>

            <a
  href="/learn/prompting-fundamentals/improving-a-weak-prompt/"
  class="next-status"
>
  CONTINUE →
</a>
          </section>
        </article>
      </div>
    </section>
  </article>
</BaseLayout>

