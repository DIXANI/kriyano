---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const contextTypes = [
  {
    number: "01",
    title: "Situation",
    text:
      "Explain what is happening now so AI understands the background of the task.",
    example: "A customer order is delayed because one item is out of stock.",
  },
  {
    number: "02",
    title: "Goal",
    text:
      "State what you are trying to achieve, not just what you want AI to produce.",
    example: "Keep the customer informed without promising an unconfirmed date.",
  },
  {
    number: "03",
    title: "Relevant facts",
    text:
      "Include the facts that directly affect the answer and leave out details that do not matter.",
    example: "The replacement item is expected from the supplier within three days.",
  },
  {
    number: "04",
    title: "Audience",
    text:
      "Tell AI who the output is for so it can adjust tone, terminology and detail.",
    example: "The message is for a retail customer, not an internal operations team.",
  },
  {
    number: "05",
    title: "Previous actions",
    text:
      "Mention what has already been checked, tried or communicated when that affects the next step.",
    example: "The supplier has already been contacted and the ETA is still pending.",
  },
  {
    number: "06",
    title: "Important limits",
    text:
      "Include boundaries that prevent AI from making unsupported assumptions or giving unusable advice.",
    example: "Do not offer a refund unless the customer requests cancellation.",
  },
];

const contextFilter = [
  {
    label: "KEEP",
    text: "Facts that change the answer.",
  },
  {
    label: "KEEP",
    text: "Requirements the output must follow.",
  },
  {
    label: "KEEP",
    text: "Previous actions that affect the next step.",
  },
  {
    label: "REMOVE",
    text: "Background details that do not influence the task.",
  },
  {
    label: "REMOVE",
    text: "Repeated information already stated clearly.",
  },
  {
    label: "REMOVE",
    text: "Sensitive information that AI does not need.",
  },
];

const checklist = [
  "What is happening?",
  "What result am I trying to achieve?",
  "Which facts actually affect the answer?",
  "What has already happened?",
  "Who will use the output?",
  "What should AI avoid assuming?",
];
---

<BaseLayout
  title="How to Give AI Better Context | KRIYANO"
  description="Learn how to give AI useful context without overloading your prompt, using practical workplace examples and a simple context framework."
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>PROMPTING FUNDAMENTALS</span>
            <span>06</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            How to Give AI
            <span>Better Context.</span>
          </h1>

          <p class="article-intro">
            Context helps AI understand the situation behind your request.
            The goal is not to provide everything you know. It is to provide
            the information that meaningfully changes the answer.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 06</span>
            <span>PROMPTING FUNDAMENTALS</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">THE CONTEXT RULE</span>

            <strong>
              Give AI what it needs to know, not everything you know.
            </strong>

            <p>
              Useful context reduces assumptions. Too much irrelevant context
              can make a prompt harder to follow.
            </p>
          </div>

          <div class="panel-footer">
            <span>RELEVANT → SPECIFIC → NECESSARY</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#why-context">Why context matters</a>
            <a href="#types">Six useful types of context</a>
            <a href="#comparison">Weak vs better context</a>
            <a href="#filter">What to include and remove</a>
            <a href="#work-example">A real-work example</a>
            <a href="#checklist">Context checklist</a>
            <a href="#takeaway">The practical takeaway</a>
          </div>
        </aside>

        <main class="article-content">
          <section id="why-context">
            <div class="section-marker">01 / THE CORE IDEA</div>

            <h2>AI cannot see the situation you are thinking about.</h2>

            <p>
              You may already know the customer history, the warehouse problem,
              the previous email, the deadline or the reason a decision matters.
              AI does not know any of that unless you provide it.
            </p>

            <p>
              Without enough context, the model fills gaps using patterns and
              assumptions. That can produce an answer that sounds reasonable but
              does not fit the real situation.
            </p>

            <div class="concept-box">
              <span>CONTEXT IS NOT</span>

              <p>
                A long background story. Good context is the minimum useful
                information AI needs to understand the task correctly.
              </p>
            </div>
          </section>

          <section id="types">
            <div class="section-marker">02 / USEFUL CONTEXT</div>

            <h2>Six types of context that often improve AI output.</h2>

            <p>
              You will not need all six every time. Use the ones that reduce
              uncertainty in the task.
            </p>

            <div class="parts-grid">
              {
                contextTypes.map((item) => (
                  <article class="part-card">
                    <span class="part-number">{item.number}</span>

                    <h3>{item.title}</h3>

                    <p>{item.text}</p>

                    <div class="part-example">
                      <span>EXAMPLE</span>
                      <p>{item.example}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="comparison">
            <div class="section-marker">03 / BEFORE & AFTER</div>

            <h2>Better context can change the usefulness of the answer.</h2>

            <div class="prompt-comparison">
              <div class="prompt-card weak">
                <span>WEAK CONTEXT</span>

                <p>
                  Write an email to a customer about a delayed order.
                </p>
              </div>

              <div class="prompt-card stronger">
                <span>BETTER CONTEXT</span>

                <p>
                  Draft a professional email to a retail customer whose order
                  is delayed because one item is temporarily out of stock. The
                  supplier has been contacted, but the revised delivery date is
                  not yet confirmed. Reassure the customer that the order is
                  being followed up. Do not promise a delivery date until it is
                  confirmed.
                </p>
              </div>
            </div>

            <p>
              The second prompt gives AI enough information to avoid inventing a
              delivery date or suggesting actions that do not match the actual
              situation.
            </p>
          </section>

          <section id="filter">
            <div class="section-marker">04 / CONTEXT FILTER</div>

            <h2>More context is not always better context.</h2>

            <p>
              A useful prompt gives AI the information that affects the answer
              and removes information that only adds noise.
            </p>

            <div class="filter-grid">
              {
                contextFilter.map((item) => (
                  <div class={`filter-card ${item.label.toLowerCase()}`}>
                    <span>{item.label}</span>
                    <p>{item.text}</p>
                  </div>
                ))
              }
            </div>

            <div class="decision-box">
              <span>ASK YOURSELF</span>

              <p>
                If I remove this detail, would AI still understand the task and
                produce the same quality of answer? If yes, the detail may not
                be necessary.
              </p>
            </div>
          </section>

          <section id="work-example">
            <div class="section-marker">05 / REAL-WORK EXAMPLE</div>

            <h2>Context is especially important when the situation has already evolved.</h2>

            <p>
              Imagine you are investigating an inventory shortage and want AI
              to help prepare the next action plan.
            </p>

            <div class="work-flow">
              <div class="flow-row">
                <span>01</span>
                <div>
                  <strong>Current situation</strong>
                  <p>
                    System stock shows 1,250 units. Physical count shows 1,226
                    units.
                  </p>
                </div>
              </div>

              <div class="flow-row">
                <span>02</span>
                <div>
                  <strong>Checks already completed</strong>
                  <p>
                    The physical count was repeated. Recent receiving and
                    outbound transactions were checked.
                  </p>
                </div>
              </div>

              <div class="flow-row">
                <span>03</span>
                <div>
                  <strong>What is still unknown</strong>
                  <p>
                    The reason for the 24-unit difference has not yet been
                    confirmed.
                  </p>
                </div>
              </div>

              <div class="flow-row">
                <span>04</span>
                <div>
                  <strong>Goal</strong>
                  <p>
                    Identify practical next checks without assuming the cause.
                  </p>
                </div>
              </div>

              <div class="flow-row">
                <span>05</span>
                <div>
                  <strong>Constraint</strong>
                  <p>
                    Recommendations must be based only on the information
                    provided.
                  </p>
                </div>
              </div>
            </div>

            <div class="assembled-prompt">
              <span>ASSEMBLED PROMPT</span>

              <p>
                Act as an inventory control supervisor. System stock shows
                1,250 units, while two verified physical counts show 1,226
                units. Recent receiving and outbound transactions have already
                been checked, but the reason for the 24-unit variance has not
                been confirmed. Suggest the next practical investigation steps
                in priority order. Do not assume or invent a root cause. Base
                the recommendations only on the information provided.
              </p>
            </div>
          </section>

          <section id="checklist">
            <div class="section-marker">06 / QUICK CHECK</div>

            <h2>Use these questions before adding more background.</h2>

            <div class="checklist">
              {
                checklist.map((item, index) => (
                  <div class="check-row">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <p>{item}</p>
                    <strong>✓</strong>
                  </div>
                ))
              }
            </div>

            <div class="privacy-box">
              <span>IMPORTANT</span>

              <p>
                Context should be useful, but it should also be appropriate to
                share. Avoid including confidential, personal or sensitive
                information when AI does not need it to complete the task.
              </p>
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">07 / PRACTICAL TAKEAWAY</div>

            <h2>Good context gives AI a clearer view of the real problem.</h2>

            <p>
              Start with the situation. Add the facts that change the answer.
              Include what has already happened, then define what AI should help
              you do next.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Situation</strong>
                <p>What is happening now?</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Facts</strong>
                <p>What actually matters?</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>History</strong>
                <p>What has already happened?</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Goal</strong>
                <p>What should happen next?</p>
              </div>
            </div>

            <div class="tool-callout">
              <div>
                <span class="tool-kicker">TRY IT IN KRIYANO</span>

                <h3>Add useful context to your next prompt.</h3>

                <p>
                  The KRIYANO Prompt Builder gives you a dedicated context field
                  so you can separate background information from the task,
                  audience and output requirements.
                </p>
              </div>

              <a href="/tools/prompt-builder/" class="button button-primary">
                Open Prompt Builder
              </a>
            </div>
          </section>

          <section class="next-lesson">
            <div>
              <span class="next-label">NEXT LESSON</span>

              <h2>Using Roles, Constraints & Examples</h2>

              <p>
                Learn when these prompt controls improve a response, when they
                are unnecessary, and how to use them without overcomplicating
                your instructions.
              </p>
            </div>

            <a
  href="/learn/prompting-fundamentals/using-roles-constraints-and-examples/"
  class="next-status"
>
  CONTINUE →
</a>
          </section>
        </main>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
