 .next-status {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

a.next-status:hover {
  color: var(--lime);
  transform: translateX(4px);
}



  @media (max-width: 1000px) {
    .article-hero-grid,
    .article-layout {
