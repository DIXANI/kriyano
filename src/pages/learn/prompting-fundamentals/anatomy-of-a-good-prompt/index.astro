  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 28px;
  }

  .article-meta span {
    padding: 7px 9px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--muted);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .article-heading h1 {
    max-width: 900px;
    margin-top: 22px;
    font-size: clamp(3.5rem, 7vw, 6.6rem);
    line-height: 0.94;
    letter-spacing: -0.065em;
  }

  .article-heading h1 span {
    display: block;
    color: var(--lime);
  }

  .article-intro {
    max-width: 760px;
    margin-top: 27px;
    color: var(--muted);
    font-size: 1.04rem;
    line-height: 1.8;
  }

  .lesson-panel {
    overflow: hidden;
