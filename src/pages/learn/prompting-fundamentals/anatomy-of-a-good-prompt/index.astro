    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .sidebar-box a:hover {
    color: var(--lime);
  }

  .article-content > section:not(:first-child) {
    margin-top: 90px;
  }

  .section-marker {
    color: var(--lime);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .article-content h2 {
    max-width: 760px;
    margin-top: 14px;
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.052em;
  }

  .article-content > section > p {
    max-width: 760px;
    margin-top: 23px;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.85;
  }

  .concept-box,
  .decision-box {
    margin: 34px 0;
    padding: 27px;
    border: 1px solid rgba(183, 255, 74, 0.18);
    border-radius: 16px;
    background: rgba(183, 255, 74, 0.035);
  }

  .concept-box span,
  .decision-box span {
    color: var(--lime);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .concept-box p,
  .decision-box p {
    margin-top: 12px;
    font-size: 1.02rem;
    line-height: 1.7;
  }

