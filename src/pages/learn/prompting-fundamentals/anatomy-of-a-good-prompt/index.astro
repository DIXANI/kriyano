  .tool-callout {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 35px;
    margin-top: 40px;
    padding: 32px;
    border: 1px solid rgba(183, 255, 74, 0.18);
    border-radius: 19px;
    background:
      linear-gradient(
        145deg,
        rgba(183, 255, 74, 0.04),
        transparent 50%
      ),
      var(--surface);
  }

  .tool-kicker,
  .next-label {
    color: var(--lime);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .tool-callout h3 {
    margin-top: 11px;
    font-size: 1.35rem;
  }

  .tool-callout p {
    max-width: 510px;
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.65;
  }

  .tool-callout .button {
    flex-shrink: 0;
  }

  .next-lesson {
