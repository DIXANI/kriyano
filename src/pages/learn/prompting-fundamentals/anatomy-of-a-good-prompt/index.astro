    border-radius: 12px;
  }

  .breakdown span {
    color: var(--lime);
    font-size: 0.56rem;
    font-weight: 800;
  }

  .breakdown p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1.5;
  }

  .work-flow {
    margin-top: 35px;
    border-top: 1px solid var(--line);
  }

  .flow-row {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 15px;
    padding: 19px 0;
    border-bottom: 1px solid var(--line);
  }

  .flow-row > span {
    color: var(--lime);
    font-size: 0.62rem;
    font-weight: 800;
  }

  .flow-row strong {
    font-size: 0.84rem;
  }

  .flow-row p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .assembled-prompt {
    margin-top: 28px;
    padding: 27px;
    border: 1px solid rgba(183, 255, 74, 0.19);
    border-radius: 16px;
    background: rgba(183, 255, 74, 0.035);
  }

  .assembled-prompt span {
    color: var(--lime);
    font-size: 0.59rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .assembled-prompt p {
    margin-top: 13px;
    font-size: 0.91rem;
    line-height: 1.8;
