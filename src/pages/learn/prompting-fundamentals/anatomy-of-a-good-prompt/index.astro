    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-top: 35px;
  }

  .part-card {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }

  .part-number {
    color: var(--lime);
    font-size: 0.63rem;
    font-weight: 800;
  }

  .part-card h3 {
    margin-top: 30px;
    font-size: 1.08rem;
  }

  .part-card > p {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .part-example {
    margin-top: 19px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .part-example span {
    color: var(--mint);
    font-size: 0.57rem;
    font-weight: 800;
  }

  .part-example p {
    margin-top: 7px;
    font-size: 0.7rem;
    line-height: 1.55;
  }

  .prompt-comparison {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 14px;
    margin-top: 35px;
  }

