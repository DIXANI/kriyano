---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const strengths = [
  {
    number: "01",
    title: "Drafting & rewriting",
    text:
      "AI is useful for creating first drafts, improving clarity, changing tone, shortening text and restructuring existing writing.",
    examples: "Emails · Reports · Proposals · Instructions · Social content",
  },
  {
    number: "02",
    title: "Summarising information",
    text:
      "AI can reduce long notes or documents into key points, action items, structured summaries or information for a specific audience.",
    examples: "Meeting notes · Documents · Policies · Research notes",
  },
  {
    number: "03",
    title: "Organising & structuring",
    text:
      "Unstructured information can often be converted into tables, categories, checklists, plans or step-by-step formats.",
    examples: "Checklists · SOP drafts · Plans · Tables · Task lists",
  },
  {
    number: "04",
    title: "Brainstorming",
    text:
      "AI can quickly generate alternatives, questions, angles and possible approaches when you need a starting point.",
    examples: "Ideas · Names · Topics · Approaches · Questions",
  },
  {
    number: "05",
    title: "Explaining & learning",
    text:
      "AI can explain unfamiliar concepts, provide examples and adapt an explanation to different levels of knowledge.",
    examples: "Concepts · Examples · Practice · Comparisons",
  },
  {
    number: "06",
    title: "Transforming information",
    text:
      "AI is particularly useful when the information already exists but needs to be converted into another useful form.",
    examples: "Notes → Email · Data → Summary · Outline → Draft",
  },
];

const suitabilityQuestions = [
  "Can I clearly describe the task?",
  "Can I provide the information AI needs?",
  "Can a human review the result?",
  "Would a useful first draft save meaningful time?",
  "Can errors be detected before they cause a problem?",
];

const poorFits = [
  {
    title: "Unverified critical decisions",
    text:
      "Do not treat an AI response as the final authority for decisions where an error could have serious financial, legal, medical, safety or operational consequences.",
  },
  {
    title: "Tasks requiring unavailable facts",
    text:
      "AI cannot reliably work with information it does not have. Current prices, live inventory, internal company records or recent events may require connected or verified data sources.",
  },
  {
    title: "Confidential information without approval",
    text:
      "A task may technically be suitable for AI but still be inappropriate if it requires entering confidential, personal or restricted company information into an unapproved service.",
  },
  {
    title: "Automatic action without review",
    text:
      "When mistakes could affect customers, inventory, money, compliance or operations, generating the output and approving the action should usually be treated as separate steps.",
  },
];
---

<BaseLayout
  title="What AI Is Good At | KRIYANO"
  description="Learn which tasks generative AI handles well, where it provides practical value at work, and how to decide whether AI is suitable for a task."
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>AI FUNDAMENTALS</span>
            <span>02</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            What AI Is
            <span>Good At.</span>
          </h1>

          <p class="article-intro">
            AI becomes much more useful when you give it the right kind of work.
            Some tasks match its strengths extremely well. Others require
            information, judgment or responsibility that should remain with
            people and reliable systems.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 02</span>
            <span>AI FUNDAMENTALS</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">THE PRACTICAL RULE</span>

            <strong>
              Use AI where generating, transforming or organising information
              creates value.
            </strong>

            <p>
              Tasks become particularly suitable when you can provide clear
              context and review the result before it is used.
            </p>
          </div>

          <div class="panel-footer">
            <span>CHOOSE → GENERATE → REVIEW</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#right-task">Start with the right task</a>
            <a href="#strengths">Six useful strengths</a>
            <a href="#work-example">A real-work example</a>
            <a href="#suitability">Should you use AI?</a>
            <a href="#poor-fit">Where AI is a poor fit</a>
            <a href="#takeaway">The practical takeaway</a>
          </div>
        </aside>

        <main class="article-content">
          <section id="right-task">
            <div class="section-marker">01 / THE RIGHT TASK</div>

            <h2>AI does not need to do the whole job to be useful.</h2>

            <p>
              A common mistake is asking whether AI can replace an entire task
              or role. A more useful question is whether part of the work can be
              completed faster or more effectively with AI assistance.
            </p>

            <p>
              Consider preparing a monthly operations report. Gathering the
              correct figures, investigating unusual results and deciding what
              action to take may require employees who understand the operation.
              But turning verified notes and figures into a clear first draft
              can be a strong AI task.
            </p>

            <div class="concept-box">
              <span>LOOK FOR THE ASSISTABLE STEP</span>

              <p>
                Instead of asking, “Can AI do this job?”, ask, “Which part of
                this job involves drafting, summarising, organising, comparing
                or transforming information?”
              </p>
            </div>
          </section>

          <section id="strengths">
            <div class="section-marker">02 / AI STRENGTHS</div>

            <h2>Six areas where generative AI can be particularly useful.</h2>

            <p>
              These categories appear across many professions because they deal
              primarily with language, information and structure.
            </p>

            <div class="strength-grid">
              {
                strengths.map((item) => (
                  <article class="strength-card">
                    <span class="strength-number">{item.number}</span>

                    <h3>{item.title}</h3>

                    <p>{item.text}</p>

                    <div class="examples">{item.examples}</div>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="work-example">
            <div class="section-marker">03 / REAL-WORK EXAMPLE</div>

            <h2>Use AI around the evidence—not instead of the evidence.</h2>

            <p>
              Imagine a warehouse team discovers that physical stock is 24
              units lower than the quantity shown in the inventory system.
            </p>

            <div class="workflow">
              <div class="workflow-row human">
                <span>01</span>

                <div>
                  <strong>Human / system work</strong>
                  <p>
                    Recount the stock and confirm the physical discrepancy.
                  </p>
                </div>
              </div>

              <div class="workflow-row human">
                <span>02</span>

                <div>
                  <strong>Human / system work</strong>
                  <p>
                    Review receiving, picking, dispatch, transfer and adjustment
                    transactions.
                  </p>
                </div>
              </div>

              <div class="workflow-row ai">
                <span>03</span>

                <div>
                  <strong>Good AI assistance</strong>
                  <p>
                    Organise the verified investigation notes into a structured
                    discrepancy summary.
                  </p>
                </div>
              </div>

              <div class="workflow-row ai">
                <span>04</span>

                <div>
                  <strong>Good AI assistance</strong>
                  <p>
                    Draft a concise email explaining the issue, checks completed
                    and next action required.
                  </p>
                </div>
              </div>

              <div class="workflow-row human">
                <span>05</span>

                <div>
                  <strong>Human decision</strong>
                  <p>
                    Review the evidence and approve any inventory adjustment
                    according to company procedure.
                  </p>
                </div>
              </div>
            </div>

            <p>
              AI provides value here without becoming the source of truth. The
              inventory records and physical investigation provide the facts;
              AI helps transform those facts into useful communication and
              structure.
            </p>
          </section>

          <section id="suitability">
            <div class="section-marker">04 / TASK CHECK</div>

            <h2>Five questions before giving a task to AI.</h2>

            <p>
              You do not need a complicated assessment for everyday work. A few
              simple questions can quickly indicate whether AI is likely to
              help.
            </p>

            <div class="question-list">
              {
                suitabilityQuestions.map((question, index) => (
                  <div class="question-row">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <p>{question}</p>
                    <strong>?</strong>
                  </div>
                ))
              }
            </div>

            <div class="decision-box">
              <span>GOOD SIGNAL</span>

              <p>
                If the task can be clearly explained, the necessary context can
                be supplied, and someone can review the result before it matters,
                AI is often worth testing.
              </p>
            </div>
          </section>

          <section id="poor-fit">
            <div class="section-marker">05 / KNOW THE LIMITS</div>

            <h2>Some tasks need more than a plausible answer.</h2>

            <p>
              The fact that AI can generate an answer does not automatically
              make AI the right tool for the task.
            </p>

            <div class="poor-fit-grid">
              {
                poorFits.map((item, index) => (
                  <article class="poor-fit-card">
                    <span>{String(index + 1).padStart(2, "0")}</span>

                    <h3>{item.title}</h3>

                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">06 / PRACTICAL TAKEAWAY</div>

            <h2>Start with tasks where review is easy and value is clear.</h2>

            <p>
              You do not need to automate an entire workflow on your first
              attempt. Start with a task you already understand well and use AI
              for one assistable step.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Choose</strong>
                <p>Pick a clear, manageable task.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Provide</strong>
                <p>Give the relevant context.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>Generate</strong>
                <p>Use AI for the assistable step.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Review</strong>
                <p>Check before using the result.</p>
              </div>
            </div>

            <div class="tool-callout">
              <div>
                <span class="tool-kicker">TRY IT WITH KRIYANO</span>

                <h3>Turn your task into a clearer AI instruction.</h3>

                <p>
                  Define what you need, add context and specify the expected
                  output using the KRIYANO Prompt Builder.
                </p>
              </div>

              <a href="/tools/prompt-builder/" class="button button-primary">
                Open Prompt Builder
              </a>
            </div>
          </section>

          <section class="next-lesson">
            <div>
              <span class="next-label">NEXT LESSON</span>

              <h2>Where AI Can Go Wrong</h2>

              <p>
                Learn why AI can produce incorrect, misleading or unsuitable
                results—and what you can do about it.
              </p>
            </div>

            <a
  href="/learn/ai-fundamentals/where-ai-can-go-wrong/"
  class="next-status"
>
  CONTINUE →
</a>
          </section>
        </main>
      </div>
    </section>
  </article>
</BaseLayout>

