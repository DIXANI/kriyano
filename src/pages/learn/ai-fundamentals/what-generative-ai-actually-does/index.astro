---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { createLearnSchema } from "../../../../utils/learnSchema";

const articleTitle = "What Generative AI Actually Does | KRIYANO";

const articleDescription =
  "Learn what generative AI actually does, how it creates responses from learned patterns, why it can make mistakes and where human review remains important.";

const schema = createLearnSchema({
  title: "What Generative AI Actually Does",
  description: articleDescription,
  pathName: "AI Fundamentals",
  pathSlug: "ai-fundamentals",
  articleSlug: "what-generative-ai-actually-does",
});
const takeaways = [
  "Generative AI predicts and creates output from patterns learned during training.",
  "It does not understand information in exactly the same way a person does.",
  "It can produce useful work while still making confident mistakes.",
  "The quality of the result depends heavily on the task, context and instructions you provide.",
  "Human review remains important whenever accuracy, judgment or consequences matter.",
];

const examples = [
  {
    task: "Writing",
    input: "Draft a professional follow-up email after a supplier meeting.",
    output:
      "AI can generate a structured email using patterns from professional business communication.",
  },
  {
    task: "Analysis",
    input: "Summarise these stock discrepancy notes and identify possible investigation areas.",
    output:
      "AI can organise the supplied information, highlight patterns and suggest areas to review.",
  },
  {
    task: "Brainstorming",
    input: "Give me ten practical ways a small business could reduce repetitive admin work.",
    output:
      "AI can generate possible approaches by combining patterns and ideas related to the request.",
  },
];

const limitations = [
  {
    title: "It can sound certain when it is wrong",
    text:
      "Generative AI is designed to produce plausible responses. A fluent, confident answer is not proof that the information is correct.",
  },
  {
    title: "It does not automatically know your situation",
    text:
      "If important context is missing, the model may make assumptions. Giving clear background information usually improves the usefulness of the result.",
  },
  {
    title: "It may not have current information",
    text:
      "Depending on the AI service and the tools available to it, the model may not automatically know what happened today or have access to live information.",
  },
  {
    title: "It cannot replace responsibility",
    text:
      "AI can assist with thinking, drafting and analysis, but important workplace, financial, legal, safety or operational decisions still require appropriate human judgment.",
  },
];
---

<BaseLayout
  title={articleTitle}
  description={articleDescription}
  schema={schema}
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>AI FUNDAMENTALS</span>
            <span>01</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            What Generative AI
            <span>Actually Does.</span>
          </h1>

          <p class="article-intro">
            Generative AI can write emails, summarise documents, create images,
            analyse information and help structure ideas. But understanding what
            is happening behind the interface makes it much easier to use AI
            effectively—and to recognise when you should not trust the first
            answer you receive.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 01</span>
            <span>AI FUNDAMENTALS</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">THE SIMPLE IDEA</span>

            <strong>
              Generative AI creates new output by recognising and continuing
              patterns.
            </strong>

            <p>
              It does not retrieve a perfect answer from a hidden database.
              Instead, it generates a response based on patterns learned during
              training and the information available in your current request.
            </p>
          </div>

          <div class="panel-footer">
            <span>READ → UNDERSTAND → APPLY</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#simple-explanation">The simple explanation</a>
            <a href="#prediction">Prediction, not human thinking</a>
            <a href="#examples">Practical examples</a>
            <a href="#limitations">Where problems appear</a>
            <a href="#working-with-ai">How to work with AI</a>
            <a href="#takeaways">Key takeaways</a>
          </div>
        </aside>

        <article class="article-content">
          <section id="simple-explanation">
            <div class="section-marker">01 / THE SIMPLE EXPLANATION</div>

            <h2>Generative AI creates rather than simply looks up.</h2>

            <p>
              Traditional software usually follows predefined instructions. A
              calculator performs a mathematical operation. A database returns a
              stored record. A warehouse management system updates inventory
              according to transactions recorded in the system.
            </p>

            <p>
              Generative AI works differently. You provide an instruction,
              question or piece of information, and the model generates a new
              response that fits the patterns it learned during training.
            </p>

            <div class="concept-box">
              <span>THINK OF IT THIS WAY</span>

              <p>
                You give the model a task and some context. It evaluates what
                kind of response is likely to fit that request, then generates
                the output step by step.
              </p>
            </div>

            <p>
              This is why the same AI system can help draft an email, explain a
              business concept, reorganise notes, generate code or suggest ideas.
              The underlying system is not limited to one fixed workflow.
            </p>
          </section>

          <section id="prediction">
            <div class="section-marker">02 / PREDICTION</div>

            <h2>AI prediction is not the same as human understanding.</h2>

            <p>
              When a language model writes a response, it is effectively
              predicting what pieces of language should come next given the
              request and everything generated so far.
            </p>

            <p>
              Modern AI models are extremely sophisticated, so that simple idea
              can produce surprisingly capable behaviour. They can identify
              relationships, follow instructions, transform information and
              produce useful reasoning-like outputs.
            </p>

            <p>
              But the distinction still matters. An AI response may look
              knowledgeable without the model having human experience,
              responsibility or real-world awareness behind the words.
            </p>

            <div class="comparison">
              <div class="comparison-column">
                <span class="comparison-label">HUMAN</span>

                <h3>Understands through experience</h3>

                <p>
                  People combine knowledge with lived experience, goals,
                  situational awareness, values and responsibility for decisions.
                </p>
              </div>

              <div class="comparison-column highlighted">
                <span class="comparison-label">GENERATIVE AI</span>

                <h3>Generates through learned patterns</h3>

                <p>
                  AI processes the available information and generates an output
                  that statistically and structurally fits the request.
                </p>
              </div>
            </div>
          </section>

          <section id="examples">
            <div class="section-marker">03 / PRACTICAL EXAMPLES</div>

            <h2>What this looks like during real work.</h2>

            <p>
              The easiest way to understand generative AI is to look at what
              happens when you give it different kinds of tasks.
            </p>

            <div class="example-stack">
              {
                examples.map((example, index) => (
                  <article class="example-card">
                    <div class="example-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div class="example-body">
                      <span>{example.task}</span>

                      <h3>{example.input}</h3>

                      <p>{example.output}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <p>
              In each case, the model is generating an answer from the
              instruction and available context. It is not automatically
              checking whether every statement is correct or whether the final
              result is suitable for your exact organisation.
            </p>
          </section>

          <section id="limitations">
            <div class="section-marker">04 / LIMITATIONS</div>

            <h2>Why useful AI can still produce bad answers.</h2>

            <p>
              Generative AI's ability to create plausible output is both its
              strength and one of its main weaknesses. The system is trying to
              produce an appropriate response—not guarantee that every sentence
              represents verified reality.
            </p>

            <div class="limitation-grid">
              {
                limitations.map((item, index) => (
                  <article class="limitation-card">
                    <span>{String(index + 1).padStart(2, "0")}</span>

                    <h3>{item.title}</h3>

                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="working-with-ai">
            <div class="section-marker">05 / WORKING WITH AI</div>

            <h2>Treat AI as a capable assistant, not an automatic authority.</h2>

            <p>
              A practical approach is to give AI a clearly defined task, provide
              the relevant context, describe the result you want, add important
              constraints and then review the output before using it.
            </p>

            <div class="workflow-box">
              <div>
                <span>01</span>
                <strong>Define</strong>
                <p>What exactly are you trying to accomplish?</p>
              </div>

              <div class="workflow-arrow">→</div>

              <div>
                <span>02</span>
                <strong>Context</strong>
                <p>What information does the model need?</p>
              </div>

              <div class="workflow-arrow">→</div>

              <div>
                <span>03</span>
                <strong>Generate</strong>
                <p>Ask AI to produce the required result.</p>
              </div>

              <div class="workflow-arrow">→</div>

              <div>
                <span>04</span>
                <strong>Review</strong>
                <p>Check accuracy, suitability and missing details.</p>
              </div>
            </div>

            <p>
              This approach is especially useful in professional work. For
              example, AI may help organise an inventory discrepancy
              investigation, but the physical count, system transactions,
              receiving records and stock adjustments still need to be checked
              against real evidence before a decision is made.
            </p>

            <div class="tool-callout">
              <div>
                <span class="tool-kicker">KRIYANO TOOL</span>

                <h3>Turn a real task into a structured prompt.</h3>

                <p>
                  The KRIYANO Prompt Builder helps you define the task, context,
                  output, constraints and other details before sending the
                  request to an AI assistant.
                </p>
              </div>

              <a href="/tools/prompt-builder/" class="button button-primary">
                Open Prompt Builder
              </a>
            </div>
          </section>

          <section id="takeaways">
            <div class="section-marker">06 / KEY TAKEAWAYS</div>

            <h2>What to remember from this lesson.</h2>

            <div class="takeaway-list">
              {
                takeaways.map((item, index) => (
                  <div class="takeaway-row">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <p>{item}</p>
                  </div>
                ))
              }
            </div>
          </section>

          <section class="next-lesson">
  <div>
    <span class="next-label">NEXT LESSON</span>

    <h2>What AI Is Good At</h2>

    <p>
      Learn which tasks are particularly suitable for generative AI
      and where it can provide the most practical value.
    </p>
  </div>

  <a
    href="/learn/ai-fundamentals/what-ai-is-good-at/"
    class="next-status"
  >
    CONTINUE →
  </a>
</section>
        </article>
      </div>
    </section>
  </article>
</BaseLayout>

