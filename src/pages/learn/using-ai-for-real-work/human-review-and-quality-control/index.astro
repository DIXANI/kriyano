---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { createLearnSchema } from "../../../../utils/learnSchema";

const articleTitle = "Human Review & Quality Control | KRIYANO";

const articleDescription =
  "Learn how to review AI-generated work by checking facts, accuracy, completeness, relevance and quality before using the output in real work.";

const schema = createLearnSchema({
  title: "Human Review & Quality Control",
  description: articleDescription,
  pathName: "Using AI for Real Work",
  pathSlug: "using-ai-for-real-work",
  articleSlug: "human-review-and-quality-control",
});
const reviewChecks = [
  {
    number: "01",
    title: "Facts",
    text:
      "Check names, dates, quantities, references, calculations and other factual details against the source information.",
  },
  {
    number: "02",
    title: "Completeness",
    text:
      "Confirm that important context, requirements, exceptions and unresolved points have not been omitted.",
  },
  {
    number: "03",
    title: "Assumptions",
    text:
      "Identify anything AI has inferred or invented that is not directly supported by the available evidence.",
  },
  {
    number: "04",
    title: "Logic",
    text:
      "Check whether the conclusion actually follows from the facts and whether any important reasoning step is missing.",
  },
  {
    number: "05",
    title: "Communication",
    text:
      "Review tone, wording, audience, clarity and whether the result could be misunderstood.",
  },
  {
    number: "06",
    title: "Authority",
    text:
      "Confirm whether the output is only a draft or recommendation, and who has responsibility for the final decision or action.",
  },
];

const reviewLevels = [
  {
    level: "LIGHT REVIEW",
    use: "Low-risk internal drafts",
    examples:
      "Simple rewriting, brainstorming, formatting and non-critical internal content.",
    control:
      "Quick human check for clarity, obvious errors and suitability before use.",
  },
  {
    level: "STRUCTURED REVIEW",
    use: "Operational and external work",
    examples:
      "Reports, customer or supplier communication, analysis summaries and recommendations.",
    control:
      "Verify key facts, source information, assumptions, format and required actions.",
  },
  {
    level: "EXPERT / AUTHORISED REVIEW",
    use: "Higher-consequence work",
    examples:
      "Important financial, safety, legal, employment or operational decisions.",
    control:
      "Use qualified human expertise, organisational controls and formal approval where required.",
  },
];

const warehouseChecks = [
  {
    stage: "SOURCE",
    title: "Verify the quantities",
    text:
      "System stock is 2,160 units and two physical counts confirm 2,131 units. The verified difference is 29 units.",
  },
  {
    stage: "EVIDENCE",
    title: "Separate completed checks from assumptions",
    text:
      "Receiving, outbound movements and adjustment records were reviewed. The information available does not yet confirm the root cause.",
  },
  {
    stage: "AI OUTPUT",
    title: "Check what the model added",
    text:
      "If the draft says the shortage was caused by a missed dispatch posting, remove or rewrite that statement unless the records prove it.",
  },
  {
    stage: "COMMUNICATION",
    title: "Review the management summary",
    text:
      "Make sure the report clearly distinguishes verified facts, investigation completed, unresolved issues and recommended next checks.",
  },
  {
    stage: "APPROVAL",
    title: "Keep the final decision with the authorised person",
    text:
      "Any inventory adjustment, escalation or corrective action should follow the organisation's approval process.",
  },
];

const redFlags = [
  "A very specific claim with no visible source",
  "A confident explanation for an unresolved issue",
  "Numbers that were calculated without being checked",
  "Important facts missing from the original input",
  "A recommendation presented as if it were an approved decision",
  "Wording that changes the meaning of the source information",
];

const finalQuestions = [
  "What information did the AI use?",
  "Which statements can I verify directly?",
  "What did the AI infer?",
  "What could happen if this output is wrong?",
  "Who must review or approve it?",
  "Is this ready to use, or only ready for the next step?",
];
---

<BaseLayout
  title={articleTitle}
  description={articleDescription}
  schema={schema}
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>USING AI FOR REAL WORK</span>
            <span>11</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            Human Review &amp;
            <span>Quality Control.</span>
          </h1>

          <p class="article-intro">
            AI can produce useful work quickly, but speed and confidence are
            not the same as accuracy. Before AI output becomes part of a real
            document, decision or action, someone needs to check what is true,
            what is missing and what still requires human judgment.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 11</span>
            <span>USING AI FOR REAL WORK</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">REVIEW BEFORE USE</span>

            <strong>
              Treat AI output as work to inspect, not work to automatically trust.
            </strong>

            <p>
              Good quality control checks both the content itself and whether
              the output is appropriate for the decision or action that follows.
            </p>
          </div>

          <div class="panel-footer">
            <span>VERIFY → QUESTION → APPROVE</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#why-review">Why review matters</a>
            <a href="#six-checks">Six review checks</a>
            <a href="#review-levels">Match review to risk</a>
            <a href="#red-flags">Common red flags</a>
            <a href="#warehouse">Warehouse example</a>
            <a href="#final-check">Final review questions</a>
            <a href="#takeaway">The practical takeaway</a>
          </div>
        </aside>

        <article class="article-content">
          <section id="why-review">
            <div class="section-marker">01 / WHY REVIEW MATTERS</div>

            <h2>AI can sound finished before the work is actually finished.</h2>

            <p>
              A response can be grammatically strong, well structured and
              convincing while still containing a wrong number, missing fact,
              unsupported assumption or unsuitable recommendation.
            </p>

            <p>
              That is why workplace AI should usually be treated as an
              intermediate output: something that helps move the task forward,
              but still needs the level of human checking appropriate to the
              situation.
            </p>

            <div class="concept-box">
              <span>QUALITY CONTROL PRINCIPLE</span>
              <p>
                The better the output looks, the easier it can be to overlook
                hidden errors. Review the evidence, not just the presentation.
              </p>
            </div>
          </section>

          <section id="six-checks">
            <div class="section-marker">02 / SIX REVIEW CHECKS</div>

            <h2>Use a repeatable review instead of relying on a quick glance.</h2>

            <div class="check-grid">
              {
                reviewChecks.map((item) => (
                  <article class="check-card">
                    <span>{item.number}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>

            <div class="review-formula">
              <span>REVIEW FRAMEWORK</span>

              <div>
                <strong>Facts</strong>
                <span>→</span>
                <strong>Completeness</strong>
                <span>→</span>
                <strong>Assumptions</strong>
                <span>→</span>
                <strong>Logic</strong>
                <span>→</span>
                <strong>Communication</strong>
                <span>→</span>
                <strong>Authority</strong>
              </div>
            </div>
          </section>

          <section id="review-levels">
            <div class="section-marker">03 / REVIEW LEVELS</div>

            <h2>Not every AI output needs the same amount of checking.</h2>

            <p>
              Review effort should increase with the consequence of being
              wrong. A low-risk draft and a decision affecting money or
              operations should not be treated the same way.
            </p>

            <div class="level-stack">
              {
                reviewLevels.map((item, index) => (
                  <article class="level-card">
                    <div class="level-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div class="level-main">
                      <span>{item.level}</span>
                      <h3>{item.use}</h3>
                    </div>

                    <div>
                      <span>EXAMPLES</span>
                      <p>{item.examples}</p>
                    </div>

                    <div>
                      <span>CONTROL</span>
                      <p>{item.control}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="warning-box">
              <span>DO NOT CONFUSE REVIEW WITH APPROVAL</span>
              <p>
                A person may verify that an AI-generated document is accurate
                without having authority to approve the business action
                described in that document.
              </p>
            </div>
          </section>

          <section id="red-flags">
            <div class="section-marker">04 / RED FLAGS</div>

            <h2>Some signals should trigger a closer review.</h2>

            <div class="red-flag-list">
              {
                redFlags.map((item, index) => (
                  <div class="red-flag-row">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{item}</strong>
                  </div>
                ))
              }
            </div>

            <div class="concept-box">
              <span>USEFUL HABIT</span>
              <p>
                When AI makes a statement that matters, ask yourself:
                “What evidence would I need to confirm this without the AI?”
              </p>
            </div>
          </section>

          <section id="warehouse">
            <div class="section-marker">05 / REAL-WORK EXAMPLE</div>

            <h2>Review an AI-generated stock discrepancy summary.</h2>

            <p>
              Imagine a warehouse system shows 2,160 units while two physical
              counts confirm 2,131 units. The verified difference is 29 units.
              AI is asked to draft a management summary from the investigation
              notes.
            </p>

            <div class="warehouse-review">
              {
                warehouseChecks.map((item, index) => (
                  <article class="warehouse-step">
                    <div class="warehouse-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div>
                      <span>{item.stage}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="comparison-box">
              <div>
                <span>UNSAFE WORDING</span>
                <p>
                  “The 29-unit shortage was caused by an outbound transaction
                  that was not posted correctly.”
                </p>
              </div>

              <div>
                <span>BETTER WORDING</span>
                <p>
                  “A verified shortage of 29 units remains unresolved after
                  review of the available receiving, outbound and adjustment
                  records. Further investigation is required before confirming
                  the root cause.”
                </p>
              </div>
            </div>

            <p>
              The second version keeps verified facts separate from an
              unconfirmed explanation. That distinction is one of the most
              important parts of reviewing AI-generated operational content.
            </p>
          </section>

          <section id="final-check">
            <div class="section-marker">06 / FINAL REVIEW QUESTIONS</div>

            <h2>Before using the output, answer six questions.</h2>

            <div class="question-list">
              {
                finalQuestions.map((item, index) => (
                  <div class="question-row">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{item}</strong>
                  </div>
                ))
              }
            </div>

            <div class="decision-box">
              <span>STOP CONDITION</span>
              <p>
                If an important statement cannot be verified and the
                consequence of being wrong is meaningful, do not treat the
                output as final. Get the missing evidence, expertise or approval
                first.
              </p>
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">07 / PRACTICAL TAKEAWAY</div>

            <h2>Quality comes from the combination of AI speed and human control.</h2>

            <p>
              AI can reduce drafting and information-handling effort, but the
              person reviewing the output is still responsible for checking
              whether it is accurate, appropriate and ready for the next step.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Generate</strong>
                <p>Use AI for the defined task.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Verify</strong>
                <p>Check against the evidence.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>Correct</strong>
                <p>Remove errors and assumptions.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Approve</strong>
                <p>Use the right human authority.</p>
              </div>
            </div>
          </section>

          <section class="next-lesson">
            <div>
              <span class="next-label">NEXT LESSON</span>

              <h2>Building Reusable Prompts</h2>

              <p>
                Learn how to turn effective one-time prompts into repeatable
                templates that can support consistent work.
              </p>
            </div>

            <a
  href="/learn/using-ai-for-real-work/building-reusable-prompts/"
  class="next-status"
>
  CONTINUE →
</a>
          </section>
        </article>
      </div>
    </section>
  </article>
</BaseLayout>

