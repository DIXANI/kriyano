---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const reusableParts = [
  {
    number: "01",
    title: "Stable role",
    text:
      "Keep the perspective consistent when the same type of work is repeated, such as operations supervisor, customer service agent or inventory controller.",
  },
  {
    number: "02",
    title: "Repeatable task",
    text:
      "Describe the job in a way that can be reused, such as drafting a follow-up email, summarising an investigation or organising meeting notes.",
  },
  {
    number: "03",
    title: "Variable inputs",
    text:
      "Replace changing details with placeholders for dates, names, quantities, references, incidents or other task-specific information.",
  },
  {
    number: "04",
    title: "Output structure",
    text:
      "Define the format you want every time, such as headings, bullet points, table columns, email sections or a fixed report structure.",
  },
  {
    number: "05",
    title: "Quality rules",
    text:
      "Keep useful constraints inside the template, including tone, length, evidence requirements and instructions not to invent missing facts.",
  },
];

const templateExamples = [
  {
    title: "Supplier follow-up",
    purpose: "Create consistent supplier follow-up emails.",
    variables:
      "[supplier name], [PO number], [item], [promised date], [current delay], [required response]",
  },
  {
    title: "Inventory discrepancy summary",
    purpose: "Turn verified investigation notes into a repeatable management summary.",
    variables:
      "[system quantity], [physical quantity], [difference], [checks completed], [unresolved points], [next action]",
  },
  {
    title: "Meeting notes",
    purpose: "Convert raw notes into structured minutes and action items.",
    variables:
      "[meeting topic], [participants], [notes], [decisions], [actions], [owners], [deadlines]",
  },
  {
    title: "Operational report",
    purpose: "Produce a consistent summary from verified daily or weekly information.",
    variables:
      "[period], [KPIs], [issues], [incidents], [actions taken], [pending items]",
  },
];

const improvementChecks = [
  "Does the template work across more than one real example?",
  "Are the changing inputs clearly separated from the permanent instructions?",
  "Does the output structure match how the information will actually be used?",
  "Does the template tell AI what not to assume?",
  "Can another person understand how to use it without additional explanation?",
  "Is there a clear human review point before the output is used?",
];

const lifecycle = [
  {
    stage: "BUILD",
    title: "Start from a prompt that already works",
    text:
      "Do not create complexity simply for the sake of having a template. Start with a real prompt that has produced useful results.",
  },
  {
    stage: "GENERALISE",
    title: "Separate fixed instructions from changing details",
    text:
      "Keep the stable task, format and quality rules. Replace changing information with clear placeholders.",
  },
  {
    stage: "TEST",
    title: "Run the template with different examples",
    text:
      "A reusable prompt should work across several realistic cases, not just the situation it was originally written for.",
  },
  {
    stage: "REFINE",
    title: "Fix recurring weaknesses",
    text:
      "If the same problem appears repeatedly, improve the template instead of correcting the output manually every time.",
  },
  {
    stage: "MAINTAIN",
    title: "Update the template when the workflow changes",
    text:
      "Processes, requirements and systems change. Reusable prompts should be reviewed when the real work changes.",
  },
];

const badTemplateSignals = [
  {
    title: "Too many placeholders",
    text:
      "If users need to fill in dozens of fields for a simple task, the template may create more work than it saves.",
  },
  {
    title: "Hidden assumptions",
    text:
      "A reusable prompt should not quietly assume facts, policies or conditions that may differ from one case to another.",
  },
  {
    title: "Overly rigid output",
    text:
      "A fixed format is useful until it prevents the model from handling legitimate differences between cases.",
  },
  {
    title: "No ownership",
    text:
      "A template can standardise the AI step, but someone still needs responsibility for checking and approving the result.",
  },
];
---

<BaseLayout
  title="Building Reusable Prompts | KRIYANO"
  description="Learn how to turn effective one-time prompts into reusable templates for recurring workplace tasks, with practical examples and quality-control guidance."
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>USING AI FOR REAL WORK</span>
            <span>12</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            Building
            <span>Reusable Prompts.</span>
          </h1>

          <p class="article-intro">
            A useful prompt should not always have to be rebuilt from zero.
            When the same type of task happens repeatedly, a tested prompt can
            become a reusable template that improves speed, consistency and
            quality.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 12</span>
            <span>USING AI FOR REAL WORK</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">FROM PROMPT TO TEMPLATE</span>

            <strong>
              Keep the instructions stable. Change only the information that
              belongs to the specific case.
            </strong>

            <p>
              Reusable prompts work best when they standardise a real recurring
              task without removing the flexibility needed for different
              situations.
            </p>
          </div>

          <div class="panel-footer">
            <span>BUILD → TEST → REFINE → REUSE</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#why-reuse">Why reuse prompts</a>
            <a href="#five-parts">Five reusable parts</a>
            <a href="#template-example">Build a template</a>
            <a href="#workplace-examples">Workplace examples</a>
            <a href="#lifecycle">Template lifecycle</a>
            <a href="#quality">Quality checks</a>
            <a href="#takeaway">The practical takeaway</a>
          </div>
        </aside>

        <main class="article-content">
          <section id="why-reuse">
            <div class="section-marker">01 / WHY REUSE PROMPTS</div>

            <h2>Repeatable work should not require repeatable reinvention.</h2>

            <p>
              If you regularly use AI for the same type of task, rewriting the
              instructions every time creates unnecessary effort and can also
              produce inconsistent results.
            </p>

            <p>
              A reusable prompt keeps the parts that should stay consistent
              while allowing the details of each case to change.
            </p>

            <div class="concept-box">
              <span>REUSABLE PROMPT PRINCIPLE</span>
              <p>
                Standardise the instruction, not the facts. The template should
                provide a reliable structure while the current information
                remains specific to the task.
              </p>
            </div>
          </section>

          <section id="five-parts">
            <div class="section-marker">02 / FIVE REUSABLE PARTS</div>

            <h2>A strong template separates stable instructions from variable inputs.</h2>

            <div class="parts-grid">
              {
                reusableParts.map((item) => (
                  <article class="part-card">
                    <span>{item.number}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>

            <div class="template-formula">
              <span>TEMPLATE FORMULA</span>

              <div>
                <strong>Role</strong>
                <span>+</span>
                <strong>Task</strong>
                <span>+</span>
                <strong>Variables</strong>
                <span>+</span>
                <strong>Output</strong>
                <span>+</span>
                <strong>Rules</strong>
              </div>
            </div>
          </section>

          <section id="template-example">
            <div class="section-marker">03 / BUILD A TEMPLATE</div>

            <h2>Turn a one-time inventory prompt into a reusable format.</h2>

            <p>
              Suppose you frequently need to prepare a management summary after
              an inventory discrepancy investigation.
            </p>

            <div class="prompt-comparison">
              <div>
                <span>ONE-TIME PROMPT</span>

                <p>
                  Act as an inventory control supervisor. Prepare a management
                  summary for a stock discrepancy. The system quantity is 900
                  units and the physical count is 876 units. Two physical
                  counts were completed and receiving, outbound and adjustment
                  records were reviewed. The root cause has not been confirmed.
                  Use headings for discrepancy, checks completed, findings and
                  next actions. Do not invent a cause.
                </p>
              </div>

              <div>
                <span>REUSABLE TEMPLATE</span>

                <p>
                  Act as an inventory control supervisor. Prepare a concise
                  management summary for an inventory discrepancy using only
                  the information provided.
                </p>

                <p>
                  System quantity: [system quantity]<br />
                  Physical quantity: [physical quantity]<br />
                  Difference: [difference]<br />
                  Checks completed: [checks completed]<br />
                  Confirmed findings: [confirmed findings]<br />
                  Unresolved points: [unresolved points]
                </p>

                <p>
                  Use the headings: Discrepancy, Checks Completed, Findings,
                  Unresolved Points and Recommended Next Actions. Do not invent
                  a root cause or present an assumption as a verified fact.
                </p>
              </div>
            </div>

            <div class="concept-box">
              <span>WHAT CHANGED?</span>
              <p>
                The role, task, output structure and quality rules remain
                stable. Only the details of the current discrepancy are
                replaced each time.
              </p>
            </div>
          </section>

          <section id="workplace-examples">
            <div class="section-marker">04 / WORKPLACE EXAMPLES</div>

            <h2>Reusable prompts are useful wherever the work pattern repeats.</h2>

            <div class="example-stack">
              {
                templateExamples.map((item) => (
                  <article class="example-card">
                    <div>
                      <span>TEMPLATE</span>
                      <h3>{item.title}</h3>
                    </div>

                    <div>
                      <span>PURPOSE</span>
                      <p>{item.purpose}</p>
                    </div>

                    <div>
                      <span>VARIABLE INPUTS</span>
                      <p>{item.variables}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="warning-box">
              <span>DO NOT TEMPLATE EVERYTHING</span>
              <p>
                Reuse works best for recurring patterns. A highly unusual,
                sensitive or judgment-heavy task may require a fresh prompt and
                more deliberate review.
              </p>
            </div>
          </section>

          <section id="lifecycle">
            <div class="section-marker">05 / TEMPLATE LIFECYCLE</div>

            <h2>A reusable prompt should improve through real use.</h2>

            <div class="lifecycle-list">
              {
                lifecycle.map((item, index) => (
                  <article class="lifecycle-row">
                    <div class="lifecycle-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div class="lifecycle-main">
                      <span>{item.stage}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="decision-box">
              <span>IMPROVEMENT RULE</span>
              <p>
                When you repeatedly make the same correction to AI output,
                consider whether that correction belongs inside the template.
              </p>
            </div>
          </section>

          <section id="quality">
            <div class="section-marker">06 / QUALITY CONTROL</div>

            <h2>Reusable prompts need testing just like reusable workflows.</h2>

            <div class="quality-list">
              {
                improvementChecks.map((item, index) => (
                  <div class="quality-row">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{item}</strong>
                  </div>
                ))
              }
            </div>

            <h3 class="subheading">Watch for weak template design.</h3>

            <div class="signal-grid">
              {
                badTemplateSignals.map((item) => (
                  <article>
                    <h4>{item.title}</h4>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">07 / PRACTICAL TAKEAWAY</div>

            <h2>Turn proven prompts into small pieces of reusable work infrastructure.</h2>

            <p>
              A well-designed reusable prompt reduces repeated setup, improves
              consistency and makes it easier for the same task to be handled
              across multiple cases. But it should remain simple enough to
              understand, test and review.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Find</strong>
                <p>Choose a recurring task.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Separate</strong>
                <p>Fixed rules from variable data.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>Test</strong>
                <p>Use several real examples.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Improve</strong>
                <p>Refine from recurring issues.</p>
              </div>
            </div>

            <div class="tool-callout">
              <div>
                <span class="tool-kicker">BUILD YOUR FIRST VERSION</span>

                <h3>Use KRIYANO to structure a repeatable prompt.</h3>

                <p>
                  Start with the task, role, context, output format and
                  constraints. Then replace the changing information with clear
                  placeholders before saving the prompt for reuse.
                </p>
              </div>

              <a href="/tools/prompt-builder/" class="button button-primary">
                Open Prompt Builder
              </a>
            </div>

            <div class="completion-box">
              <span>LEARNING PATH COMPLETE</span>

              <h3>Using AI for Real Work</h3>

              <p>
                You have completed the four guides in this learning path:
                choosing suitable tasks, building AI-assisted workflows,
                reviewing AI output and creating reusable prompts.
              </p>

              <div class="completion-lessons">
                <span>09 — Choosing Tasks for AI</span>
                <span>10 — AI-Assisted Workflows</span>
                <span>11 — Human Review &amp; Quality Control</span>
                <span>12 — Building Reusable Prompts</span>
              </div>
            </div>
          </section>

          <section class="next-lesson">
            <div>
              <span class="next-label">NEXT LEARNING PATH</span>

              <h2>Accuracy &amp; Research</h2>

              <p>
                Learn why AI can produce wrong answers, how to fact-check its
                output, evaluate sources and use AI more carefully for
                research.
              </p>
            </div>

            <a
  href="/learn/accuracy-and-research/why-ai-can-produce-wrong-answers/"
  class="next-status"
>
  START PATH →
</a>
          </section>
        </main>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
