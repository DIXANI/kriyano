---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const templateParts = [
  {
    number: "01",
    title: "Purpose",
    text:
      "Define what the prompt is designed to achieve. A reusable template should solve a recurring task, not a vague category of work.",
  },
  {
    number: "02",
    title: "Role",
    text:
      "Tell the AI what kind of perspective or expertise it should apply when that genuinely improves the result.",
  },
  {
    number: "03",
    title: "Inputs",
    text:
      "Identify the information that changes each time the template is used, such as product details, audience, dates, quantities or context.",
  },
  {
    number: "04",
    title: "Instructions",
    text:
      "Explain what the AI should do with the inputs and in what order.",
  },
  {
    number: "05",
    title: "Constraints",
    text:
      "Set boundaries such as length, tone, format, exclusions, safety requirements or business rules.",
  },
  {
    number: "06",
    title: "Output format",
    text:
      "Define the structure of the final result so repeated use produces more consistent outputs.",
  },
];

const weakVsStrong = [
  {
    label: "WEAK TEMPLATE",
    title: "Too generic to control the result",
    prompt:
      "Write a professional email about a stock issue.",
    problem:
      "Important context is missing, so every use may require rewriting the prompt from scratch.",
  },
  {
    label: "STRONGER TEMPLATE",
    title: "Reusable structure with clear variables",
    prompt:
      "Act as a warehouse supervisor. Write a concise professional email to [recipient] about [stock issue]. Include [key facts], explain [impact], request [required action], and keep the tone [tone]. Do not make assumptions beyond the information provided.",
    problem:
      "The structure stays stable while the task-specific information changes.",
  },
];

const variableExamples = [
  {
    variable: "[recipient]",
    example: "Inventory Manager",
  },
  {
    variable: "[stock issue]",
    example: "physical count does not match system stock",
  },
  {
    variable: "[key facts]",
    example: "System 1,240 units; physical 1,217 units; variance -23",
  },
  {
    variable: "[impact]",
    example: "order allocation may be affected",
  },
  {
    variable: "[required action]",
    example: "approve recount and transaction review",
  },
  {
    variable: "[tone]",
    example: "professional and factual",
  },
];

const mistakes = [
  {
    title: "Too many fixed details",
    text:
      "If most of the prompt has to be edited every time, it is not functioning as a useful template.",
  },
  {
    title: "Variables are unclear",
    text:
      "Placeholders should tell the user exactly what information belongs there.",
  },
  {
    title: "No quality controls",
    text:
      "A reusable prompt should include important rules that should apply every time, not rely on the user remembering them.",
  },
  {
    title: "Output format keeps changing",
    text:
      "Repeated tasks become easier when the expected structure is built directly into the template.",
  },
  {
    title: "The template is too broad",
    text:
      "One prompt for every possible task usually performs worse than several focused templates.",
  },
  {
    title: "No review after use",
    text:
      "Templates should improve over time based on the quality of real outputs.",
  },
];

const workflow = [
  {
    stage: "IDENTIFY",
    title: "Find a recurring task",
    text:
      "Choose work you perform repeatedly and where the desired output structure is reasonably stable.",
  },
  {
    stage: "SEPARATE",
    title: "Separate fixed instructions from changing inputs",
    text:
      "Keep the recurring rules in the template and turn task-specific details into variables.",
  },
  {
    stage: "STRUCTURE",
    title: "Organise the prompt",
    text:
      "Arrange purpose, inputs, instructions, constraints and output format in a logical order.",
  },
  {
    stage: "TEST",
    title: "Run different examples",
    text:
      "Use several realistic input sets to see whether the template produces consistently useful results.",
  },
  {
    stage: "REVIEW",
    title: "Look for recurring weaknesses",
    text:
      "Identify what the AI repeatedly misunderstands, omits or formats poorly.",
  },
  {
    stage: "IMPROVE",
    title: "Refine the template",
    text:
      "Update the fixed instructions so the next use starts from a stronger baseline.",
  },
];
---

<BaseLayout
  title="Creating Prompt Templates | KRIYANO"
  description="Learn how to turn successful AI prompts into reusable prompt templates using variables, fixed instructions, constraints and consistent output structures."
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>BETTER AI SYSTEMS</span>
            <span>21</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            Creating Prompt
            <span>Templates.</span>
          </h1>

          <p class="article-intro">
            A good prompt solves one task. A good prompt template creates a
            repeatable structure that can solve the same type of task again
            with new information.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 21</span>
            <span>BETTER AI SYSTEMS</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">FROM ONE-OFF PROMPT TO REUSABLE SYSTEM</span>

            <strong>
              Keep the structure. Change the inputs.
            </strong>

            <p>
              Prompt templates reduce repeated writing and help produce more
              consistent results across similar tasks.
            </p>
          </div>

          <div class="panel-footer">
            <span>STRUCTURE → VARIABLES → TEST → IMPROVE</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#template">What a prompt template is</a>
            <a href="#parts">Six template parts</a>
            <a href="#example">Weak vs stronger template</a>
            <a href="#variables">Using variables</a>
            <a href="#mistakes">Common mistakes</a>
            <a href="#workflow">Template workflow</a>
            <a href="#takeaway">Practical takeaway</a>
          </div>
        </aside>

        <main class="article-content">
          <section id="template">
            <div class="section-marker">01 / WHAT A PROMPT TEMPLATE IS</div>

            <h2>A prompt template separates what stays the same from what changes.</h2>

            <p>
              Many people rewrite similar prompts repeatedly. The task may be
              almost identical each time, but names, quantities, dates,
              products or context change.
            </p>

            <p>
              A prompt template solves this by keeping the recurring structure
              fixed and turning the changing information into placeholders or
              variables.
            </p>

            <div class="concept-box">
              <span>SIMPLE MODEL</span>
              <p>
                <strong>Reusable instructions</strong> + <strong>changing inputs</strong>
                = a prompt template.
              </p>
            </div>
          </section>

          <section id="parts">
            <div class="section-marker">02 / SIX TEMPLATE PARTS</div>

            <h2>Build the template around the parts that matter every time.</h2>

            <div class="principle-grid">
              {
                templateParts.map((item) => (
                  <article class="principle-card">
                    <span>{item.number}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="example">
            <div class="section-marker">03 / WEAK VS STRONGER TEMPLATE</div>

            <h2>A reusable prompt should reduce repeated decisions.</h2>

            <div class="comparison-grid">
              {
                weakVsStrong.map((item) => (
                  <article>
                    <span>{item.label}</span>
                    <h3>{item.title}</h3>

                    <div class="prompt-box">
                      {item.prompt}
                    </div>

                    <p>{item.problem}</p>
                  </article>
                ))
              }
            </div>

            <div class="concept-box">
              <span>WHAT CHANGED?</span>
              <p>
                The stronger version defines the role, purpose, changing
                information, required content, tone and an important
                constraint. The user only needs to replace the variables.
              </p>
            </div>
          </section>

          <section id="variables">
            <div class="section-marker">04 / USING VARIABLES</div>

            <h2>Variables should make the template easier to use—not harder to understand.</h2>

            <p>
              Use clear placeholders for information that changes. A placeholder
              such as <strong>[key facts]</strong> is more useful than something
              vague such as <strong>[details]</strong>.
            </p>

            <div class="variable-table">
              <div class="table-header">
                <span>VARIABLE</span>
                <span>EXAMPLE INPUT</span>
              </div>

              {
                variableExamples.map((item) => (
                  <div class="table-row">
                    <code>{item.variable}</code>
                    <span>{item.example}</span>
                  </div>
                ))
              }
            </div>

            <div class="template-demo">
              <span class="template-label">REUSABLE TEMPLATE</span>

              <p>
                Act as a warehouse supervisor. Write a concise professional
                email to <mark>[recipient]</mark> about
                <mark>[stock issue]</mark>. Include
                <mark>[key facts]</mark>, explain
                <mark>[impact]</mark>, request
                <mark>[required action]</mark>, and keep the tone
                <mark>[tone]</mark>. Do not make assumptions beyond the
                information provided.
              </p>
            </div>
          </section>

          <section id="mistakes">
            <div class="section-marker">05 / COMMON MISTAKES</div>

            <h2>A template can save time only if the structure is genuinely reusable.</h2>

            <div class="mistake-grid">
              {
                mistakes.map((item, index) => (
                  <article>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="workflow">
            <div class="section-marker">06 / TEMPLATE WORKFLOW</div>

            <h2>Build prompt templates from real repeated work.</h2>

            <div class="workflow-list">
              {
                workflow.map((item, index) => (
                  <article class="workflow-row">
                    <div class="workflow-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div>
                      <span>{item.stage}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="workflow-summary">
              <span>PROMPT TEMPLATE LOOP</span>

              <div>
                <strong>Identify</strong>
                <span>→</span>
                <strong>Separate</strong>
                <span>→</span>
                <strong>Structure</strong>
                <span>→</span>
                <strong>Test</strong>
                <span>→</span>
                <strong>Improve</strong>
              </div>
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">07 / PRACTICAL TAKEAWAY</div>

            <h2>Turn successful prompts into reusable assets.</h2>

            <p>
              When a prompt works well for a repeated task, do not leave it as a
              one-time conversation. Extract the reusable structure, replace
              changing details with clear variables, test it with different
              examples and improve it over time.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Keep</strong>
                <p>Recurring instructions.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Replace</strong>
                <p>Changing details with variables.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>Test</strong>
                <p>Different real examples.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Improve</strong>
                <p>Refine repeated weaknesses.</p>
              </div>
            </div>
          </section>

          <section class="next-lesson">
            <div>
              <span class="next-label">NEXT LESSON</span>

              <h2>Building AI Workflows</h2>

              <p>
                Learn how to connect prompts, human review and operational
                steps into a repeatable AI-assisted process.
              </p>
            </div>

            <a
  href="/learn/better-ai-systems/building-ai-workflows/"
  class="next-status"
>
  CONTINUE →
</a>
          </section>
        </main>
      </div>
    </section>
  </article>
</BaseLayout>

