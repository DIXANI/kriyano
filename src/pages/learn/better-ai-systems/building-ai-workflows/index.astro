---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { createLearnSchema } from "../../../../utils/learnSchema";

const articleTitle = "Building AI Workflows | KRIYANO";

const articleDescription =
  "Learn how to build practical AI-assisted workflows by connecting inputs, AI tasks, human review, outputs and actions into a repeatable process.";

const schema = createLearnSchema({
  title: "Building AI Workflows",
  description: articleDescription,
  pathName: "Better AI Systems",
  pathSlug: "better-ai-systems",
  articleSlug: "building-ai-workflows",
});

const workflowParts = [
  {
    number: "01",
    title: "Trigger",
    text:
      "Define what starts the workflow: a request, new document, operational issue, scheduled task or another clear event.",
  },
  {
    number: "02",
    title: "Inputs",
    text:
      "Identify the information the process needs before AI is used. Good workflows do not depend on missing or uncontrolled inputs.",
  },
  {
    number: "03",
    title: "AI task",
    text:
      "Give AI a specific job such as extracting information, drafting, classifying, comparing or summarising.",
  },
  {
    number: "04",
    title: "Human checkpoint",
    text:
      "Decide where a person must verify facts, apply judgement, approve an action or correct the AI output.",
  },
  {
    number: "05",
    title: "Output",
    text:
      "Define what the workflow should produce: an email, report, decision support summary, checklist, structured data or another useful result.",
  },
  {
    number: "06",
    title: "Next action",
    text:
      "Specify what happens after the output is approved so the workflow leads to action instead of stopping at generated text.",
  },
];

const taskExamples = [
  {
    task: "Extract",
    example: "Pull key fields from a document or structured text.",
  },
  {
    task: "Classify",
    example: "Group issues, requests or records into predefined categories.",
  },
  {
    task: "Summarise",
    example: "Reduce a longer input into the information needed for a decision.",
  },
  {
    task: "Compare",
    example: "Identify differences between records, options or versions.",
  },
  {
    task: "Draft",
    example: "Create a first version of an email, report, SOP or response.",
  },
  {
    task: "Review",
    example: "Check an output against defined rules before human approval.",
  },
];

const workflowExample = [
  {
    stage: "INPUT",
    title: "Variance information",
    text:
      "System quantity, physical quantity, SKU, location and relevant transaction notes.",
  },
  {
    stage: "AI TASK",
    title: "Structure the investigation",
    text:
      "Calculate the variance, summarise the issue and identify records that should be checked.",
  },
  {
    stage: "HUMAN CHECK",
    title: "Verify evidence",
    text:
      "Confirm quantities and review receiving, outbound, adjustment and movement records.",
  },
  {
    stage: "AI TASK",
    title: "Draft the report",
    text:
      "Use the verified findings to prepare a concise discrepancy summary.",
  },
  {
    stage: "APPROVAL",
    title: "Supervisor review",
    text:
      "Check the final report, conclusions and proposed corrective actions.",
  },
  {
    stage: "ACTION",
    title: "Escalate or close",
    text:
      "Send the approved report, initiate corrective action or continue investigation.",
  },
];

const mistakes = [
  {
    title: "Automating an unclear process",
    text:
      "If the existing process is poorly defined, adding AI can make the confusion faster rather than making the work better.",
  },
  {
    title: "Giving AI the entire job",
    text:
      "Break complex work into controlled tasks instead of asking one prompt to perform every stage at once.",
  },
  {
    title: "No verification point",
    text:
      "Important facts and decisions need an intentional review step rather than assuming generated output is correct.",
  },
  {
    title: "Uncontrolled inputs",
    text:
      "Inconsistent or incomplete input data can produce inconsistent outputs even when the prompt itself is good.",
  },
  {
    title: "No defined final action",
    text:
      "A workflow should connect the AI output to a useful next step, owner or decision.",
  },
  {
    title: "Too much automation too early",
    text:
      "Start with a simple repeatable workflow, test it manually and automate more only when the process is stable.",
  },
];

const buildSteps = [
  {
    stage: "MAP",
    title: "Map the current process",
    text:
      "Write down how the task is completed today, including inputs, decisions, handoffs and final output.",
  },
  {
    stage: "SELECT",
    title: "Choose suitable AI tasks",
    text:
      "Identify stages where AI can reduce repetitive work without removing necessary human judgement.",
  },
  {
    stage: "DEFINE",
    title: "Define inputs and outputs",
    text:
      "Specify what each AI step receives and exactly what it should produce.",
  },
  {
    stage: "CONTROL",
    title: "Add human checkpoints",
    text:
      "Place verification and approval where errors could affect the quality or consequence of the work.",
  },
  {
    stage: "TEST",
    title: "Run realistic cases",
    text:
      "Test normal cases as well as incomplete, unusual or difficult inputs.",
  },
  {
    stage: "REFINE",
    title: "Improve the workflow",
    text:
      "Adjust prompts, instructions, checkpoints and handoffs based on actual results.",
  },
];
---

<BaseLayout
  title={articleTitle}
  description={articleDescription}
  schema={schema}
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>BETTER AI SYSTEMS</span>
            <span>22</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            Building AI
            <span>Workflows.</span>
          </h1>

          <p class="article-intro">
            Useful AI work rarely ends with one prompt. A workflow connects
            information, AI tasks, human judgement and real actions into a
            repeatable process.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 22</span>
            <span>BETTER AI SYSTEMS</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">MOVE BEYOND THE SINGLE PROMPT</span>

            <strong>
              Give AI a defined place inside the process.
            </strong>

            <p>
              Strong workflows specify what AI receives, what it does, what
              people review and what happens next.
            </p>
          </div>

          <div class="panel-footer">
            <span>INPUT → AI → REVIEW → ACTION</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#workflow">What an AI workflow is</a>
            <a href="#parts">Six workflow parts</a>
            <a href="#tasks">Where AI fits</a>
            <a href="#example">Warehouse example</a>
            <a href="#mistakes">Common mistakes</a>
            <a href="#build">Building the workflow</a>
            <a href="#takeaway">Practical takeaway</a>
          </div>
        </aside>

        <article class="article-content">
          <section id="workflow">
            <div class="section-marker">01 / WHAT AN AI WORKFLOW IS</div>

            <h2>A workflow is a sequence of connected steps—not a larger prompt.</h2>

            <p>
              A prompt tells AI what to do at one point in the work. A workflow
              describes how that AI task connects to the information before it,
              the review after it and the action that follows.
            </p>

            <p>
              This distinction matters because real work usually contains
              multiple stages. Some are suitable for AI, some require human
              judgement and some may not need AI at all.
            </p>

            <div class="concept-box">
              <span>SIMPLE MODEL</span>
              <p>
                <strong>Input</strong> → <strong>AI task</strong> →
                <strong>human review</strong> → <strong>approved output</strong>
                → <strong>action</strong>
              </p>
            </div>
          </section>

          <section id="parts">
            <div class="section-marker">02 / SIX WORKFLOW PARTS</div>

            <h2>Define the complete process around the AI step.</h2>

            <div class="principle-grid">
              {
                workflowParts.map((item) => (
                  <article class="principle-card">
                    <span>{item.number}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="tasks">
            <div class="section-marker">03 / WHERE AI FITS</div>

            <h2>Use AI for specific tasks inside the workflow.</h2>

            <p>
              Instead of asking AI to “handle the process,” identify individual
              stages where its capabilities are useful and the expected output
              can be clearly described.
            </p>

            <div class="task-table">
              <div class="table-header">
                <span>AI TASK</span>
                <span>POSSIBLE USE</span>
              </div>

              {
                taskExamples.map((item) => (
                  <div class="table-row">
                    <strong>{item.task}</strong>
                    <span>{item.example}</span>
                  </div>
                ))
              }
            </div>

            <div class="decision-box">
              <span>DESIGN PRINCIPLE</span>
              <p>
                Do not ask where AI can replace the whole process. Ask which
                individual steps AI can support reliably while people retain
                the judgement that matters.
              </p>
            </div>
          </section>

          <section id="example">
            <div class="section-marker">04 / WAREHOUSE EXAMPLE</div>

            <h2>Turn a stock discrepancy investigation into an AI-assisted workflow.</h2>

            <p>
              Consider a recurring warehouse process where a physical count
              does not match the system quantity. AI can support parts of the
              investigation without becoming the authority that determines the
              root cause.
            </p>

            <div class="case-box">
              <div class="case-header">
                <span>EXAMPLE WORKFLOW</span>
                <strong>Stock discrepancy investigation</strong>
              </div>

              <div class="case-data">
                <div>
                  <small>SYSTEM</small>
                  <strong>3,180</strong>
                </div>

                <div>
                  <small>PHYSICAL</small>
                  <strong>3,142</strong>
                </div>

                <div>
                  <small>VARIANCE</small>
                  <strong>-38</strong>
                </div>
              </div>
            </div>

            <div class="example-workflow">
              {
                workflowExample.map((item, index) => (
                  <article class="example-row">
                    <div class="example-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div>
                      <span>{item.stage}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="workflow-visual">
              <div>
                <span>INPUT</span>
                <strong>Variance data</strong>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>AI</span>
                <strong>Structure</strong>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>HUMAN</span>
                <strong>Verify</strong>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>AI</span>
                <strong>Draft</strong>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>ACTION</span>
                <strong>Approve</strong>
              </div>
            </div>

            <div class="concept-box">
              <span>WHY THIS IS BETTER</span>
              <p>
                AI reduces repetitive structuring and drafting, while the
                investigation itself remains grounded in verified warehouse
                records and human operational judgement.
              </p>
            </div>
          </section>

          <section id="mistakes">
            <div class="section-marker">05 / COMMON MISTAKES</div>

            <h2>Do not automate confusion.</h2>

            <div class="mistake-grid">
              {
                mistakes.map((item, index) => (
                  <article>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="build">
            <div class="section-marker">06 / BUILDING THE WORKFLOW</div>

            <h2>Start with the real process, then decide where AI belongs.</h2>

            <div class="workflow-list">
              {
                buildSteps.map((item, index) => (
                  <article class="workflow-row">
                    <div class="workflow-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div>
                      <span>{item.stage}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="workflow-summary">
              <span>WORKFLOW DESIGN LOOP</span>

              <div>
                <strong>Map</strong>
                <span>→</span>
                <strong>Select</strong>
                <span>→</span>
                <strong>Define</strong>
                <span>→</span>
                <strong>Control</strong>
                <span>→</span>
                <strong>Test</strong>
                <span>→</span>
                <strong>Refine</strong>
              </div>
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">07 / PRACTICAL TAKEAWAY</div>

            <h2>The best AI workflow is controlled, repeatable and useful.</h2>

            <p>
              Build around the work that actually needs to happen. Give AI
              narrow, well-defined tasks, make inputs consistent, add human
              review where errors matter and connect the approved result to a
              real next action.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Map</strong>
                <p>Understand the real process.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Assign</strong>
                <p>Give AI suitable tasks.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>Control</strong>
                <p>Add verification points.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Act</strong>
                <p>Connect output to work.</p>
              </div>
            </div>
          </section>

          <section class="next-lesson">
            <div>
              <span class="next-label">NEXT LESSON</span>

              <h2>Combining Multiple AI Tasks</h2>

              <p>
                Learn how to divide complex work into several focused AI tasks
                and pass useful outputs from one stage to the next.
              </p>
            </div>

            <a
  href="/learn/better-ai-systems/combining-multiple-ai-tasks/"
  class="next-status"
>
  CONTINUE →
</a>
          </section>
        </article>
      </div>
    </section>
  </article>
</BaseLayout>

