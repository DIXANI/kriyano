---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const reviewAreas = [
  {
    number: "01",
    title: "Output quality",
    text:
      "Check whether the system consistently produces accurate, useful and appropriately structured results.",
  },
  {
    number: "02",
    title: "Consistency",
    text:
      "Test whether similar inputs produce outputs that follow the same standards, structure and level of detail.",
  },
  {
    number: "03",
    title: "Time saved",
    text:
      "Compare the complete AI-assisted process with the previous method, including preparation and human review time.",
  },
  {
    number: "04",
    title: "Error rate",
    text:
      "Track recurring factual, formatting, classification or reasoning errors instead of judging the system from one successful result.",
  },
  {
    number: "05",
    title: "Review burden",
    text:
      "Measure how much human correction is still required. Fast generation has limited value if every output needs major rewriting.",
  },
  {
    number: "06",
    title: "Operational usefulness",
    text:
      "Confirm that the final output actually supports the next decision or action in the real workflow.",
  },
];

const metrics = [
  {
    label: "QUALITY",
    title: "Is the output good enough?",
    text:
      "Accuracy, completeness, clarity, relevance and compliance with the required format.",
  },
  {
    label: "CONSISTENCY",
    title: "Does it work repeatedly?",
    text:
      "Performance across different users, inputs, scenarios and normal variations in the task.",
  },
  {
    label: "EFFICIENCY",
    title: "Does it reduce useful work?",
    text:
      "Total time saved after including data preparation, prompting, checking and correction.",
  },
  {
    label: "CONTROL",
    title: "Can mistakes be caught?",
    text:
      "Whether important facts, assumptions and decisions are visible enough for effective human review.",
  },
];

const failureLog = [
  {
    type: "FACTUAL",
    example: "Incorrect quantity, date, name or operational detail",
    response: "Strengthen source inputs and verification.",
  },
  {
    type: "MISSING",
    example: "Required section or important information omitted",
    response: "Improve instructions or output structure.",
  },
  {
    type: "FORMAT",
    example: "Correct information presented in the wrong structure",
    response: "Tighten formatting requirements or template.",
  },
  {
    type: "ASSUMPTION",
    example: "AI invents a cause or fills a missing fact",
    response: "Add uncertainty rules and evidence controls.",
  },
  {
    type: "HANDOFF",
    example: "Information changes between workflow stages",
    response: "Improve the input/output contract between tasks.",
  },
  {
    type: "REVIEW",
    example: "Human checker repeatedly misses the same issue",
    response: "Improve the checklist or approval checkpoint.",
  },
];

const versionSteps = [
  {
    version: "V1.0",
    title: "Initial working system",
    text:
      "Document the prompt, template, workflow stages, required inputs and review process.",
  },
  {
    version: "V1.1",
    title: "Small controlled improvement",
    text:
      "Change one meaningful element based on a recurring problem or clearly identified opportunity.",
  },
  {
    version: "TEST",
    title: "Compare representative cases",
    text:
      "Run normal, difficult and incomplete examples instead of testing only the easiest case.",
  },
  {
    version: "REVIEW",
    title: "Check the effect",
    text:
      "Determine whether the change improved quality without creating a new problem elsewhere.",
  },
  {
    version: "V1.2",
    title: "Keep or revise",
    text:
      "Retain successful changes, record what changed and continue improving from a known version.",
  },
];

const testCases = [
  {
    title: "Normal case",
    text:
      "A typical example containing the information the workflow normally expects.",
  },
  {
    title: "Incomplete case",
    text:
      "Important information is missing and the system should identify the gap instead of inventing it.",
  },
  {
    title: "Complex case",
    text:
      "Several issues or conditions appear together and require careful separation.",
  },
  {
    title: "Edge case",
    text:
      "An unusual but realistic situation tests whether the system's assumptions are too narrow.",
  },
];

const warehouseReview = [
  {
    stage: "OBSERVE",
    title: "Recurring issue",
    text:
      "Investigation drafts repeatedly suggest receiving errors even when the evidence does not confirm the cause.",
  },
  {
    stage: "TRACE",
    title: "Locate the weakness",
    text:
      "The analysis prompt asks for the 'most likely cause' before the transaction evidence has been verified.",
  },
  {
    stage: "CHANGE",
    title: "Improve the instruction",
    text:
      "The prompt is changed to separate confirmed findings, possible investigation areas and missing evidence.",
  },
  {
    stage: "TEST",
    title: "Run representative cases",
    text:
      "The revised workflow is tested using several discrepancies with different causes and incomplete records.",
  },
  {
    stage: "MEASURE",
    title: "Compare the results",
    text:
      "Check whether unsupported root-cause statements decrease without making the investigation summary less useful.",
  },
  {
    stage: "STANDARDISE",
    title: "Update the working version",
    text:
      "If the change performs better, update the reusable template and record the new version.",
  },
];

const improvementSteps = [
  {
    stage: "MEASURE",
    title: "Observe real performance",
    text:
      "Use actual outputs, corrections, failures and user feedback instead of relying only on how good the system looks during setup.",
  },
  {
    stage: "LOG",
    title: "Record recurring weaknesses",
    text:
      "Group repeated problems so that isolated mistakes are not confused with systematic weaknesses.",
  },
  {
    stage: "PRIORITISE",
    title: "Fix the important problems first",
    text:
      "Give priority to errors that affect accuracy, decisions, customers, compliance or significant human review time.",
  },
  {
    stage: "CHANGE",
    title: "Make a controlled adjustment",
    text:
      "Improve the prompt, input, handoff, template, review rule or workflow stage responsible for the problem.",
  },
  {
    stage: "TEST",
    title: "Compare before and after",
    text:
      "Use representative cases to check whether the change genuinely improved the system.",
  },
  {
    stage: "STANDARDISE",
    title: "Document the better version",
    text:
      "Keep the successful improvement as the new working standard and continue monitoring it.",
  },
];
---

<BaseLayout
  title="Reviewing & Improving Your System | KRIYANO"
  description="Learn how to review and improve AI-assisted systems by measuring quality, tracking recurring failures, testing changes and maintaining reliable working versions."
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>BETTER AI SYSTEMS</span>
            <span>24</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            Reviewing &amp; Improving
            <span>Your System.</span>
          </h1>

          <p class="article-intro">
            A useful AI system is not finished when it works once. Reliable
            systems improve through measurement, testing, human feedback and
            controlled changes over time.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 24</span>
            <span>BETTER AI SYSTEMS</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">TURN EXPERIENCE INTO IMPROVEMENT</span>

            <strong>
              Review the system, not just the latest output.
            </strong>

            <p>
              Look for patterns across real use. Improve the part of the
              workflow causing the problem, test the change and keep a record
              of what works.
            </p>
          </div>

          <div class="panel-footer">
            <span>MEASURE → LEARN → CHANGE → TEST → IMPROVE</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#review">What should you review?</a>
            <a href="#measure">Measure the whole system</a>
            <a href="#failures">Learn from failures</a>
            <a href="#versions">Improve with versions</a>
            <a href="#testing">Test representative cases</a>
            <a href="#example">Warehouse example</a>
            <a href="#loop">Improvement loop</a>
            <a href="#takeaway">Practical takeaway</a>
          </div>
        </aside>

        <main class="article-content">
          <section id="review">
            <div class="section-marker">01 / WHAT SHOULD YOU REVIEW?</div>

            <h2>Do not judge an AI system from one impressive output.</h2>

            <p>
              A workflow can produce an excellent result once and still be
              unreliable. Review performance across repeated use, different
              inputs and realistic situations.
            </p>

            <p>
              The goal is not to make every AI output perfect. The goal is to
              create a process where useful results are produced consistently
              and important mistakes can be identified before they cause harm.
            </p>

            <div class="review-grid">
              {
                reviewAreas.map((item) => (
                  <article class="review-card">
                    <span>{item.number}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="measure">
            <div class="section-marker">02 / MEASURE THE WHOLE SYSTEM</div>

            <h2>Generation speed is only one part of performance.</h2>

            <p>
              An AI task may generate an answer in seconds, but the complete
              workflow could still be inefficient if employees spend significant
              time preparing inputs, correcting mistakes or rewriting outputs.
            </p>

            <div class="metric-grid">
              {
                metrics.map((item) => (
                  <article>
                    <span>{item.label}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>

            <div class="formula-box">
              <span>BETTER QUESTION</span>

              <div>
                <strong>
                  Preparation + AI processing + human review + correction
                </strong>
                <span>→</span>
                <strong>Useful final output</strong>
              </div>

              <p>
                Measure the complete path to a usable result—not only the time
                taken for AI to generate text.
              </p>
            </div>
          </section>

          <section id="failures">
            <div class="section-marker">03 / LEARN FROM FAILURES</div>

            <h2>Recurring mistakes are information about your system.</h2>

            <p>
              When the same type of problem appears repeatedly, simply
              correcting the final output wastes an opportunity. Trace the
              problem back to the prompt, input, workflow, handoff or review
              process that allowed it to happen.
            </p>

            <div class="failure-table">
              <div class="failure-head">
                <span>TYPE</span>
                <span>EXAMPLE</span>
                <span>SYSTEM RESPONSE</span>
              </div>

              {
                failureLog.map((item) => (
                  <div class="failure-row">
                    <strong>{item.type}</strong>
                    <p>{item.example}</p>
                    <p>{item.response}</p>
                  </div>
                ))
              }
            </div>

            <div class="concept-box">
              <span>IMPORTANT</span>
              <p>
                Do not redesign a workflow because of every isolated mistake.
                Look for repeated weaknesses, high-impact failures or clear
                opportunities to reduce unnecessary human effort.
              </p>
            </div>
          </section>

          <section id="versions">
            <div class="section-marker">04 / IMPROVE WITH VERSIONS</div>

            <h2>Change systems deliberately instead of constantly rewriting them.</h2>

            <p>
              When prompts and workflows are edited without keeping track of
              changes, it becomes difficult to know which version performed
              better or why a new problem appeared.
            </p>

            <div class="version-list">
              {
                versionSteps.map((item) => (
                  <article>
                    <div class="version-label">{item.version}</div>

                    <div>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="change-note">
              <span>SIMPLE CHANGE NOTE</span>

              <div class="change-grid">
                <div>
                  <small>VERSION</small>
                  <strong>1.2</strong>
                </div>

                <div>
                  <small>PROBLEM</small>
                  <strong>AI assumes missing causes</strong>
                </div>

                <div>
                  <small>CHANGE</small>
                  <strong>Added evidence-status rule</strong>
                </div>

                <div>
                  <small>RESULT</small>
                  <strong>Retest required</strong>
                </div>
              </div>
            </div>
          </section>

          <section id="testing">
            <div class="section-marker">05 / TEST REPRESENTATIVE CASES</div>

            <h2>A system should work beyond the example used to build it.</h2>

            <p>
              Testing only one ideal example can hide weaknesses. Use several
              realistic cases so you can see how the system behaves when
              information is incomplete, unusual or more complicated.
            </p>

            <div class="test-grid">
              {
                testCases.map((item, index) => (
                  <article>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>

            <div class="test-flow">
              <strong>SAME SYSTEM</strong>
              <span>→</span>
              <strong>MULTIPLE CASES</strong>
              <span>→</span>
              <strong>COMPARE RESULTS</strong>
              <span>→</span>
              <strong>IDENTIFY PATTERNS</strong>
            </div>
          </section>

          <section id="example">
            <div class="section-marker">06 / WAREHOUSE EXAMPLE</div>

            <h2>Improve a stock discrepancy workflow using recurring evidence.</h2>

            <div class="warehouse-case">
              <div class="case-header">
                <span>WORKFLOW REVIEW</span>
                <strong>Inventory discrepancy investigation</strong>
              </div>

              <div class="case-intro">
                <p>
                  The workflow is producing useful investigation summaries, but
                  reviewers notice a recurring problem: AI sometimes presents a
                  possible cause as though it has already been confirmed.
                </p>
              </div>
            </div>

            <div class="warehouse-review">
              {
                warehouseReview.map((item, index) => (
                  <article>
                    <div class="warehouse-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div>
                      <span>{item.stage}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="before-after">
              <div>
                <span>BEFORE</span>
                <strong>
                  "Identify the most likely cause of this discrepancy."
                </strong>
                <p>
                  Encourages the model to select a cause even when the evidence
                  may be incomplete.
                </p>
              </div>

              <div class="before-after-arrow">→</div>

              <div>
                <span>IMPROVED</span>
                <strong>
                  "Separate confirmed findings, possible investigation areas
                  and missing evidence."
                </strong>
                <p>
                  Keeps uncertainty visible and makes human verification easier.
                </p>
              </div>
            </div>
          </section>

          <section id="loop">
            <div class="section-marker">07 / THE IMPROVEMENT LOOP</div>

            <h2>Build a feedback loop around real use.</h2>

            <div class="improvement-list">
              {
                improvementSteps.map((item, index) => (
                  <article class="improvement-row">
                    <div class="improvement-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div>
                      <span>{item.stage}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="loop-summary">
              <span>CONTINUOUS IMPROVEMENT</span>

              <div>
                <strong>Measure</strong>
                <span>→</span>
                <strong>Log</strong>
                <span>→</span>
                <strong>Prioritise</strong>
                <span>→</span>
                <strong>Change</strong>
                <span>→</span>
                <strong>Test</strong>
                <span>→</span>
                <strong>Standardise</strong>
              </div>
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">08 / PRACTICAL TAKEAWAY</div>

            <h2>A strong AI system should become more reliable as you use it.</h2>

            <p>
              Treat prompts, templates and workflows as working systems rather
              than one-time instructions. Observe real performance, learn from
              recurring failures, make controlled improvements and keep human
              responsibility around important decisions.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Measure</strong>
                <p>Judge real performance.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Learn</strong>
                <p>Find recurring weaknesses.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>Improve</strong>
                <p>Make controlled changes.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Repeat</strong>
                <p>Keep the system useful.</p>
              </div>
            </div>
          </section>

          <section class="completion-box">
            <span class="completion-label">LEARNING PATH COMPLETE</span>

            <h2>Better AI Systems</h2>

            <p>
              You have completed all four guides in this learning path:
              creating reusable prompt templates, building AI workflows,
              combining multiple AI tasks, and reviewing and improving the
              systems you create.
            </p>

            <div class="completed-lessons">
              <span>21 — Creating Prompt Templates</span>
              <span>22 — Building AI Workflows</span>
              <span>23 — Combining Multiple AI Tasks</span>
              <span>24 — Reviewing &amp; Improving Your System</span>
            </div>
          </section>

          <section class="curriculum-complete">
            <div>
              <span class="complete-kicker">KRIYANO LEARN</span>

              <h2>24 guides completed.</h2>

              <p>
                You have reached the end of the KRIYANO foundational learning
                paths. Continue by applying what you learned through practical
                prompts, tools and real-world AI workflows.
              </p>
            </div>

            <div class="resource-links">
              <a href="/tools/prompt-builder/">
                <span>BUILD</span>
                <strong>AI Prompt Builder</strong>
                <small>OPEN TOOL →</small>
              </a>

              <a href="/prompts/">
                <span>EXPLORE</span>
                <strong>Prompt Library</strong>
                <small>VIEW PROMPTS →</small>
              </a>

              <a href="/learn/">
                <span>REVIEW</span>
                <strong>Learning Paths</strong>
                <small>BACK TO LEARN →</small>
              </a>
            </div>
          </section>
        </main>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
