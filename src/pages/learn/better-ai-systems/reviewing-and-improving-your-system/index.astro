    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }

  .review-card > span {
    color: var(--lime);
    font-size: 0.6rem;
    font-weight: 800;
  }

  .review-card h3 {
    margin-top: 19px;
    font-size: 1rem;
  }

