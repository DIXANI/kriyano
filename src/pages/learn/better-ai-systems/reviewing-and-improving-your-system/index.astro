    margin-top: 10px;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.68;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 13px;
    margin-top: 35px;
  }

  .metric-grid article {
    padding: 25px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }

  .metric-grid article > span {
    color: var(--lime);
    font-size: 0.57rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .metric-grid h3 {
    margin-top: 17px;
    font-size: 1rem;
