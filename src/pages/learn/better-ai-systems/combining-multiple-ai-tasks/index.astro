  }

  .principle-card h3,
  .handoff-grid h3,
  .mistake-grid h3 {
    margin-top: 19px;
    font-size: 1rem;
  }

  .principle-card p,
  .handoff-grid p,
  .mistake-grid p {
    margin-top: 10px;
