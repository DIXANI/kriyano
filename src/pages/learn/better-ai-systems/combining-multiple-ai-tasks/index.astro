  }

  .chain-number {
    color: var(--muted);
    font-size: 0.6rem;
    font-weight: 800;
  }

  .chain-main > span {
    color: var(--lime);
    font-size: 0.54rem;
    font-weight: 800;
    letter-spacing: 0.07em;
  }

  .chain-main h3 {
    margin-top: 7px;
    font-size: 0.9rem;
  }

  .chain-detail small {
    color: var(--lime);
    font-size: 0.52rem;
    font-weight: 800;
    letter-spacing: 0.07em;
  }

  .chain-detail p {
    margin-top: 7px;
    color: var(--muted);
    font-size: 0.71rem;
    line-height: 1.55;
  }

  .chain-visual {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 13px;
    margin-top: 28px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }

  .chain-visual strong {
    font-size: 0.68rem;
  }

  .chain-visual span {
