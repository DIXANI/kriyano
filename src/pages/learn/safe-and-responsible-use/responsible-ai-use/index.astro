    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 13px;
    margin-top: 35px;
  }

  .risk-card {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }

  .risk-card > span {
    color: var(--lime);
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

