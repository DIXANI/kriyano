    margin-top: 22px;
    font-size: clamp(3.5rem, 7vw, 6.6rem);
    line-height: 0.94;
    letter-spacing: -0.065em;
  }

  .article-heading h1 span {
    display: block;
    color: var(--lime);
  }

  .article-intro {
    max-width: 760px;
    margin-top: 27px;
