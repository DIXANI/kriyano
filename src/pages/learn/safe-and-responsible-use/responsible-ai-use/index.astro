---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const principles = [
  {
    number: "01",
    title: "Use AI with a clear purpose",
    text:
      "Start with a defined task. AI should support a useful objective rather than being added to a process simply because the technology is available.",
  },
  {
    number: "02",
    title: "Protect information",
    text:
      "Share only the information required for the task and follow applicable privacy, confidentiality, security and workplace rules.",
  },
  {
    number: "03",
    title: "Verify important output",
    text:
      "Treat generated claims, calculations, recommendations and references as material to review—not automatically as verified facts.",
  },
  {
    number: "04",
    title: "Keep human judgement",
    text:
      "People should remain responsible for decisions that require context, experience, accountability or consideration of consequences.",
  },
  {
    number: "05",
    title: "Respect rights and sources",
    text:
      "Consider copyright, licences, attribution, permissions and originality when AI is used with existing creative or professional material.",
  },
  {
    number: "06",
    title: "Take responsibility for the result",
    text:
      "Using AI does not transfer responsibility for what you publish, send, approve or act upon. The final user remains responsible for appropriate review.",
  },
];

const riskQuestions = [
  {
    label: "IMPACT",
    question: "What happens if the AI output is wrong?",
  },
  {
    label: "DATA",
    question: "What information am I giving the AI system?",
  },
  {
    label: "EVIDENCE",
    question: "Which parts of the output require independent verification?",
  },
  {
    label: "PEOPLE",
    question: "Could this output affect another person's rights, opportunities or treatment?",
  },
  {
    label: "AUTHORITY",
    question: "Am I using AI to support a decision or allowing it to make the decision?",
  },
  {
    label: "ACCOUNTABILITY",
    question: "Who is responsible for reviewing and approving the final result?",
  },
];

const riskLevels = [
  {
    level: "LOWER RISK",
    title: "Drafting & brainstorming",
    examples:
      "Generating ideas, improving wording, creating generic checklists or producing first drafts that will be reviewed.",
    review:
      "Normal human review may be sufficient, depending on the information involved.",
  },
  {
    level: "MODERATE RISK",
    title: "Analysis & recommendations",
    examples:
      "Summarising operational information, analysing trends, comparing options or producing recommendations that may influence work.",
    review:
      "Verify data, assumptions and conclusions before using the output.",
  },
  {
    level: "HIGHER RISK",
    title: "Important decisions",
    examples:
      "Decisions involving safety, employment, legal rights, significant financial consequences, security or other high-impact outcomes.",
    review:
      "AI should not replace appropriate qualified human judgement, controls or professional review.",
  },
];

const humanResponsibilities = [
  {
    title: "Define the task",
    text:
      "Decide what problem AI should help solve and what should remain outside the AI workflow.",
  },
  {
    title: "Control the input",
    text:
      "Choose what information is appropriate to provide and remove unnecessary sensitive data.",
  },
  {
    title: "Challenge the output",
    text:
      "Look for unsupported assumptions, factual errors, missing context and overly confident conclusions.",
  },
  {
    title: "Apply context",
    text:
      "Bring workplace knowledge, professional experience, policy and real-world constraints into the decision.",
  },
  {
    title: "Approve the action",
    text:
      "A responsible person should decide whether the output is suitable to send, publish or act upon.",
  },
  {
    title: "Learn from outcomes",
    text:
      "Review mistakes and successful uses so prompts, controls and workflows improve over time.",
  },
];

const workflow = [
  {
    stage: "DEFINE",
    title: "Set the purpose",
    text:
      "Be clear about the task, desired result and the role AI should play.",
  },
  {
    stage: "ASSESS",
    title: "Consider the risk",
    text:
      "Think about the information involved, possible errors and consequences of a poor output.",
  },
  {
    stage: "PROTECT",
    title: "Control the information",
    text:
      "Use only appropriate data and follow privacy, confidentiality and workplace requirements.",
  },
  {
    stage: "GENERATE",
    title: "Use AI as an assistant",
    text:
      "Give clear instructions, context and constraints while keeping the AI's role appropriately limited.",
  },
  {
    stage: "VERIFY",
    title: "Check important claims",
    text:
      "Verify facts, numbers, sources and assumptions according to the risk of the task.",
  },
  {
    stage: "DECIDE",
    title: "Apply human judgement",
    text:
      "Consider context and consequences before accepting the output or taking action.",
  },
  {
    stage: "REVIEW",
    title: "Improve the system",
    text:
      "Use outcomes and mistakes to improve future prompts, workflows and controls.",
  },
];

const pathLessons = [
  "17 — What Not to Share With AI",
  "18 — AI & Workplace Information",
  "19 — Copyright & AI Content",
  "20 — Responsible AI Use",
];
---

<BaseLayout
  title="Responsible AI Use | KRIYANO"
  description="Learn a practical framework for responsible AI use that combines privacy, accuracy, human judgement, copyright awareness, risk assessment and accountability."
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>SAFE &amp; RESPONSIBLE USE</span>
            <span>20</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            Responsible
            <span>AI Use.</span>
          </h1>

          <p class="article-intro">
            Responsible AI use is not one rule or one safety check. It is a
            working discipline that combines clear purpose, appropriate data,
            verification, human judgement and accountability throughout the
            AI-assisted workflow.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 20</span>
            <span>SAFE &amp; RESPONSIBLE USE</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">AI ASSISTS. PEOPLE REMAIN RESPONSIBLE.</span>

            <strong>
              The stronger the consequence, the stronger the human review
              should be.
            </strong>

            <p>
              Responsible AI means matching the level of verification,
              oversight and information control to the risk of the task.
            </p>
          </div>

          <div class="panel-footer">
            <span>ASSESS → PROTECT → VERIFY → DECIDE</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#principle">The core principle</a>
            <a href="#principles">Six practical principles</a>
            <a href="#risk">Think about risk</a>
            <a href="#judgement">Human responsibility</a>
            <a href="#example">Workplace example</a>
            <a href="#workflow">Responsible AI workflow</a>
            <a href="#takeaway">The practical takeaway</a>
            <a href="#complete">Complete the path</a>
          </div>
        </aside>

        <main class="article-content">
          <section id="principle">
            <div class="section-marker">01 / THE CORE PRINCIPLE</div>

            <h2>Responsible AI use changes with the consequences of the task.</h2>

            <p>
              Asking AI for ten headline ideas is different from using AI to
              recommend an action that affects safety, employment, money or
              another person's rights. The technology may be similar, but the
              required level of oversight is not.
            </p>

            <p>
              A practical approach is therefore risk-based: as the possible
              consequences increase, so should verification, human review and
              control over the information being used.
            </p>

            <div class="concept-box">
              <span>CORE PRINCIPLE</span>
              <p>
                Match the level of human oversight to the potential impact of
                getting the AI-assisted decision wrong.
              </p>
            </div>
          </section>

          <section id="principles">
            <div class="section-marker">02 / SIX PRACTICAL PRINCIPLES</div>

            <h2>Good AI use requires more than a good prompt.</h2>

            <div class="principle-grid">
              {
                principles.map((item) => (
                  <article class="principle-card">
                    <span>{item.number}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="risk">
            <div class="section-marker">03 / THINK ABOUT RISK</div>

            <h2>Before trusting the output, consider what is at stake.</h2>

            <div class="question-list">
              {
                riskQuestions.map((item, index) => (
                  <article class="question-row">
                    <div class="question-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div>
                      <span>{item.label}</span>
                      <h3>{item.question}</h3>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="risk-grid">
              {
                riskLevels.map((item) => (
                  <article class="risk-card">
                    <span>{item.level}</span>
                    <h3>{item.title}</h3>

                    <div>
                      <small>EXAMPLES</small>
                      <p>{item.examples}</p>
                    </div>

                    <div>
                      <small>REVIEW</small>
                      <p>{item.review}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="warning-box">
              <span>IMPORTANT</span>
              <p>
                Risk depends on context. The same AI output may be harmless as
                an internal draft but inappropriate if it is used directly to
                make an important decision without review.
              </p>
            </div>
          </section>

          <section id="judgement">
            <div class="section-marker">04 / HUMAN RESPONSIBILITY</div>

            <h2>Human review should add judgement—not just approval.</h2>

            <p>
              Clicking approve without examining the reasoning is not meaningful
              oversight. Human review should challenge the AI output, apply
              context and determine whether the result is appropriate for the
              real situation.
            </p>

            <div class="responsibility-grid">
              {
                humanResponsibilities.map((item, index) => (
                  <article>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>

            <div class="decision-box">
              <span>HUMAN-IN-THE-LOOP</span>
              <p>
                The goal is not to manually redo everything AI produces. The
                goal is to place meaningful human judgement at the points where
                errors or poor decisions could matter.
              </p>
            </div>
          </section>

          <section id="example">
            <div class="section-marker">05 / WORKPLACE EXAMPLE</div>

            <h2>AI identifies a possible cause of a warehouse stock variance.</h2>

            <div class="case-box">
              <div class="case-header">
                <span>SCENARIO</span>
                <strong>Inventory discrepancy investigation</strong>
              </div>

              <div class="case-data">
                <div>
                  <small>SYSTEM</small>
                  <strong>2,460</strong>
                </div>

                <div>
                  <small>PHYSICAL</small>
                  <strong>2,417</strong>
                </div>

                <div>
                  <small>VARIANCE</small>
                  <strong>-43</strong>
                </div>
              </div>

              <p>
                After reviewing a limited set of transaction information, the
                AI suggests that an outbound processing error is the most likely
                cause.
              </p>
            </div>

            <div class="comparison-grid">
              <article>
                <span>UNRESPONSIBLE RESPONSE</span>
                <h3>Accept the explanation as the confirmed root cause.</h3>
                <p>
                  The AI may have identified a plausible pattern, but a plausible
                  explanation is not evidence that the cause has been proven.
                </p>
              </article>

              <article>
                <span>RESPONSIBLE RESPONSE</span>
                <h3>Treat the suggestion as an investigation lead.</h3>
                <p>
                  Review outbound records, receiving records, adjustments,
                  movements, count accuracy and other relevant evidence before
                  confirming the cause.
                </p>
              </article>
            </div>

            <div class="investigation-flow">
              <span>AI SUGGESTION</span>
              <strong>Possible outbound processing issue</strong>
              <span class="arrow">→</span>
              <span>HUMAN VERIFICATION</span>
              <strong>Check supporting records</strong>
              <span class="arrow">→</span>
              <span>DECISION</span>
              <strong>Confirm, reject or keep unresolved</strong>
            </div>

            <div class="concept-box">
              <span>WHY THIS MATTERS</span>
              <p>
                AI can accelerate investigation by helping identify what to
                check. It should not convert an unverified possibility into a
                confirmed operational fact.
              </p>
            </div>
          </section>

          <section id="workflow">
            <div class="section-marker">06 / RESPONSIBLE AI WORKFLOW</div>

            <h2>Build responsibility into the process instead of adding it at the end.</h2>

            <div class="workflow-list">
              {
                workflow.map((item, index) => (
                  <article class="workflow-row">
                    <div class="workflow-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div>
                      <span>{item.stage}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="workflow-summary">
              <span>RESPONSIBLE AI</span>

              <div>
                <strong>Purpose</strong>
                <span>+</span>
                <strong>Protection</strong>
                <span>+</span>
                <strong>Verification</strong>
                <span>+</span>
                <strong>Judgement</strong>
                <span>+</span>
                <strong>Accountability</strong>
              </div>
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">07 / PRACTICAL TAKEAWAY</div>

            <h2>Use AI to strengthen human work—not to remove responsibility from it.</h2>

            <p>
              Responsible AI use means knowing what AI is doing, protecting the
              information involved, verifying important output and keeping
              meaningful human judgement around consequential decisions.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Purpose</strong>
                <p>Know why AI is being used.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Protect</strong>
                <p>Control information and access.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>Verify</strong>
                <p>Check what matters.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Decide</strong>
                <p>Keep human accountability.</p>
              </div>
            </div>
          </section>

          <section id="complete" class="completion-box">
            <span class="completion-kicker">LEARNING PATH COMPLETE</span>

            <h2>Safe &amp; Responsible Use</h2>

            <p>
              You have completed the four KRIYANO guides covering practical
              information protection, workplace AI, copyright awareness and
              responsible AI use.
            </p>

            <div class="completion-lessons">
              {
                pathLessons.map((lesson) => (
                  <div>
                    <span>✓</span>
                    <strong>{lesson}</strong>
                  </div>
                ))
              }
            </div>
          </section>

          <section class="next-lesson">
            <div>
              <span class="next-label">NEXT LEARNING PATH</span>

              <h2>Better AI Systems</h2>

              <p>
                Move from individual AI tasks to reusable prompt templates,
                structured workflows and better systems for repeated work.
              </p>
            </div>

            <span class="next-status">COMING NEXT →</span>
          </section>
        </main>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-page {
    overflow: hidden;
  }

  .article-hero {
    padding: 92px 0 82px;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 82% 20%, rgba(183, 255, 74, 0.08), transparent 27%),
      radial-gradient(circle at 14% 0%, rgba(77, 226, 197, 0.055), transparent 28%);
  }

  .article-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 75px;
    align-items: end;
  }

  .back-link {
    color: var(--lime);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 28px;
  }

