    margin-top: 17px;
    font-size: 1rem;
  }

  .risk-card div {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .risk-card small {
    color: var(--lime);
    font-size: 0.53rem;
    font-weight: 800;
    letter-spacing: 0.07em;
  }

  .risk-card p {
    margin-top: 7px;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .case-box {
    margin-top: 35px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 17px;
    background: var(--surface);
  }

  .case-header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--line);
  }

  .case-header span {
    color: var(--lime);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .case-header strong {
    font-size: 0.74rem;
  }

  .case-data {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--line);
  }

  .case-data div {
    padding: 24px;
