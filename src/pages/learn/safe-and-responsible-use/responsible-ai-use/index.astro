    display: grid;
    grid-template-columns: 55px 1fr;
    gap: 22px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .question-number {
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 800;
  }

