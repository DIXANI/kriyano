    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .sidebar-title {
    padding: 16px 0;
    color: var(--lime);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .sidebar-box a {
    padding: 11px 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

