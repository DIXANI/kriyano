    margin-top: 36px;
  }

  .source-grid {
    margin-top: 13px;
  }

  .principle-card,
  .source-card,
  .originality-grid article {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }

  .principle-card > span,
  .source-card > span,
  .originality-grid article > span {
    color: var(--lime);
    font-size: 0.59rem;
    font-weight: 800;
    letter-spacing: 0.07em;
  }

  .principle-card h3,
  .source-card h3,
  .originality-grid h3 {
    margin-top: 18px;
    font-size: 1rem;
  }

  .principle-card p,
  .source-card p,
  .originality-grid p {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.68;
  }

  .task-list {
    margin-top: 35px;
    border-top: 1px solid var(--line);
  }

  .task-row {
    display: grid;
    grid-template-columns: 45px 185px 1fr;
    gap: 22px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .task-number {
    color: var(--muted);
    font-size: 0.61rem;
    font-weight: 800;
  }

  .task-name span,
  .task-approach span {
    color: var(--lime);
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .task-name h3 {
    margin-top: 8px;
    font-size: 0.93rem;
  }

  .task-approach p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.65;
  }

  .formula-box {
    margin-top: 25px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }

  .formula-box > span {
    color: var(--lime);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .formula-box > div {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
    align-items: center;
    margin-top: 20px;
  }

  .formula-box strong {
    font-size: 0.79rem;
  }

  .formula-box div span {
    color: var(--mint);
  }

  .review-list {
    margin-top: 35px;
    border-top: 1px solid var(--line);
  }

  .review-list article {
    display: grid;
    grid-template-columns: 55px 1fr;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .review-list span {
    color: var(--lime);
    font-size: 0.61rem;
    font-weight: 800;
  }

  .review-list strong {
    font-size: 0.84rem;
    line-height: 1.5;
  }

