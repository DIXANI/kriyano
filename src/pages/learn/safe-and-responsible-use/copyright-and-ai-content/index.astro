    display: block;
    color: var(--lime);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .panel-content strong {
    display: block;
    margin-top: 20px;
    font-size: 1.45rem;
    line-height: 1.35;
    letter-spacing: -0.035em;
  }

  .panel-content p {
    margin-top: 17px;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .panel-footer {
    padding: 17px 20px;
    border-top: 1px solid var(--line);
    background: rgba(183, 255, 74, 0.03);
    color: var(--lime);
    font-size: 0.59rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .article-body-section {
    padding: 88px 0 110px;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 235px minmax(0, 800px);
    gap: 78px;
    justify-content: center;
  }

  .sidebar-box {
    position: sticky;
    top: 105px;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .sidebar-title {
    padding: 16px 0;
    color: var(--lime);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .sidebar-box a {
    padding: 11px 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .sidebar-box a:hover {
    color: var(--lime);
  }

  .article-content > section:not(:first-child) {
    margin-top: 90px;
  }

  .section-marker {
    color: var(--lime);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .article-content h2 {
    max-width: 760px;
    margin-top: 14px;
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.052em;
  }

  .article-content > section > p {
    max-width: 760px;
    margin-top: 23px;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.85;
  }

  .concept-box,
  .warning-box,
  .decision-box {
    margin: 34px 0;
    padding: 27px;
    border: 1px solid rgba(183, 255, 74, 0.18);
    border-radius: 16px;
    background: rgba(183, 255, 74, 0.035);
  }

  .concept-box > span,
  .warning-box > span,
  .decision-box > span {
    color: var(--lime);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .concept-box p,
  .warning-box p,
  .decision-box p {
