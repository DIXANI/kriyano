---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

import { createLearnSchema } from "../../../../utils/learnSchema";

const articleTitle = "AI & Workplace Information | KRIYANO";

const articleDescription =
  "Learn how to use AI responsibly with workplace information by understanding public, internal and confidential data and applying appropriate controls.";

const schema = createLearnSchema({
  title: "AI & Workplace Information",
  description: articleDescription,
  pathName: "Safe & Responsible Use",
  pathSlug: "safe-and-responsible-use",
  articleSlug: "ai-and-workplace-information",
});

const workplaceData = [
  {
    number: "01",
    title: "Public information",
    text:
      "Information already approved for public use—such as published product information, public policies or official marketing material—is generally lower risk than internal company data.",
  },
  {
    number: "02",
    title: "Internal information",
    text:
      "SOPs, operational reports, meeting notes, internal procedures and performance information may not be secret, but they can still be restricted to employees or approved systems.",
  },
  {
    number: "03",
    title: "Confidential information",
    text:
      "Contracts, commercial terms, customer records, employee information, investigations, forecasts and unreleased plans may require stronger controls.",
  },
  {
    number: "04",
    title: "Restricted information",
    text:
      "Credentials, security information, highly sensitive personal data, protected records and other restricted material should only be handled through specifically authorised systems and processes.",
  },
];

const commonTasks = [
  {
    task: "Writing an email",
    question: "Does the draft require real customer, employee or commercial details?",
    safer:
      "Describe the situation or use placeholders when the identity is not required.",
  },
  {
    task: "Summarising a document",
    question: "Is the document approved for use with this AI system?",
    safer:
      "Remove unnecessary confidential sections or use an approved enterprise environment.",
  },
  {
    task: "Analysing operational data",
    question: "Does the analysis require names, IDs or complete transaction records?",
    safer:
      "Use only the fields and records required for the analysis.",
  },
  {
    task: "Creating a report",
    question: "Could the prompt reveal internal incidents, performance or business information?",
    safer:
      "Provide verified, minimised facts and keep sensitive supporting records outside the prompt.",
  },
  {
    task: "Reviewing a contract",
    question: "Are the commercial terms or parties confidential?",
    safer:
      "Follow company policy and use only an approved AI environment if the document is permitted.",
  },
  {
    task: "Troubleshooting",
    question: "Could logs, screenshots or code contain credentials or internal architecture?",
    safer:
      "Remove secrets, tokens, identifying details and unnecessary system information first.",
  },
];

const approvalQuestions = [
  "Is this AI tool approved by my organisation?",
  "What type of workplace information is permitted?",
  "Does the organisation have an AI or data-handling policy?",
  "Does the task require the original document or only selected facts?",
  "Can sensitive information be removed before processing?",
  "Does a manager, IT, legal, compliance or data owner need to approve this use?",
];

const workflow = [
  {
    stage: "CLASSIFY",
    title: "Understand the information",
    text:
      "Determine whether the material is public, internal, confidential or restricted before deciding how AI can be used.",
  },
  {
    stage: "CHECK",
    title: "Confirm the rules",
    text:
      "Check organisational policies, approved AI tools and any requirements that apply to the information.",
  },
  {
    stage: "MINIMISE",
    title: "Reduce the input",
    text:
      "Remove information that is not necessary for the specific AI task.",
  },
  {
    stage: "PROTECT",
    title: "Redact sensitive details",
    text:
      "Replace names, identifiers, credentials and confidential values when the task can be completed without them.",
  },
  {
    stage: "REVIEW",
    title: "Inspect before submission",
    text:
      "Read the prompt and attachments again before sending workplace information to an AI system.",
  },
  {
    stage: "VERIFY",
    title: "Review the output",
    text:
      "Check generated work for factual errors, unintended disclosure and information that should not appear in the final document.",
  },
];

const scenarios = [
  {
    label: "LOWER RISK",
    title: "Drafting from generic information",
    text:
      "You ask AI to create a warehouse toolbox-meeting template using generic topics such as safety, workload, staffing and equipment.",
    action:
      "No real employee, customer or confidential operational information is required.",
  },
  {
    label: "REQUIRES CARE",
    title: "Analysing an internal variance report",
    text:
      "You want AI to identify possible patterns from a report containing SKU data, customer information, employee names and transaction details.",
    action:
      "Confirm that the tool is approved and remove information that is unnecessary for the analysis.",
  },
  {
    label: "HIGH RISK",
    title: "Uploading restricted company records",
    text:
      "You plan to upload confidential contracts, credentials, private employee records or security information to a public AI service.",
    action:
      "Do not proceed unless the organisation has specifically authorised the system and use case.",
  },
];
---

<BaseLayout
  title={articleTitle}
  description={articleDescription}
  schema={schema}
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>SAFE &amp; RESPONSIBLE USE</span>
            <span>18</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            AI &amp; Workplace
            <span>Information.</span>
          </h1>

          <p class="article-intro">
            AI can help with emails, reports, analysis and documentation, but
            workplace information belongs inside organisational rules. Before
            using company data with AI, understand what the information is,
            whether the tool is approved and how much data the task actually
            requires.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 18</span>
            <span>SAFE &amp; RESPONSIBLE USE</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">WORKPLACE DATA NEEDS WORKPLACE RULES</span>

            <strong>
              Convenience does not override company policy or data
              responsibility.
            </strong>

            <p>
              The safest workflow combines approved tools, data minimisation,
              appropriate access and human review.
            </p>
          </div>

          <div class="panel-footer">
            <span>CLASSIFY → CHECK → MINIMISE → REVIEW</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#responsibility">The responsibility</a>
            <a href="#classification">Classify workplace data</a>
            <a href="#tasks">Common AI tasks</a>
            <a href="#approval">Check before using AI</a>
            <a href="#scenarios">Three workplace scenarios</a>
            <a href="#example">Warehouse example</a>
            <a href="#workflow">Responsible workflow</a>
            <a href="#takeaway">The practical takeaway</a>
          </div>
        </aside>

        <article class="article-content">
          <section id="responsibility">
            <div class="section-marker">01 / THE RESPONSIBILITY</div>

            <h2>Workplace information is not automatically yours to share.</h2>

            <p>
              Employees regularly work with information they are authorised to
              access. That does not necessarily mean the same information can
              be copied into any external AI service.
            </p>

            <p>
              Your organisation may have requirements covering confidentiality,
              privacy, approved software, document handling, customer
              information and security. Those requirements still apply when AI
              is involved.
            </p>

            <div class="concept-box">
              <span>CORE PRINCIPLE</span>
              <p>
                Permission to access workplace information is not automatically
                permission to enter it into an AI system.
              </p>
            </div>
          </section>

          <section id="classification">
            <div class="section-marker">02 / CLASSIFY WORKPLACE DATA</div>

            <h2>Understand the information before choosing how to use it.</h2>

            <div class="classification-grid">
              {
                workplaceData.map((item) => (
                  <article class="classification-card">
                    <span>{item.number}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>

            <div class="warning-box">
              <span>IMPORTANT</span>
              <p>
                Classification rules differ between organisations. Use your
                employer's actual policy rather than assuming that a particular
                category is safe to share.
              </p>
            </div>
          </section>

          <section id="tasks">
            <div class="section-marker">03 / COMMON AI TASKS</div>

            <h2>The task may be ordinary while the information is sensitive.</h2>

            <div class="task-list">
              {
                commonTasks.map((item) => (
                  <article class="task-card">
                    <div class="task-heading">
                      <span>TASK</span>
                      <h3>{item.task}</h3>
                    </div>

                    <div>
                      <span class="mini-label">ASK FIRST</span>
                      <p>{item.question}</p>
                    </div>

                    <div>
                      <span class="mini-label">SAFER APPROACH</span>
                      <p>{item.safer}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="approval">
            <div class="section-marker">04 / CHECK BEFORE USING AI</div>

            <h2>When workplace data is involved, know the rules first.</h2>

            <div class="approval-list">
              {
                approvalQuestions.map((item, index) => (
                  <article>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{item}</strong>
                  </article>
                ))
              }
            </div>

            <div class="decision-box">
              <span>WHEN YOU ARE UNSURE</span>
              <p>
                Do not guess. Check the relevant company policy or ask the
                appropriate manager, IT, legal, compliance or data owner before
                sharing the information with AI.
              </p>
            </div>
          </section>

          <section id="scenarios">
            <div class="section-marker">05 / THREE WORKPLACE SCENARIOS</div>

            <h2>The same AI tool can involve very different levels of risk.</h2>

            <div class="scenario-grid">
              {
                scenarios.map((item) => (
                  <article class="scenario-card">
                    <span>{item.label}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>

                    <div class="scenario-action">
                      <small>APPROACH</small>
                      <p>{item.action}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="example">
            <div class="section-marker">06 / WORKPLACE EXAMPLE</div>

            <h2>You want AI to help analyse recurring stock discrepancies.</h2>

            <div class="case-box">
              <div class="case-header">
                <span>AVAILABLE INFORMATION</span>
                <strong>Internal warehouse records</strong>
              </div>

              <ul>
                <li>SKU and item descriptions</li>
                <li>System and physical quantities</li>
                <li>Customer names and account references</li>
                <li>Employee names and IDs</li>
                <li>Receiving and outbound transaction history</li>
                <li>Internal investigation notes</li>
              </ul>
            </div>

            <div class="example-grid">
              <article>
                <span>QUESTION 01</span>
                <h3>What does the analysis actually require?</h3>
                <p>
                  To identify a recurring variance pattern, AI may need SKU,
                  date, system quantity, physical quantity, variance and
                  transaction category—but not necessarily customer or employee
                  identities.
                </p>
              </article>

              <article>
                <span>QUESTION 02</span>
                <h3>Is the AI environment approved?</h3>
                <p>
                  Even after unnecessary fields are removed, company policy may
                  determine whether operational records can be processed by the
                  selected AI system.
                </p>
              </article>
            </div>

            <div class="minimised-box">
              <span>MINIMISED ANALYSIS DATA</span>

              <div class="data-row data-header">
                <strong>DATE</strong>
                <strong>SKU</strong>
                <strong>SYSTEM</strong>
                <strong>PHYSICAL</strong>
                <strong>VARIANCE</strong>
              </div>

              <div class="data-row">
                <span>03 Sep</span>
                <span>SKU-A</span>
                <span>1,780</span>
                <span>1,753</span>
                <span>-27</span>
              </div>

              <div class="data-row">
                <span>18 Aug</span>
                <span>SKU-A</span>
                <span>1,420</span>
                <span>1,411</span>
                <span>-9</span>
              </div>

              <div class="data-row">
                <span>02 Aug</span>
                <span>SKU-A</span>
                <span>980</span>
                <span>976</span>
                <span>-4</span>
              </div>
            </div>

            <div class="concept-box">
              <span>LESS INFORMATION, SAME TASK</span>
              <p>
                Removing unnecessary identities and unrelated fields can reduce
                exposure while preserving the information needed for the
                analysis.
              </p>
            </div>
          </section>

          <section id="workflow">
            <div class="section-marker">07 / RESPONSIBLE WORKFLOW</div>

            <h2>Make information handling part of the AI workflow.</h2>

            <div class="workflow-list">
              {
                workflow.map((item, index) => (
                  <article class="workflow-row">
                    <div class="workflow-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div>
                      <span>{item.stage}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">08 / PRACTICAL TAKEAWAY</div>

            <h2>Responsible workplace AI starts with information control.</h2>

            <p>
              AI can improve productivity without requiring uncontrolled access
              to company information. Classify the data, follow organisational
              policy, minimise what you provide and keep human review around
              both the input and the output.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Classify</strong>
                <p>Know what you're handling.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Authorise</strong>
                <p>Use approved systems.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>Minimise</strong>
                <p>Share only what's needed.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Review</strong>
                <p>Check input and output.</p>
              </div>
            </div>
          </section>

          <section class="next-lesson">
            <div>
              <span class="next-label">CONTINUE LEARNING</span>

              <h2>Copyright &amp; AI Content</h2>

              <p>
                Learn why AI-generated content does not remove copyright
                considerations and how to use source material more carefully.
              </p>
            </div>

            <a
  href="/learn/safe-and-responsible-use/copyright-and-ai-content/"
  class="next-status"
>
  CONTINUE →
</a>
          </section>
        </article>
      </div>
    </section>
  </article>
</BaseLayout>

