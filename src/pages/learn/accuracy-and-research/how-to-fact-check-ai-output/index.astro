---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const factCheckSteps = [
  {
    number: "01",
    title: "Separate claims from presentation",
    text:
      "Identify which parts of the AI output are factual statements, calculations, dates, names, conclusions or references that can actually be checked.",
  },
  {
    number: "02",
    title: "Prioritise important claims",
    text:
      "Do not spend equal effort on every sentence. Check the claims that could change a decision, action, report, payment, approval or external communication.",
  },
  {
    number: "03",
    title: "Find the original source",
    text:
      "Whenever possible, verify against the original document, official system, policy, record, website, dataset or other primary evidence.",
  },
  {
    number: "04",
    title: "Check the exact detail",
    text:
      "Compare the specific number, date, wording, condition or conclusion instead of only checking whether the general topic sounds correct.",
  },
  {
    number: "05",
    title: "Resolve conflicts",
    text:
      "If two sources disagree, do not choose the answer that looks more convincing. Identify which source is current, authoritative and relevant to the exact question.",
  },
  {
    number: "06",
    title: "Record uncertainty",
    text:
      "If a claim cannot be confirmed, keep it clearly marked as unverified instead of converting uncertainty into a confident statement.",
  },
];

const sourceHierarchy = [
  {
    level: "STRONGEST",
    title: "Primary or official evidence",
    text:
      "Original documents, system records, contracts, policies, government sources, official statistics, authorised reports or direct source material.",
  },
  {
    level: "STRONG",
    title: "Reliable secondary sources",
    text:
      "Well-established publications, professional references, recognised research institutions or reputable industry sources that clearly identify their evidence.",
  },
  {
    level: "USE WITH CARE",
    title: "General web content",
    text:
      "Blogs, summaries, forums, social posts and unsourced articles may still be useful for discovery but should not automatically be treated as proof.",
  },
  {
    level: "NOT EVIDENCE",
    title: "The AI answer itself",
    text:
      "AI can help locate, organise or explain information, but its own generated statement is not independent confirmation of the claim.",
  },
];

const numberChecks = [
  "Recalculate totals and differences independently.",
  "Confirm units, currencies, percentages and date ranges.",
  "Check whether values were copied correctly from the source.",
  "Verify that the calculation uses the right inputs.",
  "Look for rounding or sign errors.",
  "Confirm that percentages use the correct denominator.",
];

const citationChecks = [
  "Does the source actually exist?",
  "Does the title match the real document or page?",
  "Does the source contain the claim being attributed to it?",
  "Is the publication date relevant?",
  "Is the cited section current or outdated?",
  "Is the source authoritative enough for the decision?",
];

const workflow = [
  {
    stage: "CLAIM",
    title: "What exactly is AI saying?",
    text:
      "Rewrite the important statement as a simple checkable claim before searching for evidence.",
  },
  {
    stage: "SOURCE",
    title: "What evidence should prove it?",
    text:
      "Identify the record, document, official page or trusted reference that should contain the answer.",
  },
  {
    stage: "COMPARE",
    title: "Does the evidence match?",
    text:
      "Check the exact wording, number, date, condition or conclusion against the source.",
  },
  {
    stage: "CLASSIFY",
    title: "Verified, wrong or unresolved?",
    text:
      "Do not force every claim into true or false. Some information may remain incomplete or unresolved.",
  },
  {
    stage: "CORRECT",
    title: "Update the final output",
    text:
      "Remove unsupported content, correct inaccurate details and preserve uncertainty where evidence is insufficient.",
  },
];

const resultTypes = [
  {
    status: "VERIFIED",
    title: "The evidence supports the claim.",
    text:
      "The statement can remain, provided the source is appropriate for the intended use.",
  },
  {
    status: "INCORRECT",
    title: "The evidence contradicts the claim.",
    text:
      "Correct the statement before using the output and check whether related conclusions also need revision.",
  },
  {
    status: "UNRESOLVED",
    title: "There is not enough evidence.",
    text:
      "Do not guess. Mark the point as unconfirmed and identify what additional information is required.",
  },
];
---

<BaseLayout
  title="How to Fact-Check AI Output | KRIYANO"
  description="Learn a practical method for fact-checking AI-generated claims, numbers, citations and conclusions using reliable sources and human review."
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>ACCURACY &amp; RESEARCH</span>
            <span>14</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            How to Fact-Check
            <span>AI Output.</span>
          </h1>

          <p class="article-intro">
            Fact-checking AI does not mean rereading the answer more carefully.
            It means identifying important claims, tracing them to reliable
            evidence and correcting anything that cannot be supported.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 14</span>
            <span>ACCURACY &amp; RESEARCH</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">CHECK THE CLAIM, NOT THE CONFIDENCE</span>

            <strong>
              The strongest fact-check is independent of the AI answer.
            </strong>

            <p>
              A statement becomes trustworthy because reliable evidence
              supports it, not because the AI repeats it confidently.
            </p>
          </div>

          <div class="panel-footer">
            <span>CLAIM → SOURCE → VERIFY → CORRECT</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#fact-checking">What fact-checking means</a>
            <a href="#process">Six-step process</a>
            <a href="#sources">Source quality</a>
            <a href="#numbers">Checking numbers</a>
            <a href="#citations">Checking citations</a>
            <a href="#workplace-example">Workplace example</a>
            <a href="#workflow">Verification workflow</a>
            <a href="#takeaway">The practical takeaway</a>
          </div>
        </aside>

        <main class="article-content">
          <section id="fact-checking">
            <div class="section-marker">01 / WHAT FACT-CHECKING MEANS</div>

            <h2>Fact-checking is evidence comparison, not visual inspection.</h2>

            <p>
              An AI response can look professional, structured and detailed
              while still containing factual errors. Reading it again may help
              you notice obvious problems, but it does not independently
              confirm the information.
            </p>

            <p>
              A proper fact-check compares a specific claim against evidence
              that exists outside the generated answer.
            </p>

            <div class="concept-box">
              <span>SIMPLE RULE</span>
              <p>
                If the claim matters, ask: “What independent evidence would
                prove this statement?”
              </p>
            </div>
          </section>

          <section id="process">
            <div class="section-marker">02 / SIX-STEP PROCESS</div>

            <h2>Use a repeatable process instead of checking randomly.</h2>

            <div class="step-grid">
              {
                factCheckSteps.map((item) => (
                  <article class="step-card">
                    <span>{item.number}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>

            <div class="decision-box">
              <span>EFFICIENCY MATTERS</span>
              <p>
                Not every sentence needs the same level of verification. Spend
                the most effort on claims with the highest consequence if they
                are wrong.
              </p>
            </div>
          </section>

          <section id="sources">
            <div class="section-marker">03 / SOURCE QUALITY</div>

            <h2>Not all sources provide the same level of evidence.</h2>

            <p>
              Fact-checking is not simply finding another webpage that says the
              same thing. The quality and authority of the source matter.
            </p>

            <div class="source-stack">
              {
                sourceHierarchy.map((item) => (
                  <article class="source-card">
                    <div>
                      <span>{item.level}</span>
                      <h3>{item.title}</h3>
                    </div>

                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>

            <div class="warning-box">
              <span>MULTIPLE WEAK SOURCES DO NOT CREATE STRONG EVIDENCE</span>
              <p>
                Several websites may repeat the same incorrect or unsourced
                information. Prefer the original or most authoritative source
                whenever it is available.
              </p>
            </div>
          </section>

          <section id="numbers">
            <div class="section-marker">04 / CHECKING NUMBERS</div>

            <h2>Numbers deserve independent verification.</h2>

            <p>
              AI can make arithmetic errors, copy values incorrectly, mix units
              or calculate the right formula using the wrong inputs.
            </p>

            <div class="number-example">
              <div class="number-header">
                <span>EXAMPLE</span>
                <strong>Inventory variance</strong>
              </div>

              <div class="number-values">
                <div>
                  <span>SYSTEM</span>
                  <strong>2,450</strong>
                </div>

                <div>
                  <span>PHYSICAL</span>
                  <strong>2,401</strong>
                </div>

                <div>
                  <span>AI STATES DIFFERENCE</span>
                  <strong>59</strong>
                </div>
              </div>

              <div class="number-result">
                <span>INDEPENDENT CHECK</span>
                <strong>2,450 − 2,401 = 49</strong>
                <p>
                  The explanation could be excellent while the central number
                  is still wrong.
                </p>
              </div>
            </div>

            <div class="check-list">
              {
                numberChecks.map((item, index) => (
                  <div class="check-row">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{item}</strong>
                  </div>
                ))
              }
            </div>
          </section>

          <section id="citations">
            <div class="section-marker">05 / CHECKING CITATIONS</div>

            <h2>A citation should be checked at the source itself.</h2>

            <p>
              When AI provides a document, article, study, regulation or
              website as support, do not assume that the reference exists or
              supports the statement simply because it looks credible.
            </p>

            <div class="citation-box">
              <span>CITATION CHECK</span>

              <div class="citation-list">
                {
                  citationChecks.map((item) => (
                    <div>
                      <span>→</span>
                      <p>{item}</p>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="concept-box">
              <span>IMPORTANT</span>
              <p>
                Even a real source can be cited incorrectly. Always check
                whether the actual source supports the exact claim being made.
              </p>
            </div>
          </section>

          <section id="workplace-example">
            <div class="section-marker">06 / WORKPLACE EXAMPLE</div>

            <h2>Fact-check an AI-generated stock investigation summary.</h2>

            <div class="case-card">
              <div class="case-header">
                <span>AI-GENERATED CLAIM</span>
                <strong>Stock discrepancy investigation</strong>
              </div>

              <blockquote>
                “The 36-unit shortage occurred because one receiving document
                was entered with an incorrect quantity on 18 August.”
              </blockquote>
            </div>

            <div class="evidence-grid">
              <article>
                <span>01 / SHORTAGE</span>
                <h3>Check the quantity.</h3>
                <p>
                  System quantity: 1,760. Physical quantity: 1,724. Independent
                  calculation confirms a 36-unit shortage.
                </p>
                <strong>VERIFIED</strong>
              </article>

              <article>
                <span>02 / RECEIVING ERROR</span>
                <h3>Check the transaction records.</h3>
                <p>
                  Receiving records were reviewed, but none currently proves
                  that an incorrect receiving quantity caused the difference.
                </p>
                <strong>UNRESOLVED</strong>
              </article>

              <article>
                <span>03 / DATE</span>
                <h3>Check the claimed date.</h3>
                <p>
                  No verified evidence supplied in the investigation identifies
                  18 August as the date of the discrepancy.
                </p>
                <strong>UNSUPPORTED</strong>
              </article>
            </div>

            <div class="corrected-output">
              <span>CORRECTED VERSION</span>

              <p>
                “A 36-unit shortage has been confirmed between the system and
                physical quantity. Receiving records have been reviewed, but
                the available evidence does not yet confirm the root cause or
                establish 18 August as the date of the error. Further
                investigation is required.”
              </p>
            </div>
          </section>

          <section id="workflow">
            <div class="section-marker">07 / VERIFICATION WORKFLOW</div>

            <h2>Classify the result after checking the evidence.</h2>

            <div class="workflow-list">
              {
                workflow.map((item, index) => (
                  <article class="workflow-row">
                    <div class="workflow-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div>
                      <span>{item.stage}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="result-grid">
              {
                resultTypes.map((item) => (
                  <article>
                    <span>{item.status}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">08 / PRACTICAL TAKEAWAY</div>

            <h2>Fact-check the parts of AI output that could change what you do.</h2>

            <p>
              Good fact-checking is selective, evidence-based and repeatable.
              Identify important claims, verify them with the strongest
              available source, correct errors and preserve uncertainty where
              the evidence is incomplete.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Extract</strong>
                <p>Identify important claims.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Source</strong>
                <p>Find independent evidence.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>Compare</strong>
                <p>Check the exact detail.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Correct</strong>
                <p>Fix or mark unresolved.</p>
              </div>
            </div>

            <div class="tool-callout">
              <div>
                <span class="tool-kicker">BETTER RESEARCH PROMPTS</span>

                <h3>Make verification part of the instruction.</h3>

                <p>
                  Ask AI to separate verified facts, assumptions and unresolved
                  questions. This makes the final review easier and reduces the
                  chance that uncertainty disappears inside polished writing.
                </p>
              </div>

              <a href="/tools/prompt-builder/" class="button button-primary">
                Open Prompt Builder
              </a>
            </div>
          </section>

          <section class="next-lesson">
            <div>
              <span class="next-label">NEXT LESSON</span>

              <h2>Evaluating Sources</h2>

              <p>
                Learn how to judge whether a source is authoritative, relevant,
                current and strong enough to support an AI-assisted research
                task.
              </p>
            </div>

            <a
  href="/learn/accuracy-and-research/evaluating-sources/"
  class="next-status"
>
  CONTINUE →
</a>
          </section>
        </main>
      </div>
    </section>
  </article>
</BaseLayout>

