---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const sourceCriteria = [
  {
    number: "01",
    title: "Authority",
    text:
      "Who created the information? Check the organisation, author, publisher or institution behind the source and whether they are qualified to speak on the topic.",
  },
  {
    number: "02",
    title: "Relevance",
    text:
      "A trustworthy source can still be the wrong source for your question. Check whether it directly addresses the specific issue, location, industry, date or decision you are researching.",
  },
  {
    number: "03",
    title: "Currency",
    text:
      "Some information changes quickly. Check when the source was published or updated and whether newer guidance, data, prices, regulations or policies may now apply.",
  },
  {
    number: "04",
    title: "Evidence",
    text:
      "Strong sources usually show where their claims come from through data, documents, references, methodology, records or other verifiable evidence.",
  },
  {
    number: "05",
    title: "Purpose",
    text:
      "Understand why the content exists. A source designed to inform may need different scrutiny from one designed to sell, persuade, promote or attract attention.",
  },
  {
    number: "06",
    title: "Consistency",
    text:
      "Compare important claims with other reliable evidence, especially when one source makes an unusual, high-impact or surprising statement.",
  },
];

const sourceTypes = [
  {
    label: "PRIMARY SOURCE",
    title: "Original evidence",
    examples:
      "Policies, contracts, government publications, official statistics, transaction records, research papers, company filings and direct documentation.",
    use:
      "Usually the strongest place to verify a specific factual claim when the original material is available.",
  },
  {
    label: "SECONDARY SOURCE",
    title: "Analysis or interpretation",
    examples:
      "Professional publications, reputable news reporting, industry analysis, textbooks and expert commentary.",
    use:
      "Useful for explanation, comparison and context, especially when the source clearly identifies its underlying evidence.",
  },
  {
    label: "DISCOVERY SOURCE",
    title: "Useful for finding leads",
    examples:
      "Blogs, forums, social posts, community discussions, videos and general web articles.",
    use:
      "Can help identify terminology, questions, experiences or possible sources, but important claims should normally be checked elsewhere.",
  },
];

const redFlags = [
  "No author, organisation or publication information is visible.",
  "The source makes strong claims without showing evidence.",
  "The page is old but discusses information that changes frequently.",
  "The headline is more dramatic than the evidence provided.",
  "Statistics appear without a definition, date, methodology or original source.",
  "The source copies another article instead of linking to original evidence.",
  "Commercial promotion is presented as neutral research.",
  "The source does not distinguish fact, opinion and speculation.",
];

const researchQuestions = [
  {
    question: "Who produced this?",
    reason: "Establish authority and accountability.",
  },
  {
    question: "What evidence supports it?",
    reason: "Separate supported claims from assertions.",
  },
  {
    question: "When was it published or updated?",
    reason: "Check whether the information is still current.",
  },
  {
    question: "Does it answer my exact question?",
    reason: "Avoid using broadly related evidence for a specific claim.",
  },
  {
    question: "Can I trace the claim to an original source?",
    reason: "Reduce dependence on repeated or distorted information.",
  },
  {
    question: "What would happen if this source were wrong?",
    reason: "Match verification effort to the consequence of error.",
  },
];

const comparisonRows = [
  {
    criterion: "Authority",
    weak: "Unnamed blog author",
    stronger: "Official government department",
  },
  {
    criterion: "Evidence",
    weak: "Claims with no supporting documents",
    stronger: "Published data and methodology",
  },
  {
    criterion: "Currency",
    weak: "Old article on a changing regulation",
    stronger: "Current official guidance",
  },
  {
    criterion: "Purpose",
    weak: "Sales page presenting promotional claims",
    stronger: "Independent technical documentation",
  },
  {
    criterion: "Traceability",
    weak: "Repeats statistics from another website",
    stronger: "Links to the original dataset",
  },
];

const workflow = [
  {
    stage: "FIND",
    title: "Locate possible sources",
    text:
      "Use search, AI or existing references to identify sources that may contain the information you need.",
  },
  {
    stage: "FILTER",
    title: "Remove obviously weak sources",
    text:
      "Check authority, relevance, date, evidence and purpose before spending time reading deeply.",
  },
  {
    stage: "TRACE",
    title: "Move toward original evidence",
    text:
      "Follow citations, links and references until you reach the strongest available source behind the claim.",
  },
  {
    stage: "COMPARE",
    title: "Check important claims",
    text:
      "Compare the source against other reliable evidence when the claim is important, disputed or high consequence.",
  },
  {
    stage: "USE",
    title: "Match the source to the decision",
    text:
      "Decide whether the evidence is strong enough for drafting, research, recommendation or formal action.",
  },
];
---

<BaseLayout
  title="Evaluating Sources | KRIYANO"
  description="Learn how to evaluate sources for authority, relevance, currency, evidence and reliability when using AI for research and real work."
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>ACCURACY &amp; RESEARCH</span>
            <span>15</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            Evaluating
            <span>Sources.</span>
          </h1>

          <p class="article-intro">
            Finding a source is not enough. Good research depends on knowing
            whether that source is authoritative, relevant, current and strong
            enough to support the claim you want to make.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 15</span>
            <span>ACCURACY &amp; RESEARCH</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">SOURCE QUALITY CHANGES THE ANSWER</span>

            <strong>
              Reliable research depends on the quality of the evidence behind
              it.
            </strong>

            <p>
              AI can help you find and organise information, but you still need
              to judge whether the source deserves your trust.
            </p>
          </div>

          <div class="panel-footer">
            <span>AUTHORITY → EVIDENCE → RELEVANCE → USE</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#source-quality">Why source quality matters</a>
            <a href="#criteria">Six evaluation criteria</a>
            <a href="#source-types">Source types</a>
            <a href="#red-flags">Warning signs</a>
            <a href="#comparison">Weak vs stronger sources</a>
            <a href="#workplace-example">Workplace example</a>
            <a href="#workflow">Evaluation workflow</a>
            <a href="#takeaway">The practical takeaway</a>
          </div>
        </aside>

        <main class="article-content">
          <section id="source-quality">
            <div class="section-marker">01 / WHY SOURCE QUALITY MATTERS</div>

            <h2>A source can be real and still be unsuitable.</h2>

            <p>
              One of the most common research mistakes is treating every source
              as equally useful. A webpage may exist, an article may look
              professional and a document may contain the right keywords, but
              none of that automatically makes it strong evidence.
            </p>

            <p>
              The right source depends on the claim you are checking and what
              you plan to do with the information.
            </p>

            <div class="concept-box">
              <span>KEY PRINCIPLE</span>
              <p>
                Do not ask only, “Is this source credible?” Also ask, “Is this
                source strong enough for this specific claim and decision?”
              </p>
            </div>
          </section>

          <section id="criteria">
            <div class="section-marker">02 / SIX EVALUATION CRITERIA</div>

            <h2>Evaluate the source before relying on the information.</h2>

            <div class="criteria-grid">
              {
                sourceCriteria.map((item) => (
                  <article class="criteria-card">
                    <span>{item.number}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>

            <div class="decision-box">
              <span>NO SINGLE TEST IS ENOUGH</span>
              <p>
                A source may be authoritative but outdated, current but
                irrelevant, or detailed but unsupported. Evaluate several
                dimensions together.
              </p>
            </div>
          </section>

          <section id="source-types">
            <div class="section-marker">03 / SOURCE TYPES</div>

            <h2>Different sources serve different research purposes.</h2>

            <div class="source-type-stack">
              {
                sourceTypes.map((item) => (
                  <article class="source-type-card">
                    <div class="source-type-heading">
                      <span>{item.label}</span>
                      <h3>{item.title}</h3>
                    </div>

                    <div>
                      <span class="mini-label">EXAMPLES</span>
                      <p>{item.examples}</p>
                    </div>

                    <div>
                      <span class="mini-label">BEST USE</span>
                      <p>{item.use}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="concept-box">
              <span>PRIMARY DOES NOT ALWAYS MEAN PERFECT</span>
              <p>
                Original sources can still contain errors, limitations or bias.
                Their advantage is that you are closer to the evidence and can
                inspect it directly.
              </p>
            </div>
          </section>

          <section id="red-flags">
            <div class="section-marker">04 / WARNING SIGNS</div>

            <h2>Weak sources often reveal themselves through predictable signals.</h2>

            <div class="red-flag-list">
              {
                redFlags.map((item, index) => (
                  <div class="red-flag-row">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{item}</strong>
                  </div>
                ))
              }
            </div>

            <div class="warning-box">
              <span>POPULARITY IS NOT AUTHORITY</span>
              <p>
                Search ranking, social engagement, shares and repeated mentions
                do not prove that a source is accurate.
              </p>
            </div>
          </section>

          <section id="comparison">
            <div class="section-marker">05 / SOURCE COMPARISON</div>

            <h2>Compare sources using evidence quality, not appearance.</h2>

            <div class="comparison-table">
              <div class="comparison-header">
                <span>CRITERION</span>
                <span>WEAKER EXAMPLE</span>
                <span>STRONGER EXAMPLE</span>
              </div>

              {
                comparisonRows.map((row) => (
                  <div class="comparison-row">
                    <strong>{row.criterion}</strong>
                    <p>{row.weak}</p>
                    <p>{row.stronger}</p>
                  </div>
                ))
              }
            </div>
          </section>

          <section id="workplace-example">
            <div class="section-marker">06 / WORKPLACE EXAMPLE</div>

            <h2>Imagine you need to confirm a warehouse storage requirement.</h2>

            <div class="case-box">
              <span>RESEARCH QUESTION</span>
              <p>
                “What storage temperature should be used for this product?”
              </p>
            </div>

            <div class="source-example-grid">
              <article>
                <span>SOURCE A</span>
                <h3>Online discussion forum</h3>
                <p>
                  A user says their warehouse normally stores the product at a
                  particular temperature.
                </p>

                <div class="source-rating">
                  <strong>USEFUL FOR</strong>
                  <p>Finding practical questions or possible issues.</p>
                </div>

                <div class="source-rating">
                  <strong>LIMITATION</strong>
                  <p>
                    The information may apply to a different product,
                    specification or operating environment.
                  </p>
                </div>
              </article>

              <article>
                <span>SOURCE B</span>
                <h3>Supplier product specification</h3>
                <p>
                  The current official specification identifies the required
                  storage conditions for the exact product.
                </p>

                <div class="source-rating">
                  <strong>USEFUL FOR</strong>
                  <p>Verifying the product-specific requirement.</p>
                </div>

                <div class="source-rating">
                  <strong>STRENGTH</strong>
                  <p>
                    Directly relevant to the exact product and issued by the
                    responsible supplier.
                  </p>
                </div>
              </article>
            </div>

            <div class="corrected-output">
              <span>BETTER RESEARCH DECISION</span>

              <p>
                Use the supplier's current product specification as the primary
                evidence for the storage requirement. The forum discussion may
                still help identify operational questions, but it should not
                override the official specification.
              </p>
            </div>
          </section>

          <section id="workflow">
            <div class="section-marker">07 / EVALUATION WORKFLOW</div>

            <h2>Move from discovery toward stronger evidence.</h2>

            <div class="workflow-list">
              {
                workflow.map((item, index) => (
                  <article class="workflow-row">
                    <div class="workflow-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div>
                      <span>{item.stage}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <h3 class="subheading">Six questions before you trust a source</h3>

            <div class="question-list">
              {
                researchQuestions.map((item, index) => (
                  <article>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <div>
                      <strong>{item.question}</strong>
                      <p>{item.reason}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">08 / PRACTICAL TAKEAWAY</div>

            <h2>Use AI to discover sources, but evaluate the evidence yourself.</h2>

            <p>
              AI can make research faster by suggesting search directions,
              summarising documents and helping organise findings. But source
              quality still determines whether the final conclusion deserves
              confidence.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Find</strong>
                <p>Locate possible sources.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Evaluate</strong>
                <p>Check source quality.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>Trace</strong>
                <p>Reach original evidence.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Use</strong>
                <p>Match evidence to decision.</p>
              </div>
            </div>

            <div class="tool-callout">
              <div>
                <span class="tool-kicker">RESEARCH WITH BETTER STRUCTURE</span>

                <h3>Ask AI to separate sources from conclusions.</h3>

                <p>
                  A useful research prompt can require AI to identify the claim,
                  source, source type, publication date, supporting evidence and
                  any uncertainty before presenting a conclusion.
                </p>
              </div>

              <a href="/tools/prompt-builder/" class="button button-primary">
                Open Prompt Builder
              </a>
            </div>
          </section>

          <section class="next-lesson">
            <div>
              <span class="next-label">NEXT LESSON</span>

              <h2>AI-Assisted Research</h2>

              <p>
                Learn how to use AI as part of a structured research workflow
                without confusing generated summaries with verified evidence.
              </p>
            </div>

            <a
  href="/learn/accuracy-and-research/ai-assisted-research/"
  class="next-status"
>
  CONTINUE →
</a>
          </section>
        </main>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
