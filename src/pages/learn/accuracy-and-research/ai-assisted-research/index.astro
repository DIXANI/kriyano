---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { createLearnSchema } from "../../../../utils/learnSchema";

const articleTitle = "AI-Assisted Research | KRIYANO";

const articleDescription =
  "Learn how to use AI for research by defining clear questions, gathering relevant information, evaluating sources, verifying claims and producing useful research outputs.";

const schema = createLearnSchema({
  title: "AI-Assisted Research",
  description: articleDescription,
  pathName: "Accuracy & Research",
  pathSlug: "accuracy-and-research",
  articleSlug: "ai-assisted-research",
});
const researchStages = [
  {
    number: "01",
    title: "Define the question",
    text:
      "Start with a clear research question. AI works better when the topic, scope, time period, location and intended decision are defined before searching begins.",
  },
  {
    number: "02",
    title: "Identify what must be verified",
    text:
      "Separate the research question into facts, numbers, definitions, policies, comparisons and assumptions that may require different types of evidence.",
  },
  {
    number: "03",
    title: "Use AI for discovery",
    text:
      "Ask AI to suggest search terms, relevant source types, sub-questions and possible evidence locations without treating those suggestions as verified facts.",
  },
  {
    number: "04",
    title: "Collect reliable sources",
    text:
      "Move from discovery toward primary, official or otherwise authoritative sources that directly support the important claims.",
  },
  {
    number: "05",
    title: "Use AI to organise evidence",
    text:
      "AI can help summarise documents, compare findings, create tables, identify disagreements and organise notes after the source material is available.",
  },
  {
    number: "06",
    title: "Verify the final conclusion",
    text:
      "Before using the research, check that the conclusion accurately reflects the strongest available evidence and clearly preserves any uncertainty.",
  },
];

const goodUses = [
  {
    title: "Breaking down a broad question",
    text:
      "AI can turn a large research topic into smaller questions that are easier to investigate.",
  },
  {
    title: "Generating search directions",
    text:
      "AI can suggest terminology, alternative phrases and source categories that may improve the search process.",
  },
  {
    title: "Summarising supplied material",
    text:
      "When you provide a document or trusted source, AI can help extract key points, compare sections and create structured notes.",
  },
  {
    title: "Comparing evidence",
    text:
      "AI can organise information from several sources into categories, similarities, differences, risks and unresolved questions.",
  },
  {
    title: "Finding gaps",
    text:
      "AI can help identify what information is still missing before a conclusion is made.",
  },
  {
    title: "Drafting the final structure",
    text:
      "Once the evidence is verified, AI can help turn research notes into a clear report, summary, recommendation or presentation outline.",
  },
];

const badUses = [
  "Treating an AI-generated summary as the original source.",
  "Accepting citations without opening and checking them.",
  "Asking AI to decide which facts are true without independent evidence.",
  "Using one source simply because AI ranked it first.",
  "Allowing AI to fill missing evidence with assumptions.",
  "Presenting generated research as verified when the supporting sources were never reviewed.",
];

const researchPromptParts = [
  {
    label: "QUESTION",
    example: "What exactly am I trying to find out?",
  },
  {
    label: "SCOPE",
    example: "Which country, industry, product, period or situation applies?",
  },
  {
    label: "EVIDENCE",
    example: "What type of sources should support the answer?",
  },
  {
    label: "OUTPUT",
    example: "How should findings be organised?",
  },
  {
    label: "UNCERTAINTY",
    example: "How should missing or conflicting information be shown?",
  },
  {
    label: "BOUNDARY",
    example: "What must AI avoid assuming or inventing?",
  },
];

const researchWorkflow = [
  {
    stage: "QUESTION",
    title: "Define the decision or information need",
    text:
      "A focused question prevents research from becoming a collection of loosely related information.",
  },
  {
    stage: "DISCOVER",
    title: "Use AI to expand the search",
    text:
      "Generate keywords, sub-questions and possible source categories.",
  },
  {
    stage: "SOURCE",
    title: "Collect evidence independently",
    text:
      "Open and review the actual sources rather than relying on AI descriptions of them.",
  },
  {
    stage: "ANALYSE",
    title: "Use AI to organise the evidence",
    text:
      "Summarise, compare, classify and identify gaps while keeping the original sources available for checking.",
  },
  {
    stage: "VERIFY",
    title: "Check important claims",
    text:
      "Trace conclusions back to the evidence and correct unsupported statements.",
  },
  {
    stage: "DELIVER",
    title: "Create the final output",
    text:
      "Use the verified findings to prepare the report, recommendation, briefing or next action.",
  },
];

const evidenceStatus = [
  {
    status: "VERIFIED",
    title: "Supported by reliable evidence",
    text:
      "The claim has been checked against an appropriate source.",
  },
  {
    status: "PARTIALLY VERIFIED",
    title: "Some evidence exists",
    text:
      "Part of the statement is supported, but additional checking is still required.",
  },
  {
    status: "UNRESOLVED",
    title: "Evidence is insufficient",
    text:
      "The research does not currently support a firm conclusion.",
  },
];
---

<BaseLayout
  title={articleTitle}
  description={articleDescription}
  schema={schema}
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div class="article-heading">
          <a href="/learn/" class="back-link">← LEARN</a>

          <div class="article-meta">
            <span>ACCURACY &amp; RESEARCH</span>
            <span>16</span>
            <span>BEGINNER</span>
          </div>

          <h1>
            AI-Assisted
            <span>Research.</span>
          </h1>

          <p class="article-intro">
            AI can make research faster, but it should support the research
            process rather than replace evidence. The strongest workflow uses
            AI for discovery, organisation and drafting while keeping source
            verification and final judgment under human control.
          </p>
        </div>

        <aside class="lesson-panel">
          <div class="panel-header">
            <span>LESSON 16</span>
            <span>ACCURACY &amp; RESEARCH</span>
          </div>

          <div class="panel-content">
            <span class="panel-kicker">AI ASSISTS. EVIDENCE DECIDES.</span>

            <strong>
              Use AI to move through research faster without giving up source
              control.
            </strong>

            <p>
              The goal is not to ask AI for a final answer and trust it. The
              goal is to build a research process where important claims can be
              traced back to reliable evidence.
            </p>
          </div>

          <div class="panel-footer">
            <span>QUESTION → DISCOVER → SOURCE → VERIFY</span>
          </div>
        </aside>
      </div>
    </header>

    <section class="article-body-section">
      <div class="container article-layout">
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <span class="sidebar-title">IN THIS GUIDE</span>

            <a href="#role">AI's role in research</a>
            <a href="#stages">Six research stages</a>
            <a href="#good-uses">Where AI helps</a>
            <a href="#bad-uses">Where AI creates risk</a>
            <a href="#prompting">Research prompts</a>
            <a href="#workplace-example">Workplace example</a>
            <a href="#workflow">Research workflow</a>
            <a href="#takeaway">The practical takeaway</a>
          </div>
        </aside>

        <article class="article-content">
          <section id="role">
            <div class="section-marker">01 / AI'S ROLE IN RESEARCH</div>

            <h2>AI should support the path to evidence, not replace it.</h2>

            <p>
              AI can be extremely useful during research because it can help you
              understand a topic, generate questions, organise material and
              compare information quickly.
            </p>

            <p>
              The risk begins when generated output is treated as if it were a
              verified source. A strong research process keeps a clear
              distinction between what AI generated and what the evidence
              actually proves.
            </p>

            <div class="concept-box">
              <span>CORE PRINCIPLE</span>
              <p>
                Use AI to help you find, understand and organise evidence. Do
                not use AI output as a substitute for the evidence itself.
              </p>
            </div>
          </section>

          <section id="stages">
            <div class="section-marker">02 / SIX RESEARCH STAGES</div>

            <h2>Build research as a process, not a single prompt.</h2>

            <div class="stage-grid">
              {
                researchStages.map((item) => (
                  <article class="stage-card">
                    <span>{item.number}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>

            <div class="decision-box">
              <span>THE IMPORTANT SHIFT</span>
              <p>
                Instead of asking AI, “What is the answer?”, ask how AI can
                help you reach a better-supported answer.
              </p>
            </div>
          </section>

          <section id="good-uses">
            <div class="section-marker">03 / WHERE AI HELPS</div>

            <h2>AI is strongest when it reduces research effort without becoming the source of truth.</h2>

            <div class="use-grid">
              {
                goodUses.map((item, index) => (
                  <article class="use-card">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="bad-uses">
            <div class="section-marker">04 / WHERE AI CREATES RISK</div>

            <h2>Research becomes unreliable when AI is allowed to hide missing evidence.</h2>

            <div class="risk-list">
              {
                badUses.map((item, index) => (
                  <div class="risk-row">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{item}</strong>
                  </div>
                ))
              }
            </div>

            <div class="warning-box">
              <span>WATCH FOR FALSE COMPLETENESS</span>
              <p>
                AI is good at producing a complete-looking answer. Research is
                often incomplete. A trustworthy workflow must allow unresolved
                questions to remain unresolved until evidence is available.
              </p>
            </div>
          </section>

          <section id="prompting">
            <div class="section-marker">05 / RESEARCH PROMPTS</div>

            <h2>A good research prompt defines both the task and the evidence boundaries.</h2>

            <div class="prompt-parts">
              {
                researchPromptParts.map((item) => (
                  <article>
                    <span>{item.label}</span>
                    <p>{item.example}</p>
                  </article>
                ))
              }
            </div>

            <div class="prompt-example">
              <span>EXAMPLE RESEARCH INSTRUCTION</span>

              <p>
                “Help me research this issue. First break the question into
                smaller research questions. Suggest the types of reliable
                sources I should check. Do not invent facts or citations.
                Clearly separate verified information, assumptions and
                unresolved questions. When I provide source material, base the
                analysis only on that evidence.”
              </p>
            </div>

            <div class="concept-box">
              <span>USEFUL BOUNDARY</span>
              <p>
                When the source material matters, tell AI explicitly to work
                only from the provided evidence and to identify anything the
                evidence does not support.
              </p>
            </div>
          </section>

          <section id="workplace-example">
            <div class="section-marker">06 / WORKPLACE EXAMPLE</div>

            <h2>Research whether an inventory problem is isolated or recurring.</h2>

            <div class="case-box">
              <div class="case-header">
                <span>RESEARCH QUESTION</span>
                <strong>Inventory discrepancy pattern</strong>
              </div>

              <p>
                “Several discrepancies have been reported for the same SKU.
                Is there enough evidence to conclude that the problem is
                recurring?”
              </p>
            </div>

            <div class="research-sequence">
              <article>
                <span>STEP 01 / DEFINE</span>
                <h3>Clarify the question.</h3>
                <p>
                  Determine the period being reviewed, the SKU, locations,
                  discrepancy threshold and what qualifies as a recurring
                  pattern.
                </p>
              </article>

              <article>
                <span>STEP 02 / COLLECT</span>
                <h3>Gather source records.</h3>
                <p>
                  Retrieve verified stock-count results, system inventory,
                  transaction history, adjustment records and investigation
                  notes for the selected period.
                </p>
              </article>

              <article>
                <span>STEP 03 / ORGANISE</span>
                <h3>Use AI to structure the evidence.</h3>
                <p>
                  Ask AI to create a table showing dates, system quantities,
                  physical quantities, variance and investigation status using
                  only the supplied records.
                </p>
              </article>

              <article>
                <span>STEP 04 / ANALYSE</span>
                <h3>Look for repeated patterns.</h3>
                <p>
                  AI can help identify repeated locations, transaction types,
                  timing or variance direction, but each pattern should still
                  be checked against the records.
                </p>
              </article>

              <article>
                <span>STEP 05 / CONCLUDE</span>
                <h3>Match the conclusion to the evidence.</h3>
                <p>
                  If the records show repeated verified discrepancies, describe
                  the pattern. If the evidence is incomplete, state that more
                  data is required.
                </p>
              </article>
            </div>

            <div class="output-comparison">
              <article>
                <span>WEAK CONCLUSION</span>
                <p>
                  “The SKU has a recurring receiving problem that is causing
                  inventory shortages.”
                </p>
                <strong>
                  Problem: a specific root cause has been stated without enough
                  evidence.
                </strong>
              </article>

              <article>
                <span>BETTER CONCLUSION</span>
                <p>
                  “Repeated discrepancies have been recorded for this SKU
                  during the reviewed period. The available records support the
                  existence of a recurring variance pattern, but they do not yet
                  confirm a single root cause.”
                </p>
                <strong>
                  Better: the conclusion stays within what the evidence
                  supports.
                </strong>
              </article>
            </div>
          </section>

          <section id="workflow">
            <div class="section-marker">07 / PRACTICAL RESEARCH WORKFLOW</div>

            <h2>Keep AI inside a controlled evidence workflow.</h2>

            <div class="workflow-list">
              {
                researchWorkflow.map((item, index) => (
                  <article class="workflow-row">
                    <div class="workflow-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div>
                      <span>{item.stage}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <h3 class="subheading">Classify the evidence before finalising</h3>

            <div class="status-grid">
              {
                evidenceStatus.map((item) => (
                  <article>
                    <span>{item.status}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="takeaway">
            <div class="section-marker">08 / PRACTICAL TAKEAWAY</div>

            <h2>Let AI accelerate the research process, not replace the research standard.</h2>

            <p>
              The best AI-assisted research combines fast discovery and
              organisation with strong source evaluation, fact-checking and
              human judgment. Keep evidence traceable from the research
              question through to the final conclusion.
            </p>

            <div class="takeaway-flow">
              <div>
                <span>01</span>
                <strong>Question</strong>
                <p>Define what matters.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>02</span>
                <strong>Discover</strong>
                <p>Use AI to explore.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>03</span>
                <strong>Verify</strong>
                <p>Check real evidence.</p>
              </div>

              <span class="flow-arrow">→</span>

              <div>
                <span>04</span>
                <strong>Conclude</strong>
                <p>Stay within the evidence.</p>
              </div>
            </div>

            <div class="tool-callout">
              <div>
                <span class="tool-kicker">VERIFY THE RESEARCH OUTPUT</span>

                <h3>Keep unsupported claims visible.</h3>

                <p>
                  KRIYANO CHECK compares an AI research answer with the sources you
                  supply and flags claims that are not supported by them. Treat it
                  as a review aid — you still decide what is good enough to use.
                </p>
              </div>

              <a href="/check/" class="button button-primary">
                Review output with CHECK
              </a>
            </div>
          </section>

          <section class="completion-box">
            <span class="completion-kicker">LEARNING PATH COMPLETE</span>

            <h2>Accuracy &amp; Research</h2>

            <p>
              You have completed the four guides in this learning path:
            </p>

            <div class="completion-lessons">
              <span>13 — Why AI Can Produce Wrong Answers</span>
              <span>14 — How to Fact-Check AI Output</span>
              <span>15 — Evaluating Sources</span>
              <span>16 — AI-Assisted Research</span>
            </div>
          </section>

          <section class="next-lesson">
            <div>
              <span class="next-label">NEXT LEARNING PATH</span>

              <h2>Safe &amp; Responsible Use</h2>

              <p>
                Learn what information should not be shared with AI, how to
                handle workplace data, and how to think about copyright and
                responsible AI use.
              </p>
            </div>

            <a
  href="/learn/safe-and-responsible-use/what-not-to-share-with-ai/"
  class="next-status"
>
  START PATH →
</a>
          </section>
        </article>
      </div>
    </section>
  </article>
</BaseLayout>

