---
import BaseLayout from "../../layouts/BaseLayout.astro";

const learningPaths = [
  {
    number: "01",
    level: "START HERE",
    title: "AI Fundamentals",

     status: "4 GUIDES AVAILABLE",
  

    
    description:
      "Understand what generative AI can do, where it struggles and how to use it realistically.",
    lessons: [
      {
    title: "What Generative AI Actually Does",
    href: "/learn/ai-fundamentals/what-generative-ai-actually-does/",
      },
      {
  title: "What AI Is Good At",
  href: "/learn/ai-fundamentals/what-ai-is-good-at/",
},
      {
  title: "Where AI Can Go Wrong",
  href: "/learn/ai-fundamentals/where-ai-can-go-wrong/",
},
      {
  title: "AI vs Human Judgment",
  href: "/learn/ai-fundamentals/ai-vs-human-judgment/",
  
}, 

    ],
    
  },
  {
    number: "02",
    level: "PRACTICAL",
    title: "Prompting Fundamentals",
    status: "4 GUIDES AVAILABLE",
    description:
      "Learn how clear instructions, context and constraints can produce more useful AI responses.",
    lessons: [
       {
    title: "Anatomy of a Good Prompt",
    href: "/learn/prompting-fundamentals/anatomy-of-a-good-prompt/",
  },
      {
  title: "How to Give AI Better Context",
  href: "/learn/prompting-fundamentals/how-to-give-ai-better-context/",
},
      {
  title: "Using Roles, Constraints & Examples",
  href: "/learn/prompting-fundamentals/using-roles-constraints-and-examples/",
},
      {
  title: "Improving a Weak Prompt",
  href: "/learn/prompting-fundamentals/improving-a-weak-prompt/",
},
    ],
  },
  {
    number: "03",
    level: "WORKFLOW",
    title: "Using AI for Real Work",

    status: "4 GUIDES AVAILABLE",
    description:
      "Move beyond one-off questions and build AI into practical, repeatable workflows.",
    lessons: [
      {
  title: "Choosing Tasks for AI",
  href: "/learn/using-ai-for-real-work/choosing-tasks-for-ai/",
},
      {
  title: "AI-Assisted Workflows",
  href: "/learn/using-ai-for-real-work/ai-assisted-workflows/",
},
      {
  title: "Human Review & Quality Control",
  href: "/learn/using-ai-for-real-work/human-review-and-quality-control/",
},
      {
  title: "Building Reusable Prompts",
  href: "/learn/using-ai-for-real-work/building-reusable-prompts/",
},
    ],
  },
  {
    number: "04",
    level: "VERIFY",
    title: "Accuracy & Research",
    status: "4 GUIDES AVAILABLE",
    description:
      "Learn why AI answers need verification and how to evaluate sources, claims and research.",
    lessons: [
      {
  title: "Why AI Can Produce Wrong Answers",
  href: "/learn/accuracy-and-research/why-ai-can-produce-wrong-answers/",
},
      {
  title: "How to Fact-Check AI Output",
  href: "/learn/accuracy-and-research/how-to-fact-check-ai-output/",
},
      {
  title: "Evaluating Sources",
  href: "/learn/accuracy-and-research/evaluating-sources/",
},
      {
  title: "AI-Assisted Research",
  href: "/learn/accuracy-and-research/ai-assisted-research/",
},
    ],
  },
  {
    number: "05",
    level: "RESPONSIBLE",
    title: "Safe & Responsible Use",
    status: "4 GUIDES AVAILABLE",
    description:
      "Understand privacy, sensitive information, copyright concerns and responsible workplace use.",
    lessons: [
      {
  title: "What Not to Share With AI",
  href: "/learn/safe-and-responsible-use/what-not-to-share-with-ai/",
},
      {
  title: "AI & Workplace Information",
  href: "/learn/safe-and-responsible-use/ai-and-workplace-information/",
},
      {
  title: "Copyright & AI Content",
  href: "/learn/safe-and-responsible-use/copyright-and-ai-content/",
},
      {
  title: "Responsible AI Use",
  href: "/learn/safe-and-responsible-use/responsible-ai-use/",
},
    ],
  },
  {
    number: "06",
    level: "ADVANCE",
    title: "Better AI Systems",
    status: "4 GUIDES AVAILABLE",
    description:
      "Turn useful prompting techniques into repeatable systems for work, business and content creation.",
    lessons: [
      {
  title: "Creating Prompt Templates",
  href: "/learn/better-ai-systems/creating-prompt-templates/",
},
      {
  title: "Building AI Workflows",
  href: "/learn/better-ai-systems/building-ai-workflows/",
},
      {
  title: "Combining Multiple AI Tasks",
  href: "/learn/better-ai-systems/combining-multiple-ai-tasks/",
},
      {
  title: "Reviewing & Improving Your System",
  href: "/learn/better-ai-systems/reviewing-and-improving-your-system/",
},
    ],
  },
];

const promptFormula = [
  {
    label: "TASK",
    text: "What exactly should AI do?",
  },
  {
    label: "CONTEXT",
    text: "What information does it need?",
  },
  {
    label: "OUTPUT",
    text: "What should the result look like?",
  },
  {
    label: "CONSTRAINTS",
    text: "What rules or limits should it follow?",
  },
  {
    label: "REVIEW",
    text: "What must you verify before using it?",
  },
];

const principles = [
  {
    number: "01",
    title: "Be specific",
    description:
      "Clear tasks and useful context usually produce better results than vague instructions.",
  },
  {
    number: "02",
    title: "Don't assume accuracy",
    description:
      "A confident AI response can still contain incorrect facts, weak reasoning or invented details.",
  },
  {
    number: "03",
    title: "Protect sensitive information",
    description:
      "Think carefully before entering confidential, personal or company information into an AI service.",
  },
  {
    number: "04",
    title: "Keep human judgment",
    description:
      "Use AI to assist thinking and execution—not to remove responsibility for important decisions.",
  },
];

const quickResources = [
  {
    label: "Build a better prompt",
    description:
      "Turn a rough task into a structured prompt.",
    href: "/tools/prompt-builder/",
  },
  {
    label: "Browse the Prompt Library",
    description:
      "Find ready-to-use prompts for practical tasks.",
    href: "/prompts/",
  },
  {
    label: "AI for Work",
    description:
      "Explore AI resources for everyday professional work.",
    href: "/ai-for-work/",
  },
  {
    label: "AI for Business",
    description:
      "Explore planning, research and operational use cases.",
    href: "/ai-for-business/",
  },
];
---

<BaseLayout
  title="Learn Practical AI | KRIYANO"
  description="Learn how to use AI more effectively for real work, including prompting, workflows, verification, research and responsible AI use."
>
  <section class="learn-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="section-kicker">LEARN PRACTICAL AI</div>

        <h1>
          Understand AI.
          <span>Then put it to work.</span>
        </h1>

        <p>
          Practical guides for using AI more effectively—from writing better
          prompts to building workflows, checking accuracy and using AI
          responsibly.
        </p>

        <div class="hero-actions">
          <a href="#learning-paths" class="button button-primary">
            Start learning
          </a>

          <a href="/tools/prompt-builder/" class="secondary-link">
            Try the Prompt Builder ↗
          </a>
        </div>
      </div>

      <div class="learning-map">
        <div class="map-header">
          <span>KRIYANO LEARNING PATH</span>
          <span class="map-status">START → APPLY</span>
        </div>

        <div class="map-body">
          <div class="map-step active">
            <span>01</span>
            <div>
              <strong>UNDERSTAND</strong>
              <p>Know what AI can and cannot do.</p>
            </div>
          </div>

          <div class="map-connector"></div>

          <div class="map-step">
            <span>02</span>
            <div>
              <strong>INSTRUCT</strong>
              <p>Give AI clearer tasks and context.</p>
            </div>
          </div>

          <div class="map-connector"></div>

          <div class="map-step">
            <span>03</span>
            <div>
              <strong>VERIFY</strong>
              <p>Check important facts and outputs.</p>
            </div>
          </div>

          <div class="map-connector"></div>

          <div class="map-step">
            <span>04</span>
            <div>
              <strong>APPLY</strong>
              <p>Build AI into useful workflows.</p>
            </div>
          </div>
        </div>

        <div class="map-footer">
          <span>PRINCIPLE</span>
          <strong>Learn → Test → Review → Improve</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="learn-strip">
    <div class="container strip-grid">
      <div>
        <strong>Beginner-friendly</strong>
        <span>Start without technical knowledge</span>
      </div>

      <div>
        <strong>Practical</strong>
        <span>Focused on real tasks</span>
      </div>

      <div>
        <strong>Responsible</strong>
        <span>Accuracy, privacy & review</span>
      </div>

      <div>
        <strong>Action-oriented</strong>
        <span>Learn something you can use</span>
      </div>
    </div>
  </section>

  <section class="section" id="learning-paths">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="section-kicker">Learning paths</div>

          <h2>
            Learn the skills
            behind useful AI.
          </h2>
        </div>

        <p>
          Start with the fundamentals and progress toward practical workflows.
          You do not need programming knowledge to use these concepts.
        </p>
      </div>

      <div class="learning-grid">
        {
          learningPaths.map((path) => (
            <article class="learning-card">
              <div class="card-top">
                <span class="card-number">{path.number}</span>
                <span class="level">{path.level}</span>
              </div>

              <h3>{path.title}</h3>

              <p>{path.description}</p>

              <div class="lesson-list">
  {
    path.lessons.map((lesson) =>
      typeof lesson === "string" ? (
        <div class="lesson-item">
          <span>→</span>
          <span>{lesson}</span>
        </div>
      ) : (
        <a href={lesson.href} class="lesson-item lesson-link">
          <span>→</span>
          <span>{lesson.title}</span>
        </a>
      )
    )
  }
</div>

             <div class="path-status">
            {path.status}
    </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="formula-section">
    <div class="container">
      <div class="formula-layout">
        <div class="formula-copy">
          <div class="section-kicker">A useful starting framework</div>

          <h2>
            Better prompts begin
            before you start typing.
          </h2>

          <p>
            You do not need a complicated formula for every prompt. But for
            important tasks, these five questions can dramatically improve the
            quality and usefulness of the response.
          </p>

          <a href="/tools/prompt-builder/" class="secondary-link">
            Build one with KRIYANO ↗
          </a>
        </div>

        <div class="formula-stack">
          {
            promptFormula.map((item, index) => (
              <div class="formula-row">
                <span class="formula-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div>
                  <strong>{item.label}</strong>
                  <p>{item.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="example-section">
    <div class="container">
      <div class="example-head">
        <div>
          <div class="section-kicker">Prompt transformation</div>

          <h2>
            Same AI.
            Better instruction.
          </h2>
        </div>

        <p>
          One of the easiest ways to improve AI output is to replace a vague
          request with a clear task, context and expected result.
        </p>
      </div>

      <div class="comparison-grid">
        <article class="comparison-card weak">
          <div class="comparison-label">
            <span>WEAK PROMPT</span>
            <span>01</span>
          </div>

          <blockquote>
            "Write an email about the stock problem."
          </blockquote>

          <div class="problem-list">
            <span>Missing audience</span>
            <span>Missing context</span>
            <span>Missing objective</span>
            <span>Missing output requirements</span>
          </div>
        </article>

        <article class="comparison-card strong">
          <div class="comparison-label">
            <span>IMPROVED PROMPT</span>
            <span>02</span>
          </div>

          <blockquote>
            "Write a concise professional email to the warehouse manager
            reporting a stock discrepancy. Explain that the physical count is
            24 units lower than the system quantity, state that transaction
            history is being reviewed, and request approval for a recount
            before any adjustment is made."
          </blockquote>

          <div class="strength-list">
            <span>✓ Clear task</span>
            <span>✓ Relevant context</span>
            <span>✓ Defined audience</span>
            <span>✓ Expected action</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="principles-section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="section-kicker">Four rules worth remembering</div>

          <h2>
            Useful AI still
            needs human judgment.
          </h2>
        </div>

        <p>
          AI can save time and improve structure, but responsible use means
          knowing where human checking and decision-making still matter.
        </p>
      </div>

      <div class="principles-grid">
        {
          principles.map((principle) => (
            <article class="principle-card">
              <span>{principle.number}</span>

              <h3>{principle.title}</h3>

              <p>{principle.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="resources-section">
    <div class="container">
      <div class="resources-layout">
        <div class="resources-copy">
          <div class="section-kicker">Learn by doing</div>

          <h2>
            Put the lesson
            into practice.
          </h2>

          <p>
            Learning AI becomes easier when you apply each concept to a real
            task. These KRIYANO resources give you somewhere practical to start.
          </p>
        </div>

        <div class="resource-links">
          {
            quickResources.map((resource) => (
              <a href={resource.href} class="resource-row">
                <div>
                  <strong>{resource.label}</strong>
                  <p>{resource.description}</p>
                </div>

                <span>↗</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="learn-cta">
    <div class="container">
      <div class="cta-box">
        <div>
          <div class="section-kicker">Ready to apply it?</div>

          <h2>
            Start with a real task.
          </h2>

          <p>
            Choose something you actually need to accomplish and use KRIYANO
            to turn it into a clearer, more structured AI prompt.
          </p>
        </div>

        <a href="/tools/prompt-builder/" class="button button-primary">
          Open Prompt Builder
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

