---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | KRIYANO"
  description="Contact KRIYANO for tool suggestions, bug reports, feedback or general enquiries."
>
  <section class="pt-[105px] pb-[90px] border-b border-line bg-[radial-gradient(circle_at_82%_22%,rgba(77,226,197,0.1),transparent_28%),var(--bg)]">
    <div class="container grid grid-cols-[minmax(0,1.1fr)_minmax(340px,0.9fr)] gap-x-[80px] items-center md:gap-x-[44px]">
      <div>
        <div class="section-kicker">Contact</div>
        <h1 class="mt-[16px] max-w-[760px] text-[clamp(3.2rem,7vw,6rem)] leading-[0.94] tracking-[-0.06em] md:text-[clamp(3rem,13vw,4.3rem)]">What would make your work easier?</h1>
        <p class="max-w-[680px] mt-[26px] text-muted text-[1.0625rem] leading-[1.75] md:text-[1rem] md:leading-[1.65]">Have a question, suggestion, partnership idea or feedback about KRIYANO? Get in touch and let us know how we can help.</p>
      </div>
      <div class="p-[34px] border border-[rgba(183,255,74,0.16)] rounded-[22px] bg-[linear-gradient(180deg,rgba(255,255,255,0.035),transparent),var(--surface)] md:p-[26px]">
        <span class="block mb-[12px] text-mint text-[0.7rem] font-black tracking-[0.12em] uppercase">Email</span>
        <a href="mailto:contact@kriyano.com" class="inline-block text-lime text-[clamp(1.5rem,3vw,2.2rem)] font-bold tracking-[-0.03em] no-underline hover:underline">contact@kriyano.com</a>
        <p class="mt-[18px] text-muted leading-[1.7]">For general enquiries, feedback, business enquiries or partnership discussions.</p>
      </div>
    </div>
  </section>

  <section class="py-[90px] md:py-[78px]">
    <div class="container">
      <div class="grid grid-cols-[repeat(3,1fr)] gap-[18px] md:grid-cols-1">
        {['General enquiries','Feedback','Business & partnerships'].map((title,i)=>(
          <article class="min-h-[240px] p-[28px] border border-line rounded-[18px] bg-surface md:min-h-auto md:p-[24px]">
            <span class="text-lime text-[0.7rem] font-black tracking-[0.1em]">{String(i+1).padStart(2,'0')}</span>
            <h2 class="mt-[36px] text-[1.3125rem] md:mt-[28px]">{title}</h2>
            <p class="mt-[14px] text-muted text-[0.9375rem] leading-[1.7]">
              {i===0 && 'Questions about KRIYANO, its developer tools, web utilities, legacy resources or website content.'}
              {i===1 && "Found something that could be improved or have an idea for a new developer tool, web utility or resource? We'd like to hear it."}
              {i===2 && 'For collaboration, affiliate, sponsorship or other business-related enquiries.'}
            </p>
          </article>
        ))}
      </div>
      <div class="max-w-[760px] mt-[70px] pt-[34px] border-t border-line md:mt-[52px]">
        <div class="section-kicker">Please note</div>
        <p class="mt-[14px] text-muted text-[0.9375rem] leading-[1.75]">KRIYANO does not currently provide individual legal, medical, financial or other regulated professional advice through email.</p>
      </div>
    </div>
  </section>
</BaseLayout>
