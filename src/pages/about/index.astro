---
import BaseLayout from "../../layouts/BaseLayout.astro";

const principles = [
  {
    number: "01",
    title: "Practical before impressive",
    description:
      "KRIYANO focuses on useful AI applications that help people complete real tasks—not just generate impressive-looking outputs.",
  },
  {
    number: "02",
    title: "Human judgment stays important",
    description:
      "AI can assist with research, writing, planning and creation, but important outputs still need human review, context and responsibility.",
  },
  {
    number: "03",
    title: "Clear systems beat random prompting",
    description:
      "The goal is to help people move from one-off AI requests toward repeatable prompts, workflows and practical systems.",
  },
  {
    number: "04",
    title: "Useful for real work",
    description:
      "KRIYANO is built around practical professional tasks, small-business needs, creator workflows and everyday problem-solving.",
  },
];

const areas = [
  {
    title: "AI Tools",
    description:
      "Simple browser-based tools designed to help structure prompts and complete practical AI-assisted tasks.",
    href: "/tools/",
  },
  {
    title: "Prompt Library",
    description:
      "Reusable prompts for work, business, research, writing, creators, operations, images and video.",
    href: "/prompts/",
  },
  {
    title: "AI for Work",
    description:
      "Resources for communication, planning, reporting, problem-solving and everyday professional work.",
    href: "/ai-for-work/",
  },
  {
    title: "AI for Business",
    description:
      "Practical AI use cases for planning, customers, marketing, operations, risk and business decisions.",
    href: "/ai-for-business/",
  },
  {
    title: "Creators",
    description:
      "Prompting and workflow resources for ideas, scripts, visuals, video creation, consistency and repurposing.",
    href: "/creators/",
  },
  {
    title: "Learn",
    description:
      "Beginner-friendly guidance on prompting, verification, responsible AI use and building better workflows.",
    href: "/learn/",
  },
];

const workflow = [
  "Understand the task",
  "Give useful context",
  "Use AI to assist",
  "Review the output",
  "Apply human judgment",
  "Improve the process",
];

const focusAreas = [
  "Practical AI prompting",
  "Professional productivity",
  "Business workflows",
  "Research and verification",
  "Warehouse and operations",
  "Creator workflows",
  "AI image prompting",
  "AI video prompting",
];
---

<BaseLayout
  title="About KRIYANO | Practical AI for Real Work"
  description="Learn what KRIYANO is, why it exists and how it helps people use AI more practically for work, business, creators and everyday problem-solving."
>
  <section class="about-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="section-kicker">ABOUT KRIYANO</div>

        <h1>
          Practical AI.
          <span>Built around action.</span>
        </h1>

        <p>
          KRIYANO is a practical AI resource platform designed to help people
          turn AI into useful action for real work, business, research,
          operations and content creation.
        </p>

        <div class="hero-actions">
          <a href="/tools/" class="button button-primary">
            Explore AI Tools
          </a>

          <a href="/prompts/" class="secondary-link">
            Browse Prompt Library ↗
          </a>
        </div>
      </div>

      <div class="meaning-card">
        <div class="meaning-header">
          <span>THE IDEA BEHIND THE NAME</span>
          <span class="meaning-mark">KRIYANO</span>
        </div>

        <div class="meaning-body">
          <span class="meaning-label">ROOT CONCEPT</span>

          <h2>Kriya → Action</h2>

          <p>
            The idea behind KRIYANO is simple: AI becomes valuable when
            knowledge turns into useful action.
          </p>

          <div class="meaning-flow">
            <div>
              <span>01</span>
              <strong>Learn</strong>
            </div>

            <span class="flow-arrow">→</span>

            <div>
              <span>02</span>
              <strong>Apply</strong>
            </div>

            <span class="flow-arrow">→</span>

            <div>
              <span>03</span>
              <strong>Improve</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about-strip">
    <div class="container strip-grid">
      <div>
        <strong>Practical</strong>
        <span>Focused on useful outcomes</span>
      </div>

      <div>
        <strong>Accessible</strong>
        <span>No technical background required</span>
      </div>

      <div>
        <strong>Human-reviewed</strong>
        <span>AI assists, people decide</span>
      </div>

      <div>
        <strong>Action-oriented</strong>
        <span>Learn → apply → improve</span>
      </div>
    </div>
  </section>

  <section class="section story-section">
    <div class="container story-grid">
      <div>
        <div class="section-kicker">Why KRIYANO exists</div>

        <h2>
          AI information is everywhere.
          Practical application is harder.
        </h2>
      </div>

      <div class="story-copy">
        <p>
          There are thousands of AI tools, prompts, tutorials and new releases.
          The difficult part is often knowing what is actually useful for the
          task in front of you.
        </p>

        <p>
          KRIYANO is being built to close that gap by organizing AI around
          practical outcomes: writing a better email, investigating a problem,
          creating an SOP, researching a market, planning content, improving a
          process or building a stronger prompt.
        </p>

        <p>
          Instead of treating AI as the final decision-maker, KRIYANO treats it
          as an assistant inside a human-controlled workflow.
        </p>
      </div>
    </div>
  </section>

  <section class="principles-section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="section-kicker">How KRIYANO approaches AI</div>

          <h2>
            Useful AI needs
            a practical framework.
          </h2>
        </div>

        <p>
          The platform is built around a few simple principles that keep AI
          useful, understandable and grounded in real tasks.
        </p>
      </div>

      <div class="principles-grid">
        {
          principles.map((principle) => (
            <article class="principle-card">
              <span>{principle.number}</span>

              <h3>{principle.title}</h3>

              <p>{principle.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="what-section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="section-kicker">What you will find here</div>

          <h2>
            Resources built around
            real AI use cases.
          </h2>
        </div>

        <p>
          KRIYANO combines interactive tools, reusable prompts and practical
          learning resources so users can move from understanding AI to using
          it effectively.
        </p>
      </div>

      <div class="area-grid">
        {
          areas.map((area) => (
            <a href={area.href} class="area-card">
              <div>
                <span class="area-label">KRIYANO</span>
                <h3>{area.title}</h3>
                <p>{area.description}</p>
              </div>

              <span class="area-arrow">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="workflow-section">
    <div class="container workflow-layout">
      <div class="workflow-copy">
        <div class="section-kicker">A human-controlled workflow</div>

        <h2>
          AI assists.
          Humans remain responsible.
        </h2>

        <p>
          KRIYANO encourages users to define the task clearly, provide useful
          context, review important outputs and apply their own judgment before
          acting on AI-generated information.
        </p>
      </div>

      <div class="workflow-list">
        {
          workflow.map((item, index) => (
            <div class="workflow-row">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{item}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="focus-section">
    <div class="container focus-layout">
      <div>
        <div class="section-kicker">Current focus</div>

        <h2>
          Practical areas
          KRIYANO is building around.
        </h2>
      </div>

      <div class="focus-grid">
        {
          focusAreas.map((item) => (
            <div class="focus-item">
              <span>+</span>
              <strong>{item}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="transparency-section">
    <div class="container transparency-box">
      <div>
        <div class="section-kicker">Transparency</div>

        <h2>
          AI content still
          requires checking.
        </h2>
      </div>

      <div class="transparency-copy">
        <p>
          KRIYANO provides educational resources, tools and prompt templates.
          AI-generated outputs can contain mistakes, outdated information or
          unsuitable recommendations.
        </p>

        <p>
          Users should independently verify important information and use
          appropriate professional judgment for legal, financial, medical,
          safety-critical or other high-impact decisions.
        </p>
      </div>
    </div>
  </section>

  <section class="about-cta">
    <div class="container">
      <div class="cta-box">
        <div>
          <div class="section-kicker">Practical AI for real work</div>

          <h2>
            Start with something
            you actually need to do.
          </h2>

          <p>
            Explore the KRIYANO tools and prompt library and turn a real task
            into a more structured AI workflow.Deployment test.
          </p>
        </div>

        <a href="/tools/prompt-builder/" class="button button-primary">
          Open Prompt Builder
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding: 105px 0 90px;
    border-bottom: 1px solid var(--line);

    background:
      radial-gradient(
        circle at 82% 20%,
        rgba(183, 255, 74, 0.08),
        transparent 28%
      ),
      radial-gradient(
        circle at 15% 10%,
        rgba(77, 226, 197, 0.065),
        transparent 24%
      );
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 76px;
    align-items: center;
  }

  .hero-copy h1 {
    margin-top: 15px;
    font-size: clamp(3.5rem, 7vw, 6.8rem);
    line-height: 0.93;
    letter-spacing: -0.065em;
  }

  .hero-copy h1 span {
    display: block;
    color: var(--lime);
  }

  .hero-copy > p {
    max-width: 690px;
    margin-top: 26px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 34px;
  }

  .secondary-link {
    color: var(--lime);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .meaning-card {
    overflow: hidden;
    border: 1px solid rgba(183, 255, 74, 0.15);
    border-radius: 21px;
    background: var(--surface);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.23);
  }

  .meaning-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .meaning-mark {
    color: var(--lime);
  }

  .meaning-body {
    padding: 28px;
  }

  .meaning-label {
    color: var(--mint);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .meaning-body h2 {
    margin-top: 12px;
    font-size: clamp(2rem, 4vw, 3.4rem);
    letter-spacing: -0.05em;
  }

  .meaning-body > p {
    margin-top: 14px;
    color: var(--muted);
    line-height: 1.7;
  }

  .meaning-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 10px;
    align-items: center;
    margin-top: 32px;
  }

  .meaning-flow > div {
    padding: 15px 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-soft);
  }

  .meaning-flow > div span {
    display: block;
    color: var(--lime);
    font-size: 0.58rem;
    font-weight: 800;
  }

  .meaning-flow > div strong {
    display: block;
    margin-top: 5px;
    font-size: 0.75rem;
  }

  .flow-arrow {
    color: var(--muted);
  }

  .about-strip {
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.018);
  }

  .strip-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .strip-grid > div {
    padding: 24px 20px;
    border-right: 1px solid var(--line);
  }

  .strip-grid > div:last-child {
    border-right: 0;
  }

  .strip-grid strong {
    display: block;
    font-size: 0.9rem;
  }

  .strip-grid span {
    color: var(--muted);
    font-size: 0.74rem;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 90px;
  }

  .story-grid h2,
  .workflow-copy h2,
  .focus-layout h2 {
    margin-top: 13px;
    font-size: clamp(2.6rem, 5vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .story-copy p {
    color: var(--muted);
    line-height: 1.8;
  }

  .story-copy p + p {
    margin-top: 20px;
  }

  .principles-section,
  .workflow-section {
    padding: 100px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg-soft);
  }

  .section-head {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 70px;
    align-items: end;
    margin-bottom: 48px;
  }

  .section-head h2 {
    max-width: 760px;
    margin-top: 13px;
    font-size: clamp(2.6rem, 5vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .section-head > p {
    max-width: 500px;
    color: var(--muted);
    line-height: 1.75;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .principle-card {
    min-height: 245px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 17px;
    background: var(--surface);
  }

  .principle-card > span {
    color: var(--lime);
    font-size: 0.65rem;
    font-weight: 800;
  }

  .principle-card h3 {
    margin-top: 48px;
    font-size: 1.08rem;
    letter-spacing: -0.025em;
  }

  .principle-card p {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.79rem;
    line-height: 1.65;
  }

  .what-section {
    padding: 100px 0;
  }

  .area-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .area-card {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    min-height: 220px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
    color: var(--text);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .area-card:hover {
    transform: translateY(-2px);
    border-color: rgba(183, 255, 74, 0.28);
  }

  .area-label {
    color: var(--mint);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .area-card h3 {
    margin-top: 30px;
    font-size: 1.45rem;
    letter-spacing: -0.035em;
  }

  .area-card p {
    max-width: 520px;
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .area-arrow {
    color: var(--lime);
  }

  .workflow-layout,
  .focus-layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
    align-items: center;
  }

  .workflow-copy p {
    max-width: 560px;
    margin-top: 18px;
    color: var(--muted);
    line-height: 1.75;
  }

  .workflow-list {
    border-top: 1px solid var(--line);
  }

  .workflow-row {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 18px;
    padding: 17px 0;
    border-bottom: 1px solid var(--line);
  }

  .workflow-row span {
    color: var(--lime);
    font-size: 0.62rem;
    font-weight: 800;
  }

  .workflow-row strong {
    font-size: 0.82rem;
  }

  .focus-section {
    padding: 100px 0;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .focus-item {
    display: grid;
    grid-template-columns: 25px 1fr;
    gap: 10px;
    align-items: center;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }

  .focus-item span {
    color: var(--lime);
    font-weight: 800;
  }

  .focus-item strong {
    font-size: 0.78rem;
  }

  .transparency-section {
    padding: 0 0 100px;
  }

  .transparency-box {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
    padding: 45px;
    border: 1px solid rgba(77, 226, 197, 0.15);
    border-radius: 21px;
    background:
      linear-gradient(
        145deg,
        rgba(77, 226, 197, 0.035),
        transparent 55%
      ),
      var(--surface);
  }

  .transparency-box h2 {
    margin-top: 12px;
    font-size: clamp(2.3rem, 4vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .transparency-copy p {
    color: var(--muted);
    line-height: 1.75;
  }

  .transparency-copy p + p {
    margin-top: 18px;
  }

  .about-cta {
    padding: 0 0 100px;
  }

  .cta-box {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 50px;
    padding: 48px;
    border: 1px solid rgba(183, 255, 74, 0.15);
    border-radius: 23px;
    background: var(--surface);
  }

  .cta-box h2 {
    max-width: 720px;
    margin-top: 12px;
    font-size: clamp(2.3rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .cta-box p {
    max-width: 650px;
    margin-top: 16px;
    color: var(--muted);
    line-height: 1.7;
  }

  @media (max-width: 950px) {
    .hero-grid,
    .story-grid,
    .section-head,
    .workflow-layout,
    .focus-layout,
    .transparency-box {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .principles-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-box {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 720px) {
    .about-hero {
      padding: 72px 0 62px;
    }

    .strip-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .strip-grid > div:nth-child(2) {
      border-right: 0;
    }

    .strip-grid > div:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }

    .principles-grid,
    .area-grid,
    .focus-grid {
      grid-template-columns: 1fr;
    }

    .meaning-flow {
      grid-template-columns: 1fr;
    }

    .flow-arrow {
      display: none;
    }

    .transparency-box,
    .cta-box {
      padding: 30px 24px;
    }
  }
</style>