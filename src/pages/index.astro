---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { primaryTools } from '../data/tools';
const launchTools = primaryTools.filter(tool => ['uuid-generator','jwt-decoder','sql-formatter','url-parser'].includes(tool.id));
const featuredTools = primaryTools.filter(tool => ['uuid-generator','timestamp-converter','jwt-decoder','yaml-validator','base64-encoder','cron-expression-generator','sql-formatter','url-parser','query-string-parser','sha-256-generator','json-minifier','xml-formatter'].includes(tool.id));
---
<BaseLayout title="Free Developer & Web Tools | KRIYANO" description="Fast browser-based developer and web utilities for UUIDs, timestamps, JWTs, SQL, XML, JSON, hashes, URLs, YAML, cron expressions and more. No sign-up required.">
<section class="home-hero container">
 <div class="home-copy"><div class="section-kicker"><span class="live-dot"></span> DEVELOPER · WEB · DATA UTILITIES</div><h1>Fast tools.<br/><span>Exact results.</span></h1><p>Free browser-based utilities for developers and technical work. Generate, encode, decode, validate, convert and inspect technical data without unnecessary sign-ups.</p><div class="hero-actions"><a href="/tools/" class="button button-primary">Browse all tools ↗</a><a href="/tools/uuid-generator/" class="home-secondary">Generate a UUID →</a></div><div class="home-trust"><span>Free to use</span><span>Browser-first</span><span>No account needed</span></div></div>
 <div class="launch-panel"><div class="launch-header"><span>START WITH A TECHNICAL TOOL</span><span class="launch-count">Runs fast</span></div>{launchTools.map(tool => <a class="launch-row" href={tool.href}><span class="launch-icon"><ToolIcon name={tool.icon}/></span><div><strong>{tool.name}</strong><span>{tool.description}</span></div><span class="launch-arrow" aria-hidden="true">↗</span></a>)}</div>
</section>
<section class="home-tools container" aria-labelledby="tools-title"><div class="kit-row"><div><div class="section-kicker">DEVELOPER UTILITIES</div><h2 id="tools-title">Useful tools for repetitive technical tasks.</h2></div><a class="kit-link" href="/tools/">Browse all tools →</a></div><div class="kit-grid">{featuredTools.map(tool => <ToolCard tool={tool}/>)}</div></section>
<section class="home-band"><div class="container home-band-grid"><div><div class="section-kicker">WHY KRIYANO</div><h2>Small utilities.<br/>Less friction.</h2></div><div><h3>Browser-first where possible.</h3><p>New technical tools are designed to process common transformations locally in your browser wherever the task allows it.</p><a href="/privacy/">How data is handled →</a></div><div><h3>One task at a time.</h3><p>Each tool is built around a clear job: generate an identifier, decode a token, validate YAML, convert structured data, build a cron schedule, or clean pasted text.</p><a href="/about/">About the new KRIYANO direction →</a></div></div></section>
<section class="container home-guides"><div class="kit-row"><div><div class="section-kicker">EXPANDING TOOLKIT</div><h2>Built around practical technical workflows.</h2></div></div><div class="guide-links"><a href="/tools/#developer-tools"><span>DEVELOPER TOOLS</span><h3>Generate and inspect technical values.</h3><p>UUIDs, timestamps, JWTs, SHA-256, SQL formatting and cron schedules.</p><b aria-hidden="true">↗</b></a><a href="/tools/#web-tools"><span>WEB TOOLS</span><h3>Work with URLs and web data.</h3><p>Parse URLs, inspect query strings and encode common web-facing values.</p><b aria-hidden="true">↗</b></a><a href="/tools/#data-tools"><span>DATA &amp; TEXT</span><h3>Clean and transform pasted data.</h3><p>Validate YAML, format XML, minify JSON and clean structured text.</p><b aria-hidden="true">↗</b></a></div></section>
<section class="container home-feedback"><div><h2>Missing a developer utility?</h2><p>Tell us the repetitive technical task you want to finish faster.</p></div><a class="button button-secondary" href="/contact/">Suggest a tool →</a></section>
</BaseLayout>
