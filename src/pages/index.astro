---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { tools } from '../data/tools';
import '../styles/toolkit.css';
const featuredTools = tools.filter(tool => tool.category === 'AI');
---
<BaseLayout title="Practical AI for Work & Creators | KRIYANO" description="Build clearer prompts, review AI output and explore practical AI workflows for writing, research, everyday work and content creation.">
<section class="home-hero container">
 <div class="home-copy"><div class="section-kicker"><span class="live-dot"></span> PRACTICAL AI · WORK · CREATORS</div><h1>Practical AI.<br/><span>For your work.</span></h1><p>Build clearer prompts. Review AI output.<br class="desktop-break"/> Create with practical guidance for work, research and content.</p><div class="hero-actions"><a href="/check/" class="button button-primary">Check AI output ↗</a><a href="/tools/prompt-builder/" class="home-secondary">Build a prompt →</a></div><div class="home-trust"><span>No sign-up</span><span>Free to use</span><span>You stay in control</span></div></div>
 <div class="launch-panel"><div class="launch-header"><span>CREATE. CHECK. IMPROVE.</span><span class="launch-count">Start here</span></div>{featuredTools.map(tool => <a class="launch-row" href={tool.href}><span class="launch-icon"><ToolIcon name={tool.icon}/></span><div><strong>{tool.action}</strong><span>{tool.description}</span></div><span class="launch-arrow" aria-hidden="true">↗</span></a>)}<a class="launch-bottom" href="/creators/"><span>Making content? <strong>Explore creator workflows.</strong></span><span aria-hidden="true">→</span></a></div>
</section>
<section class="home-tools container" aria-labelledby="tools-title"><div class="kit-row"><div><div class="section-kicker">FROM INSTRUCTIONS TO REVIEW</div><h2 id="tools-title">Get more from AI.</h2></div><a class="kit-link" href="/tools/">Browse all tools →</a></div><div class="kit-grid">{featuredTools.map(tool => <ToolCard tool={tool}/>)}</div></section>
<section class="home-band"><div class="container home-band-grid"><div><div class="section-kicker">YOU BRING THE JUDGMENT</div><h2>A useful starting point.<br/>A thoughtful review.</h2></div><div><h3>Know what leaves your browser.</h3><p>Prompt Builder works in your browser. CHECK offers local signals and an optional online AI review, with clear information about where your text goes.</p><a href="/privacy/">How your data is handled →</a></div><div><h3>Check before you rely on it.</h3><p>CHECK highlights claims, numbers and assumptions that deserve attention. It does not certify accuracy or replace checking the original evidence.</p><a href="/about/">Get to know KRIYANO →</a></div></div></section>
<section class="container home-guides"><div class="kit-row"><div><div class="section-kicker">PROMPTS WITH PRACTICAL CONTEXT</div><h2>Choose your next task.</h2></div><a class="kit-link" href="/learn/">Explore the guides →</a></div><div class="guide-links"><a href="/ai-for-work/"><span>AI FOR WORK</span><h3>Give AI a clearer brief.</h3><p>Use practical prompts for writing, planning, reporting and operational tasks.</p><b aria-hidden="true">↗</b></a><a href="/creators/"><span>FOR CREATORS</span><h3>Shape your next idea.</h3><p>Explore prompts and workflows for images, video and social content.</p><b aria-hidden="true">↗</b></a><a href="/learn/accuracy-and-research/how-to-fact-check-ai-output/"><span>ACCURACY &amp; RESEARCH</span><h3>A confident answer still needs checking.</h3><p>Learn how to check numbers, sources and assumptions.</p><b aria-hidden="true">↗</b></a></div></section>
<section class="container home-feedback"><div><h2>What would help you work better with AI?</h2><p>Suggest a prompt, creator workflow or improvement to an existing tool.</p></div><a class="button button-secondary" href="/contact/">Suggest an improvement →</a></section>
</BaseLayout>
<style>
.home-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:70px;align-items:center;padding-top:72px;padding-bottom:72px}.home-copy h1{font-size:clamp(3.5rem,6.5vw,5.5rem);line-height:1.04;letter-spacing:-.065em;margin:22px 0}.home-copy h1 span{color:var(--lime)}.home-copy>p{font-size:1.12rem;line-height:1.8;color:var(--muted);max-width:510px}.hero-actions{display:flex;gap:24px;align-items:center;flex-wrap:wrap;margin-top:30px}.hero-actions .button{gap:22px}.home-secondary{font-size:.9rem;font-weight:650}.home-trust{display:flex;gap:20px;flex-wrap:wrap;color:var(--muted);font-size:.8rem;margin-top:26px}.home-trust span:before{content:'✓';color:var(--lime);margin-right:7px}.live-dot{display:inline-block;width:7px;height:7px;background:var(--lime);border-radius:50%;margin-right:8px}.launch-panel{background:linear-gradient(135deg,#182a1e,#0d1b15);border:1px solid #345039;border-radius:22px;overflow:hidden;box-shadow:0 24px 65px #0003}.launch-header{display:flex;justify-content:space-between;align-items:center;padding:23px 25px;border-bottom:1px solid var(--line);font-size:.7rem;letter-spacing:.1em;color:#c0ccc3;font-weight:650}.launch-count{color:var(--lime);border:1px solid #b7ff4a30;border-radius:30px;padding:4px 10px;letter-spacing:0}.launch-row{display:flex;align-items:center;gap:16px;margin:0 24px;padding:25px 0;border-bottom:1px solid var(--line)}.launch-icon{display:inline-flex;padding:12px;border-radius:12px;background:#b7ff4a10;color:var(--lime)}.launch-row strong{display:block;font-size:1rem}.launch-row div>span{display:block;font-size:.82rem;color:var(--muted);margin-top:5px}.launch-arrow{margin-left:auto;color:var(--lime);font-size:1.3rem}.launch-row:hover strong{color:var(--lime)}.launch-bottom{display:flex;gap:20px;justify-content:space-between;padding:22px 24px;color:var(--muted);font-size:.82rem}.launch-bottom strong{color:var(--text);font-weight:550}.home-tools{padding:20px 0 76px}.home-tools .kit-row,.home-guides .kit-row{margin-bottom:28px}.kit-row .section-kicker{margin-bottom:10px}.home-band{background:#101f16;border-block:1px solid var(--line);padding:48px 0}.home-band-grid{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:48px}.home-band h2{font-size:2rem;line-height:1.2;letter-spacing:-.04em;margin-top:15px}.home-band h3{font-size:1.05rem;margin-bottom:12px}.home-band p{font-size:.94rem;line-height:1.8;color:var(--muted)}.home-band a{display:inline-block;font-size:.85rem;color:var(--lime);margin-top:18px}.home-guides{padding:65px 0}.guide-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.guide-links a{padding:25px 0;border-top:1px solid #385140;position:relative}.guide-links span{font-size:.7rem;color:var(--mint);letter-spacing:.09em;font-weight:650}.guide-links h3{font-size:1.25rem;letter-spacing:-.025em;margin:15px 0 12px;line-height:1.45}.guide-links p{font-size:.94rem;color:var(--muted);padding-right:20px}.guide-links b{display:block;color:var(--lime);font-size:1.4rem;margin-top:20px}.home-feedback{display:flex;justify-content:space-between;align-items:center;gap:25px;padding:30px 0 60px}.home-feedback h2{font-size:1.4rem;letter-spacing:-.025em}.home-feedback p{color:var(--muted);margin-top:6px}
@media(max-width:1000px){.home-hero{gap:35px}.home-band-grid{gap:25px}.hero-actions{gap:15px}.launch-row{margin-inline:18px}.launch-row div>span{font-size:.78rem}}@media(max-width:760px){.home-hero{grid-template-columns:1fr;padding-top:38px;padding-bottom:40px;gap:36px}.home-copy h1{font-size:clamp(3.3rem,12vw,4.6rem)}.home-band-grid,.guide-links{grid-template-columns:1fr}.home-band-grid{gap:30px}.home-feedback{flex-direction:column;align-items:flex-start}.home-tools{padding-bottom:45px}.home-guides{padding:45px 0}.desktop-break{display:none}.launch-row{padding:20px 0}.home-trust{gap:14px}}

.home-tools .kit-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

@media (max-width: 760px) {
  .home-tools .kit-grid {
    grid-template-columns: 1fr;
  }
}
</style>
