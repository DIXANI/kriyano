---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { primaryTools } from '../data/tools';
import '../styles/toolkit.css';
const launchTools = primaryTools.filter(tool => ['uuid-generator','jwt-decoder','yaml-validator','cron-expression-generator'].includes(tool.id));
const featuredTools = primaryTools.filter(tool => ['uuid-generator','timestamp-converter','jwt-decoder','url-encoder','yaml-validator','json-yaml-converter','base64-encoder','cron-expression-generator'].includes(tool.id));
---
<BaseLayout title="Free Developer & Web Tools | KRIYANO" description="Fast browser-based developer and web utilities for UUIDs, timestamps, JWTs, Base64, YAML, cron expressions, URL encoding and more. No sign-up required.">
<section class="home-hero container">
 <div class="home-copy"><div class="section-kicker"><span class="live-dot"></span> DEVELOPER · WEB · DATA UTILITIES</div><h1>Fast tools.<br/><span>Exact results.</span></h1><p>Free browser-based utilities for developers and technical work. Generate, encode, decode, validate, convert and inspect technical data without unnecessary sign-ups.</p><div class="hero-actions"><a href="/tools/" class="button button-primary">Browse all tools ↗</a><a href="/tools/uuid-generator/" class="home-secondary">Generate a UUID →</a></div><div class="home-trust"><span>Free to use</span><span>Browser-first</span><span>No account needed</span></div></div>
 <div class="launch-panel"><div class="launch-header"><span>START WITH A TECHNICAL TOOL</span><span class="launch-count">Runs fast</span></div>{launchTools.map(tool => <a class="launch-row" href={tool.href}><span class="launch-icon"><ToolIcon name={tool.icon}/></span><div><strong>{tool.name}</strong><span>{tool.description}</span></div><span class="launch-arrow" aria-hidden="true">↗</span></a>)}</div>
</section>
<section class="home-tools container" aria-labelledby="tools-title"><div class="kit-row"><div><div class="section-kicker">DEVELOPER UTILITIES</div><h2 id="tools-title">Useful tools for repetitive technical tasks.</h2></div><a class="kit-link" href="/tools/">Browse all tools →</a></div><div class="kit-grid">{featuredTools.map(tool => <ToolCard tool={tool}/>)}</div></section>
<section class="home-band"><div class="container home-band-grid"><div><div class="section-kicker">WHY KRIYANO</div><h2>Small utilities.<br/>Less friction.</h2></div><div><h3>Browser-first where possible.</h3><p>New technical tools are designed to process common transformations locally in your browser wherever the task allows it.</p><a href="/privacy/">How data is handled →</a></div><div><h3>One task at a time.</h3><p>Each tool is built around a clear job: generate an identifier, decode a token, validate YAML, convert structured data, build a cron schedule, or clean pasted text.</p><a href="/about/">About the new KRIYANO direction →</a></div></div></section>
<section class="container home-guides"><div class="kit-row"><div><div class="section-kicker">EXPANDING TOOLKIT</div><h2>Built around practical technical workflows.</h2></div></div><div class="guide-links"><a href="/tools/#developer-tools"><span>DEVELOPER TOOLS</span><h3>Generate and inspect technical values.</h3><p>UUIDs, timestamps, JWTs, Base64 and cron schedules.</p><b aria-hidden="true">↗</b></a><a href="/tools/#web-tools"><span>WEB TOOLS</span><h3>Work with URLs and web data.</h3><p>Encode URLs and work with common web-facing formats.</p><b aria-hidden="true">↗</b></a><a href="/tools/#data-tools"><span>DATA &amp; TEXT</span><h3>Clean and transform pasted data.</h3><p>Validate YAML, convert JSON/YAML and clean structured text.</p><b aria-hidden="true">↗</b></a></div></section>
<section class="container home-feedback"><div><h2>Missing a developer utility?</h2><p>Tell us the repetitive technical task you want to finish faster.</p></div><a class="button button-secondary" href="/contact/">Suggest a tool →</a></section>
</BaseLayout>
<style>
.home-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:70px;align-items:center;padding-top:72px;padding-bottom:72px}.home-copy h1{font-size:clamp(3.5rem,6.5vw,5.5rem);line-height:1.04;letter-spacing:-.065em;margin:22px 0}.home-copy h1 span{color:var(--lime)}.home-copy>p{font-size:1.12rem;line-height:1.8;color:var(--muted);max-width:560px}.hero-actions{display:flex;gap:24px;align-items:center;flex-wrap:wrap;margin-top:30px}.hero-actions .button{gap:22px}.home-secondary{font-size:.9rem;font-weight:650}.home-trust{display:flex;gap:20px;flex-wrap:wrap;color:var(--muted);font-size:.8rem;margin-top:26px}.home-trust span:before{content:'✓';color:var(--lime);margin-right:7px}.live-dot{display:inline-block;width:7px;height:7px;background:var(--lime);border-radius:50%;margin-right:8px}.launch-panel{background:linear-gradient(135deg,#182a1e,#0d1b15);border:1px solid #345039;border-radius:22px;overflow:hidden;box-shadow:0 24px 65px #0003}.launch-header{display:flex;justify-content:space-between;align-items:center;padding:23px 25px;border-bottom:1px solid var(--line);font-size:.7rem;letter-spacing:.1em;color:#c0ccc3;font-weight:650}.launch-count{color:var(--lime);border:1px solid #b7ff4a30;border-radius:30px;padding:4px 10px;letter-spacing:0}.launch-row{display:flex;align-items:center;gap:16px;margin:0 24px;padding:22px 0;border-bottom:1px solid var(--line)}.launch-row:last-child{border-bottom:0}.launch-icon{display:inline-flex;padding:12px;border-radius:12px;background:#b7ff4a10;color:var(--lime)}.launch-row strong{display:block;font-size:1rem}.launch-row div>span{display:block;font-size:.82rem;color:var(--muted);margin-top:5px}.launch-arrow{margin-left:auto;color:var(--lime);font-size:1.3rem}.launch-row:hover strong{color:var(--lime)}.home-tools{padding:20px 0 76px}.home-tools .kit-row,.home-guides .kit-row{margin-bottom:28px}.kit-row .section-kicker{margin-bottom:10px}.home-band{background:#101f16;border-block:1px solid var(--line);padding:48px 0}.home-band-grid{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:48px}.home-band h2{font-size:2rem;line-height:1.2;letter-spacing:-.04em;margin-top:15px}.home-band h3{font-size:1.05rem;margin-bottom:12px}.home-band p{font-size:.94rem;line-height:1.8;color:var(--muted)}.home-band a{display:inline-block;font-size:.85rem;color:var(--lime);margin-top:18px}.home-guides{padding:65px 0}.guide-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.guide-links a{padding:25px 0;border-top:1px solid #385140;position:relative}.guide-links span{font-size:.7rem;color:var(--mint);letter-spacing:.09em;font-weight:650}.guide-links h3{font-size:1.25rem;letter-spacing:-.025em;margin:15px 0 12px;line-height:1.45}.guide-links p{font-size:.94rem;color:var(--muted);padding-right:20px}.guide-links b{display:block;color:var(--lime);font-size:1.4rem;margin-top:20px}.home-feedback{display:flex;justify-content:space-between;align-items:center;gap:25px;padding:30px 0 60px}.home-feedback h2{font-size:1.4rem;letter-spacing:-.025em}.home-feedback p{color:var(--muted);margin-top:6px}.home-tools .kit-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
@media(max-width:1000px){.home-hero{gap:35px}.home-band-grid{gap:25px}.hero-actions{gap:15px}.launch-row{margin-inline:18px}}@media(max-width:760px){.home-hero{grid-template-columns:1fr;padding-top:38px;padding-bottom:40px;gap:36px}.home-copy h1{font-size:clamp(3.3rem,12vw,4.6rem)}.home-band-grid,.guide-links{grid-template-columns:1fr}.home-band-grid{gap:30px}.home-feedback{flex-direction:column;align-items:flex-start}.home-tools{padding-bottom:45px}.home-guides{padding:45px 0}.launch-row{padding:20px 0}.home-trust{gap:14px}.home-tools .kit-grid{grid-template-columns:1fr}}
</style>
