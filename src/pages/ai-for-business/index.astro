---
import BaseLayout from "../../layouts/BaseLayout.astro";

const businessAreas = [
  {
    number: "01",
    title: "Business Planning",
    description:
      "Turn ideas into clearer plans, evaluate opportunities and structure business decisions.",
    links: [
      {
        label: "Business Idea Evaluator",
        href: "/prompts/business-idea-evaluator/",
      },
      {
        label: "Business Plan Builder",
        href: "/prompts/business-plan-builder/",
      },
      {
        label: "SWOT Analysis",
        href: "/prompts/swot-analysis/",
      },
      {
        label: "Business Decision Framework",
        href: "/prompts/business-decision-framework/",
      },
    ],
  },
  {
    number: "02",
    title: "Customers & Market",
    description:
      "Understand customer needs, market positioning, competitors and practical growth opportunities.",
    links: [
      {
        label: "Customer Persona Builder",
        href: "/prompts/customer-persona-builder/",
      },
      {
        label: "Customer Pain Point Research",
        href: "/prompts/customer-pain-point-research/",
      },
      {
        label: "Market Research",
        href: "/prompts/market-research/",
      },
      {
        label: "Competitor Analysis",
        href: "/prompts/competitor-analysis/",
      },
    ],
  },
  {
    number: "03",
    title: "Marketing & Sales",
    description:
      "Develop stronger positioning, messaging and campaigns for products and services.",
    links: [
      {
        label: "Marketing Strategy",
        href: "/prompts/marketing-strategy/",
      },
      {
        label: "Value Proposition Builder",
        href: "/prompts/value-proposition-builder/",
      },
      {
        label: "Ad Copy Writer",
        href: "/prompts/ad-copy-writer/",
      },
      {
        label: "Landing Page Messaging",
        href: "/prompts/landing-page-messaging/",
      },
    ],
  },
  {
    number: "04",
    title: "Operations & Processes",
    description:
      "Improve workflows, standardize procedures and investigate recurring business problems.",
    links: [
      {
        label: "SOP Creation",
        href: "/prompts/sop-creation/",
      },
      {
        label: "Process Improvement",
        href: "/prompts/process-improvement/",
      },
      {
        label: "Root Cause Analysis",
        href: "/prompts/root-cause-analysis/",
      },
      {
        label: "Corrective Action Plan",
        href: "/prompts/corrective-action-plan/",
      },
    ],
  },
  {
    number: "05",
    title: "Risk & Decisions",
    description:
      "Use structured analysis to identify risks, compare options and support better business decisions.",
    links: [
      {
        label: "Business Risk Analysis",
        href: "/prompts/business-risk-analysis/",
      },
      {
        label: "Pricing Strategy",
        href: "/prompts/pricing-strategy/",
      },
      {
        label: "Research & Comparison",
        href: "/prompts/research-comparison/",
      },
      {
        label: "Fact Checking",
        href: "/prompts/fact-checking/",
      },
    ],
  },
  {
    number: "06",
    title: "Content & Communication",
    description:
      "Create clearer business communication, campaign content and customer-facing materials.",
    links: [
      {
        label: "Professional Email Writer",
        href: "/prompts/professional-email-writer/",
      },
      {
        label: "Email Marketing Campaign",
        href: "/prompts/email-marketing-campaign/",
      },
      {
        label: "Social Media Content Planner",
        href: "/prompts/social-media-content-planner/",
      },
      {
        label: "Content Repurposing",
        href: "/prompts/content-repurposing/",
      },
    ],
  },
];

const useCases = [
  {
    title: "Explore an idea",
    description:
      "Test assumptions, identify weaknesses and understand what needs validation before investing time or money.",
  },
  {
    title: "Understand the market",
    description:
      "Organize competitor research, customer insights and market information into practical findings.",
  },
  {
    title: "Improve operations",
    description:
      "Review processes, investigate problems and create structured procedures or corrective actions.",
  },
  {
    title: "Communicate better",
    description:
      "Turn rough business information into clearer emails, reports, marketing messages and customer content.",
  },
];

const frameworkSteps = [
  {
    number: "01",
    title: "Goal",
    description: "Define the business outcome you want.",
  },
  {
    number: "02",
    title: "Context",
    description: "Give AI the relevant business background.",
  },
  {
    number: "03",
    title: "Analysis",
    description: "Use AI to organize, compare or generate options.",
  },
  {
    number: "04",
    title: "Validate",
    description: "Check facts, assumptions and commercial reality.",
  },
  {
    number: "05",
    title: "Decide",
    description: "Apply human judgment before taking action.",
  },
];
---

<BaseLayout
  title="AI Prompts for Business & Productivity | KRIYANO"
  description="Practical AI resources for business planning, market research, marketing, operations, decision-making and growth."
>
  <section class="business-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="section-kicker">AI FOR BUSINESS</div>

        <h1>
          Turn AI into
          <span>business action.</span>
        </h1>

        <p>
          Practical prompts, tools and workflows for planning, market research,
          marketing, operations, business decisions and everyday execution.
        </p>

        <div class="hero-actions">
          <a href="#business-areas" class="button button-primary">
            Explore business resources
          </a>

          <a href="/prompts/business/" class="hero-secondary-link">
            Browse business prompts ↗
          </a>
        </div>
      </div>

      <div class="business-panel">
        <div class="panel-header">
          <span>BUSINESS SIGNAL</span>
          <span class="status-dot">ACTIVE</span>
        </div>

        <div class="panel-body">
          <div class="panel-question">
            <span>OBJECTIVE</span>
            <strong>
              Evaluate a new business opportunity before investing.
            </strong>
          </div>

          <div class="panel-grid">
            <div>
              <span>MARKET</span>
              <strong>Demand</strong>
              <small>Who needs it?</small>
            </div>

            <div>
              <span>VALUE</span>
              <strong>Offer</strong>
              <small>Why choose it?</small>
            </div>

            <div>
              <span>RISK</span>
              <strong>Reality</strong>
              <small>What could fail?</small>
            </div>

            <div>
              <span>ACTION</span>
              <strong>Next step</strong>
              <small>What to test first?</small>
            </div>
          </div>

          <div class="panel-output">
            <span>AI ROLE</span>
            <p>
              Structure the analysis, challenge assumptions and identify
              questions that still need real-world validation.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="business-strip">
    <div class="container strip-grid">
      <div>
        <strong>Plan</strong>
        <span>Ideas & direction</span>
      </div>

      <div>
        <strong>Research</strong>
        <span>Markets & customers</span>
      </div>

      <div>
        <strong>Improve</strong>
        <span>Processes & operations</span>
      </div>

      <div>
        <strong>Decide</strong>
        <span>Evidence before action</span>
      </div>
    </div>
  </section>

  <section class="section" id="business-areas">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="section-kicker">Business resource areas</div>

          <h2>
            Start with the
            business problem.
          </h2>
        </div>

        <p>
          Good business use of AI begins with a real objective. Choose the area
          closest to what you need to understand, improve or decide.
        </p>
      </div>

      <div class="business-grid">
        {
          businessAreas.map((area) => (
            <article class="business-card">
              <div class="card-head">
                <span class="card-number">{area.number}</span>
                <span class="card-type">BUSINESS</span>
              </div>

              <h3>{area.title}</h3>

              <p>{area.description}</p>

              <div class="resource-list">
                {
                  area.links.map((link) => (
                    <a href={link.href}>
                      <span>{link.label}</span>
                      <span>↗</span>
                    </a>
                  ))
                }
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="use-cases-section">
    <div class="container">
      <div class="section-head use-case-head">
        <div>
          <div class="section-kicker">Where AI can help</div>

          <h2>
            Useful before,
            during and after decisions.
          </h2>
        </div>

        <p>
          AI is strongest when it helps you structure information and think
          more clearly. It should not replace real customer evidence, financial
          judgment or operational experience.
        </p>
      </div>

      <div class="use-case-grid">
        {
          useCases.map((item, index) => (
            <article class="use-case-card">
              <span class="use-number">
                {String(index + 1).padStart(2, "0")}
              </span>

              <h3>{item.title}</h3>

              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="framework-section">
    <div class="container">
      <div class="framework-box">
        <div class="framework-copy">
          <div class="section-kicker">Business AI framework</div>

          <h2>
            AI can support the decision.
            It cannot own it.
          </h2>

          <p>
            Use AI to organize information, expose assumptions, generate
            alternatives and prepare analysis. Then validate the important
            parts using reliable data and real business conditions.
          </p>
        </div>

        <div class="framework-flow">
          {
            frameworkSteps.map((step) => (
              <div class="framework-step">
                <span>{step.number}</span>
                <strong>{step.title}</strong>
                <p>{step.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="business-focus">
    <div class="container focus-grid">
      <div class="focus-copy">
        <div class="section-kicker">Built for practical businesses</div>

        <h2>
          AI does not have to mean
          enterprise complexity.
        </h2>

        <p>
          Small businesses, independent professionals and operational teams can
          use AI for practical tasks without expensive systems or complicated
          implementations.
        </p>

        <a href="/tools/prompt-builder/" class="text-link">
          Build a prompt for your business task ↗
        </a>
      </div>

      <div class="focus-list">
        <div>
          <span>01</span>
          <div>
            <strong>Small business</strong>
            <p>
              Planning, customer research, marketing and everyday operations.
            </p>
          </div>
        </div>

        <div>
          <span>02</span>
          <div>
            <strong>Operations teams</strong>
            <p>
              SOPs, process improvement, investigation and corrective action.
            </p>
          </div>
        </div>

        <div>
          <span>03</span>
          <div>
            <strong>Independent professionals</strong>
            <p>
              Research, communication, reporting and structured decision-making.
            </p>
          </div>
        </div>

        <div>
          <span>04</span>
          <div>
            <strong>Growing teams</strong>
            <p>
              Repeatable workflows, clearer documentation and better planning.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="business-cta">
    <div class="container">
      <div class="cta-box">
        <div>
          <div class="section-kicker">Start with a real task</div>

          <h2>
            What business problem
            are you trying to solve?
          </h2>

          <p>
            Describe the goal, context and constraints. KRIYANO's Prompt Builder
            can help turn that into a more structured AI prompt.
          </p>
        </div>

        <a href="/tools/prompt-builder/" class="button button-primary">
          Open Prompt Builder
        </a>
      </div>
    </div>
  </section>
</BaseLayout>