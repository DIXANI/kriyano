---
import BaseLayout from '../layouts/BaseLayout.astro';
const recoveryLinks = [
 {number:'01',title:'All Tools',description:'Browse KRIYANO developer, web and data utilities.',href:'/tools/'},
 {number:'02',title:'UUID Generator',description:'Generate UUID v4 identifiers locally in your browser.',href:'/tools/uuid-generator/'},
 {number:'03',title:'JWT Decoder',description:'Inspect JWT headers and payloads without sending the token away.',href:'/tools/jwt-decoder/'},
 {number:'04',title:'Legacy Prompt Library',description:'Older AI prompt resources remain available during the transition.',href:'/prompts/'},
];
---
<BaseLayout title="Page Not Found | KRIYANO" description="The page could not be found. Explore KRIYANO developer, web and data utilities." noindex={true}>
<article class="min-h-[calc(100vh-80px)] bg-[radial-gradient(circle_at_50%_18%,rgba(183,255,74,.07),transparent_28%)]">
 <div class="container pt-[90px] pb-[70px]">
  <section class="relative max-w-[850px] pt-[42px]">
   <div class="error-code absolute -top-[58px] -left-[10px] z-0 select-none pointer-events-none text-[rgba(183,255,74,.045)] text-[clamp(9rem,25vw,19rem)] font-black leading-none tracking-[-0.09em]" aria-hidden="true">404</div>
   <div class="relative z-10">
    <div class="section-kicker">PAGE NOT FOUND</div>
    <h1 class="mt-[14px] text-[clamp(3.3rem,7vw,6.6rem)] leading-[0.94] tracking-[-0.065em]"><span class="block text-lime">lead anywhere.</span>This path didn't</h1>
    <p class="max-w-[650px] mt-[24px] text-muted text-[0.9375rem] leading-[1.75]">The page may have moved, the address may be incorrect, or the resource may no longer exist.</p>
    <div class="flex items-center flex-wrap gap-[22px] mt-[32px]">
     <a href="/" class="button button-primary">Back to Home</a>
     <a href="/tools/" class="text-lime text-[0.8125rem] font-semibold">Browse tools ↗</a>
    </div>
   </div>
  </section>
  <section class="mt-[110px] pt-[55px] border-t border-line">
   <div class="grid grid-cols-[1fr_0.75fr] gap-x-[60px] gap-y-[11px] items-end">
    <div>
     <div class="section-kicker">KEEP EXPLORING</div>
     <h2 class="mt-[11px] text-[clamp(2rem,4vw,3.4rem)] leading-none tracking-[-0.05em]">Try one of these paths.</h2>
    </div>
    <p class="max-w-[460px] text-muted text-[0.8125rem] leading-[1.7]">KRIYANO is building fast browser-based developer, web and data utilities while keeping useful legacy resources accessible.</p>
   </div>
   <div class="grid grid-cols-[repeat(4,1fr)] gap-[12px] mt-[35px]">
    {recoveryLinks.map(item=>
     <a href={item.href} class="flex flex-col justify-between min-h-[205px] p-[20px] border border-line rounded-[14px] bg-surface transition-[border-color] hover:border-lime">
      <div class="flex justify-between text-lime text-[0.75rem] font-black">
       <span>{item.number}</span><span>↗</span>
      </div>
      <div>
       <h3 class="text-[1.0625rem] mb-[8px]">{item.title}</h3>
       <p class="text-muted text-[0.8125rem] leading-[1.6]">{item.description}</p>
      </div>
     </a>
    )}
   </div>
  </section>
 </div>
</article>
</BaseLayout>
