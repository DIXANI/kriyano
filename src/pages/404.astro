---
import BaseLayout from "../layouts/BaseLayout.astro";

const recoveryLinks = [
  {
    number: "01",
    title: "AI Tools",
    description: "Use practical AI tools for real tasks.",
    href: "/tools/",
  },
  {
    number: "02",
    title: "Prompt Library",
    description: "Browse ready-to-use prompts by task and category.",
    href: "/prompts/",
  },
  {
    number: "03",
    title: "AI for Work",
    description: "Find AI resources for everyday professional work.",
    href: "/ai-for-work/",
  },
  {
    number: "04",
    title: "Learn",
    description: "Learn practical prompting, verification and AI workflows.",
    href: "/learn/",
  },
];
---

<BaseLayout
  title="Page Not Found | KRIYANO"
  description="The page you were looking for could not be found. Explore KRIYANO tools, prompts and practical AI resources."
  noindex={true}
>
  <main class="error-page">
    <div class="container error-container">
      <section class="error-hero">
        <div class="error-code" aria-hidden="true">404</div>

        <div class="section-kicker">PAGE NOT FOUND</div>

        <h1>
          This path didn't
          <span>lead anywhere.</span>
        </h1>

        <p>
          The page may have moved, the address may be incorrect, or the
          resource may no longer exist.
        </p>

        <div class="hero-actions">
          <a href="/" class="button button-primary">
            Back to Home
          </a>

          <a href="/prompts/" class="secondary-link">
            Explore Prompt Library ↗
          </a>
        </div>
      </section>

      <section class="recovery-section">
        <div class="recovery-head">
          <div>
            <div class="section-kicker">KEEP EXPLORING</div>

            <h2>Try one of these paths.</h2>
          </div>

          <p>
            KRIYANO provides practical AI tools, prompts and learning resources
            for work, business and content creation.
          </p>
        </div>

        <div class="recovery-grid">
          {
            recoveryLinks.map((item) => (
              <a href={item.href} class="recovery-card">
                <div class="card-top">
                  <span>{item.number}</span>
                  <span>↗</span>
                </div>

                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <div class="error-footer">
        <span>KRIYANO</span>
        <span>Practical AI for Real Work.</span>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .error-page {
    min-height: calc(100vh - 80px);

    background:
      radial-gradient(
        circle at 50% 18%,
        rgba(183, 255, 74, 0.07),
        transparent 28%
      ),
      radial-gradient(
        circle at 85% 70%,
        rgba(77, 226, 197, 0.05),
        transparent 25%
      );
  }

  .error-container {
    padding-top: 90px;
    padding-bottom: 70px;
  }

  .error-hero {
    position: relative;

    max-width: 850px;

    padding-top: 42px;
  }

  .error-code {
    position: absolute;
    top: -58px;
    left: -10px;

    z-index: 0;

    color: rgba(183, 255, 74, 0.045);

    font-size: clamp(9rem, 25vw, 19rem);
    font-weight: 900;
    line-height: 1;

    letter-spacing: -0.09em;

    user-select: none;
    pointer-events: none;
  }

  .error-hero > *:not(.error-code) {
    position: relative;
    z-index: 1;
  }

  .error-hero h1 {
    margin-top: 14px;

    font-size: clamp(3.3rem, 7vw, 6.6rem);
    line-height: 0.94;

    letter-spacing: -0.065em;
  }

  .error-hero h1 span {
    display: block;

    color: var(--lime);
  }

  .error-hero > p {
    max-width: 650px;

    margin-top: 24px;

    color: var(--muted);

    font-size: 1rem;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 22px;

    margin-top: 32px;
  }

  .secondary-link {
    color: var(--lime);

    font-size: 0.82rem;
    font-weight: 750;
  }

  .recovery-section {
    margin-top: 110px;
    padding-top: 55px;

    border-top: 1px solid var(--line);
  }

  .recovery-head {
    display: grid;
    grid-template-columns: 1fr 0.75fr;

    gap: 60px;

    align-items: end;
  }

  .recovery-head h2 {
    margin-top: 11px;

    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1;

    letter-spacing: -0.05em;
  }

  .recovery-head > p {
    max-width: 460px;

    color: var(--muted);

    font-size: 0.85rem;
    line-height: 1.7;
  }

  .recovery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 12px;

    margin-top: 35px;
  }

  .recovery-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    min-height: 205px;

    padding: 20px;

    border: 1px solid var(--line);
    border-radius: 15px;

    background: var(--surface);

    color: var(--text);

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .recovery-card:hover {
    transform: translateY(-3px);

    border-color: rgba(183, 255, 74, 0.3);

    background:
      linear-gradient(
        145deg,
        rgba(183, 255, 74, 0.035),
        transparent 60%
      ),
      var(--surface);
  }

  .card-top {
    display: flex;
    justify-content: space-between;

    color: var(--lime);

    font-size: 0.64rem;
    font-weight: 800;
  }

  .recovery-card h3 {
    font-size: 1rem;

    letter-spacing: -0.025em;
  }

  .recovery-card p {
    margin-top: 7px;

    color: var(--muted);

    font-size: 0.73rem;
    line-height: 1.55;
  }

  .error-footer {
    display: flex;
    justify-content: space-between;

    gap: 20px;

    margin-top: 60px;
    padding-top: 18px;

    border-top: 1px solid var(--line);

    color: var(--muted);

    font-size: 0.62rem;
    font-weight: 700;

    letter-spacing: 0.05em;
  }

  .error-footer span:first-child {
    color: var(--lime);
  }

  @media (max-width: 950px) {
    .recovery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .error-container {
      padding-top: 65px;
    }

    .error-hero {
      padding-top: 30px;
    }

    .error-code {
      top: -25px;
    }

    .recovery-section {
      margin-top: 80px;
    }

    .recovery-head {
      grid-template-columns: 1fr;

      gap: 20px;
    }

    .recovery-grid {
      grid-template-columns: 1fr;
    }

    .recovery-card {
      min-height: 160px;
    }
  }
</style>