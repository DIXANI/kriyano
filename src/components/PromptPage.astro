---
interface StepItem {
  title: string;
  description: string;
}

interface ExampleItem {
  input: string[];
  output: string[];
}

interface TipItem {
  title: string;
  description: string;
}

interface Props {
  category: string;
  title: string;
  accentTitle?: string;
  description: string;

  meta?: string[];
  bestFor?: string[];

  masterPrompt: string;

  introTitle: string;
  introDescription: string;

  steps?: StepItem[];

  exampleTitle?: string;
  example?: ExampleItem;

  tipsTitle?: string;
  tips?: TipItem[];

  sidebarTitle?: string;
  sidebarDescription?: string;

  warningTitle?: string;
  warningText?: string;
}

const {
  category,
  title,
  accentTitle,
  description,

  meta = [],
  bestFor = [],

  masterPrompt,

  introTitle,
  introDescription,

  steps = [],

  exampleTitle = "See how it works.",
  example,

  tipsTitle = "Improve the result.",
  tips = [],

  sidebarTitle = "Build a custom prompt.",
  sidebarDescription = "Use the KRIYANO Prompt Builder to create a prompt around your exact task, context, audience and requirements.",

  warningTitle = "Quick tip",
  warningText = "Always review AI-generated content before using it for important work.",
} = Astro.props;
---

<section class="prompt-hero">
  <div class="container">
    <a href="/prompts/" class="back-link">← Prompt Library</a>

    <div class="hero-grid">
      <div>
        <div class="section-kicker">{category}</div>

        <h1>
          {title}
          {accentTitle && <span>{accentTitle}</span>}
        </h1>

        <p class="hero-copy">
          {description}
        </p>

        {
          meta.length > 0 && (
            <div class="prompt-meta">
              {meta.map((item) => <span>{item}</span>)}
            </div>
          )
        }
      </div>

      {
        bestFor.length > 0 && (
          <div class="use-card">
            <div class="use-card-label">Best for</div>

            <ul>
              {bestFor.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="container prompt-layout">
    <article class="main-content">
      <div class="content-intro">
        <div class="section-kicker">Ready-to-use prompt</div>

        <h2>{introTitle}</h2>

        <p>{introDescription}</p>
      </div>

      <div class="prompt-box">
        <div class="prompt-box-head">
          <div>
            <span class="prompt-label">KRIYANO MASTER PROMPT</span>
            <strong>{title} {accentTitle}</strong>
          </div>

          <button id="copyPrompt" class="copy-button" type="button">
            Copy Prompt
          </button>
        </div>

        <pre id="promptText">{masterPrompt}</pre>

        <div id="copyMessage" class="copy-message">
          Prompt copied to clipboard.
        </div>
      </div>

      {
        steps.length > 0 && (
          <section class="content-block">
            <div class="section-kicker">How to use it</div>

            <h2>Use the prompt effectively.</h2>

            <div class="steps">
              {
                steps.map((step, index) => (
                  <div class="step">
                    <span>{String(index + 1).padStart(2, "0")}</span>

                    <div>
                      <h3>{step.title}</h3>
                      <p>{step.description}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </section>
        )
      }

      {
        example && (
          <section class="content-block">
            <div class="section-kicker">Example</div>

            <h2>{exampleTitle}</h2>

            <div class="example-grid">
              <div class="example-card">
                <span class="example-label">Example input</span>

                {
                  example.input.map((item) => (
                    <p>{item}</p>
                  ))
                }
              </div>

              <div class="example-card output-example">
                <span class="example-label">Possible output</span>

                {
                  example.output.map((item) => (
                    <p>{item}</p>
                  ))
                }
              </div>
            </div>
          </section>
        )
      }

      {
        tips.length > 0 && (
          <section class="content-block">
            <div class="section-kicker">Improve the result</div>

            <h2>{tipsTitle}</h2>

            <div class="tips-grid">
              {
                tips.map((tip, index) => (
                  <article>
                    <span>{String(index + 1).padStart(2, "0")}</span>

                    <h3>{tip.title}</h3>

                    <p>{tip.description}</p>
                  </article>
                ))
              }
            </div>
          </section>
        )
      }
    </article>

    <aside class="sidebar">
      <div class="sidebar-card">
        <span class="sidebar-label">Need more control?</span>

        <h3>{sidebarTitle}</h3>

        <p>{sidebarDescription}</p>

        <a href="/tools/prompt-builder/" class="button button-primary">
          Open Prompt Builder
        </a>
      </div>

      <div class="sidebar-card mini-card">
        <span class="sidebar-label">{warningTitle}</span>

        <p>{warningText}</p>
      </div>
    </aside>
  </div>
</section>

<section class="next-section">
  <div class="container next-box">
    <div>
      <div class="section-kicker">Explore more</div>

      <h2>More practical prompts for real work.</h2>

      <p>
        Browse the KRIYANO Prompt Library for practical prompts covering work,
        business, research, operations and creative tasks.
      </p>
    </div>

    <a href="/prompts/" class="button button-secondary">
      Browse Prompt Library
    </a>
  </div>
</section>

<script>
  const copyButton = document.querySelector("#copyPrompt");
  const promptText = document.querySelector("#promptText");
  const copyMessage = document.querySelector("#copyMessage");

  copyButton?.addEventListener("click", async () => {
    const text = promptText?.textContent || "";

    try {
      await navigator.clipboard.writeText(text);

      copyButton.textContent = "Copied ✓";
      copyMessage?.classList.add("show");

      setTimeout(() => {
        copyButton.textContent = "Copy Prompt";
        copyMessage?.classList.remove("show");
      }, 2200);
    } catch {
      const range = document.createRange();
      const selection = window.getSelection();

      if (promptText && selection) {
        range.selectNodeContents(promptText);
        selection.removeAllRanges();
        selection.addRange(range);
      }
    }
  });
</script>

<style>
  .prompt-hero {
    padding: 70px 0 85px;
    border-bottom: 1px solid var(--line);

    background:
      radial-gradient(
        circle at 78% 20%,
        rgba(183, 255, 74, 0.08),
        transparent 26%
      );
  }

  .back-link {
    display: inline-block;
    margin-bottom: 55px;

    color: var(--muted);

    font-size: 0.78rem;
    font-weight: 700;

    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--lime);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;

    gap: 80px;

    align-items: end;
  }

  .prompt-hero h1 {
    max-width: 850px;
    margin-top: 14px;

    font-size: clamp(3.3rem, 7vw, 6.5rem);
    line-height: 0.93;
    letter-spacing: -0.06em;
  }

  .prompt-hero h1 span {
    display: block;
    color: var(--lime);
  }

  .hero-copy {
    max-width: 670px;
    margin-top: 25px;

    color: var(--muted);

    font-size: 1.06rem;
    line-height: 1.8;
  }

  .prompt-meta {
    display: flex;
    flex-wrap: wrap;

    gap: 9px;

    margin-top: 28px;
  }

  .prompt-meta span {
    padding: 7px 11px;

    border: 1px solid var(--line);
    border-radius: 999px;

    color: var(--muted);

    font-size: 0.68rem;
  }

  .use-card {
    padding: 27px;

    border: 1px solid rgba(183, 255, 74, 0.14);
    border-radius: 18px;

    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.035),
        transparent
      ),
      var(--surface);
  }

  .use-card-label,
  .prompt-label,
  .example-label,
  .sidebar-label {
    color: var(--lime);

    font-size: 0.67rem;
    font-weight: 800;

    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .use-card ul {
    display: grid;

    gap: 12px;

    margin: 19px 0 0;
    padding: 0;

    list-style: none;
  }

  .use-card li {
    position: relative;

    padding-left: 19px;

    color: var(--muted);

    font-size: 0.86rem;
  }

  .use-card li::before {
    content: "";

    position: absolute;

    left: 0;
    top: 9px;

    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: var(--mint);
  }

  .prompt-layout {
    display: grid;

    grid-template-columns: minmax(0, 1fr) 310px;

    gap: 60px;

    align-items: start;
  }

  .main-content {
    min-width: 0;
  }

  .content-intro {
    max-width: 760px;
    margin-bottom: 34px;
  }

  .content-intro h2,
  .content-block h2 {
    margin-top: 10px;

    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .content-intro p {
    max-width: 650px;
    margin-top: 14px;

    color: var(--muted);

    line-height: 1.7;
  }

  .prompt-box {
    overflow: hidden;

    border: 1px solid rgba(183, 255, 74, 0.17);
    border-radius: 20px;

    background: #08130f;

    box-shadow: 0 22px 55px rgba(0, 0, 0, 0.2);
  }

  .prompt-box-head {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 20px;

    padding: 18px 20px;

    border-bottom: 1px solid var(--line);

    background: rgba(255, 255, 255, 0.025);
  }

  .prompt-box-head strong {
    display: block;
    margin-top: 3px;

    font-size: 0.88rem;
  }

  .copy-button {
    flex-shrink: 0;

    padding: 9px 14px;

    border: 1px solid rgba(183, 255, 74, 0.25);
    border-radius: 9px;

    background: rgba(183, 255, 74, 0.08);

    color: var(--lime);

    cursor: pointer;

    font-size: 0.74rem;
    font-weight: 800;
  }

  .copy-button:hover {
    background: rgba(183, 255, 74, 0.14);
  }

  #promptText {
    margin: 0;
    padding: 28px;

    overflow-x: auto;

    white-space: pre-wrap;
    overflow-wrap: anywhere;

    color: #dce6e0;

    font-family:
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      monospace;

    font-size: 0.82rem;
    line-height: 1.8;
  }

  .copy-message {
    display: none;

    padding: 11px 20px;

    border-top: 1px solid var(--line);

    background: rgba(183, 255, 74, 0.06);

    color: var(--lime);

    font-size: 0.72rem;
  }

  .copy-message.show {
    display: block;
  }

  .content-block {
    padding-top: 80px;
  }

  .steps {
    margin-top: 35px;

    border-top: 1px solid var(--line);
  }

  .step {
    display: grid;

    grid-template-columns: 55px 1fr;

    gap: 20px;

    padding: 24px 0;

    border-bottom: 1px solid var(--line);
  }

  .step > span {
    color: var(--lime);

    font-size: 0.7rem;
    font-weight: 800;

    letter-spacing: 0.1em;
  }

  .step h3 {
    font-size: 1rem;
  }

  .step p {
    max-width: 680px;
    margin-top: 6px;

    color: var(--muted);

    font-size: 0.85rem;
  }

  .example-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 16px;

    margin-top: 32px;
  }

  .example-card {
    padding: 24px;

    border: 1px solid var(--line);
    border-radius: 16px;

    background: var(--surface);
  }

  .example-card p {
    margin-top: 14px;

    color: var(--muted);

    font-size: 0.84rem;
    line-height: 1.7;
  }

  .tips-grid {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 14px;

    margin-top: 32px;
  }

  .tips-grid article {
    min-height: 205px;

    padding: 22px;

    border: 1px solid var(--line);
    border-radius: 16px;

    background: var(--surface);
  }

  .tips-grid article > span {
    color: var(--lime);

    font-size: 0.68rem;
    font-weight: 800;
  }

  .tips-grid h3 {
    margin-top: 27px;

    font-size: 1rem;
  }

  .tips-grid p {
    margin-top: 8px;

    color: var(--muted);

    font-size: 0.8rem;
  }

  .sidebar {
    position: sticky;

    top: 100px;

    display: grid;

    gap: 14px;
  }

  .sidebar-card {
    padding: 24px;

    border: 1px solid rgba(183, 255, 74, 0.14);
    border-radius: 17px;

    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.025),
        transparent
      ),
      var(--surface);
  }

  .sidebar-card h3 {
    margin-top: 13px;

    font-size: 1.35rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .sidebar-card p {
    margin: 12px 0 20px;

    color: var(--muted);

    font-size: 0.82rem;
  }

  .sidebar-card .button {
    width: 100%;
    text-align: center;
  }

  .mini-card p {
    margin-bottom: 0;
  }

  .next-section {
    padding: 90px 0;

    border-top: 1px solid var(--line);

    background: var(--bg-soft);
  }

  .next-box {
    display: flex;

    align-items: end;
    justify-content: space-between;

    gap: 45px;
  }

  .next-box h2 {
    margin-top: 10px;

    font-size: clamp(2.3rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .next-box p {
    max-width: 650px;
    margin-top: 14px;

    color: var(--muted);
  }

  @media (max-width: 950px) {
    .hero-grid,
    .prompt-layout {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;

      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tips-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .prompt-hero {
      padding: 50px 0 65px;
    }

    .back-link {
      margin-bottom: 38px;
    }

    .hero-grid {
      gap: 40px;
    }

    .example-grid,
    .sidebar {
      grid-template-columns: 1fr;
    }

    .prompt-box-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .copy-button {
      width: 100%;
    }

    #promptText {
      padding: 21px 18px;
      font-size: 0.76rem;
    }

    .next-box {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>