---
const links = [
 {href:'/tools/',label:'All Tools'},
 {href:'/tools/#developer-tools',label:'Developer'},
 {href:'/tools/#data-tools',label:'Data & Text'},
 {href:'/tools/#web-tools',label:'Web Tools'}
];
const active = (href: string) => href === '/tools/' ? Astro.url.pathname.startsWith('/tools/') : false;
---
<header class="site-header">
 <div class="container nav">
  <a href="/" class="brand" aria-label="KRIYANO home"><span class="brand-mark" aria-hidden="true"></span>KRIYANO</a>
  <nav class="desktop-nav" aria-label="Main navigation"><ul class="nav-links">{links.map(link=><li><a href={link.href} aria-current={active(link.href)?'page':undefined}>{link.label}</a></li>)}</ul></nav>
  <a href="/tools/" class="nav-cta">Browse tools ↗</a>
  <button class="mobile-menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span><span></span></button>
 </div>
 <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation" hidden><div class="container">{links.map(link=><a href={link.href} aria-current={active(link.href)?'page':undefined}>{link.label}</a>)}<a href="/tools/" class="mobile-menu-cta">Browse all tools</a></div></nav>
</header>
<script>
const toggle=document.querySelector<HTMLButtonElement>('.mobile-menu-toggle')!;
const menu=document.querySelector<HTMLElement>('#mobile-menu')!;
function close(){menu.hidden=true;menu.classList.remove('is-open');toggle.classList.remove('is-open');toggle.setAttribute('aria-expanded','false');toggle.setAttribute('aria-label','Open navigation');}
toggle.addEventListener('click',()=>{const open=menu.hidden;menu.hidden=!open;menu.classList.toggle('is-open',open);toggle.classList.toggle('is-open',open);toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Close navigation':'Open navigation');});
menu.querySelectorAll('a').forEach(link=>link.addEventListener('click',close));
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&!menu.hidden){close();toggle.focus();}});
window.matchMedia('(min-width: 901px)').addEventListener('change',close);
</script>
