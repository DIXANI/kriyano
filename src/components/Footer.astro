<style>.footer-new{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:36px}.footer-tagline{margin:12px 0}.footer-new nav{display:flex;flex-direction:column;gap:10px;font-size:.85rem}.footer-new nav strong{margin-bottom:5px}.footer-new nav a{color:var(--muted)}.footer-new nav a:hover{color:var(--lime)}@media(max-width:760px){.footer-new{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}}@media(max-width:420px){.footer-new{grid-template-columns:1fr 1fr}.footer-new>div{grid-column:1/-1}}</style>
