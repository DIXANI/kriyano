---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Free Developer & Web Tools | KRIYANO",
  description = "Fast browser-based developer, web, data and text utilities. Encode, decode, validate, convert and clean technical data without unnecessary sign-ups.",
  image,
  noindex = false,
  schema,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const defaultImage = Astro.url.pathname.startsWith("/learn/")
  ? "/learn-default.png"
  : "/og-default.png";

const socialImagePath = image ?? defaultImage;
const socialImageUrl = new URL(socialImagePath, siteUrl).toString();

/*
 * Real intrinsic dimensions of the shipped social images (verified from the
 * PNG IHDR headers, not assumed). Used for Open Graph image previews so
 * crawlers can lay out the card before fetching the file.
 */
const socialImageMeta: Record<string, { width: number; height: number; type: string }> = {
  "/og-default.png": { width: 1200, height: 630, type: "image/png" },
  "/learn-default.png": { width: 1733, height: 907, type: "image/png" },
};
const socialImage = socialImageMeta[socialImagePath] ?? { width: 1200, height: 630, type: "image/png" };
const socialImageAlt = `${title} — KRIYANO`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
   

    <title>{title}</title>

    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />

    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow" />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KRIYANO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content={socialImage.type} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <meta name="theme-color" content="#07110d" />

    <meta name="generator" content={Astro.generator} />

    <!--
      Google Consent Mode v2 defaults.

      This must run before any Google tag so the denied defaults are in place
      first. The gtag.js library itself is NOT loaded here: ConsentBanner's
      script only injects it after the visitor accepts analytics, so no request
      is sent to Google and no analytics cookie is set before consent.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500
      });
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://kriyano.com/#organization",
            name: "KRIYANO",
            url: "https://kriyano.com/",
            logo: "https://kriyano.com/favicon.svg",
            description:
              "Fast browser-based developer, web, data and text utilities.",
          },
          {
            "@type": "WebSite",
            "@id": "https://kriyano.com/#website",
            url: "https://kriyano.com/",
            name: "KRIYANO",
            description:
              "Free developer, web, data and text utilities that run quickly in your browser.",
            publisher: {
              "@id": "https://kriyano.com/#organization",
            },
          },
        ],
      })}
    />

{
  schema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  )
}

  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <ConsentBanner />
  </body>
</html>