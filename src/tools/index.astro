---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
import '../../styles/toolkit.css';
---
<BaseLayout title="Free Work & Business Tools | KRIYANO" description="Find free tools to clean spreadsheet lists, calculate margins, build quotations, review AI output and write better prompts. No account required.">
 <div class="container kit-page"><header class="kit-heading"><div class="section-kicker">The KRIYANO toolkit</div><h1>What do you need to get done?</h1><p>Pick a tool, add your information and take a useful result back to your work. Every tool below is available now.</p></header>
 <div class="kit-filter-bar" id="tool-filters" hidden><div><label for="tool-search" class="kit-field-label">Find a tool</label><input id="tool-search" class="kit-search" type="search" placeholder="Try “Excel”, “pricing” or “AI”…" autocomplete="off"/></div><div class="kit-filters" role="group" aria-label="Filter tools by category">{['All','Office','Business','AI'].map(category=><button class="kit-btn" type="button" data-filter={category} aria-pressed={category==='All'}>{category}</button>)}</div></div>
 <p class="kit-help" id="tool-count" role="status" style="margin-bottom:20px">{tools.length} tools · Free to use · No sign-up</p><div class="kit-grid">{tools.map(tool=><ToolCard tool={tool}/>)}</div><div class="kit-empty" id="tool-empty" hidden><h2>No matching tools yet.</h2><p>Try a shorter search or choose another category.</p><button id="reset-filters" type="button" class="kit-btn" style="margin-top:16px">Show all tools</button></div>
 <section class="kit-guide"><div class="kit-guide-grid"><div><h3>Need a prompt?</h3><p>Browse task-specific templates for writing, operations and creative work.</p><a href="/prompts/">Open the Prompt Library →</a></div><div><h3>Know what leaves your browser.</h3><p>The new office and business tools work locally. CHECK’s AI review sends your text for processing.</p><a href="/privacy/">Read about privacy →</a></div><div><h3>Missing your everyday tool?</h3><p>Tell us the task you want to finish and what a useful result looks like.</p><a href="/contact/">Suggest a tool →</a></div></div></section></div>
</BaseLayout>
<script>
const search=document.querySelector<HTMLInputElement>('#tool-search')!;
const cards=[...document.querySelectorAll<HTMLElement>('[data-tool-card]')];
const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
let category='All'; document.querySelector<HTMLElement>('#tool-filters')!.hidden=false;
function filter(){const words=search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);let count=0;cards.forEach(card=>{const visible=(category==='All'||card.dataset.category===category)&&words.every(word=>card.dataset.search!.includes(word));card.hidden=!visible;if(visible)count++;});document.querySelector('#tool-count')!.textContent=`${count} ${count===1?'tool':'tools'} available`;document.querySelector<HTMLElement>('#tool-empty')!.hidden=count!==0;buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.filter===category)));}
search.addEventListener('input',filter);buttons.forEach(button=>button.addEventListener('click',()=>{category=button.dataset.filter!;filter();}));document.querySelector('#reset-filters')!.addEventListener('click',()=>{category='All';search.value='';filter();search.focus();});
</script>
